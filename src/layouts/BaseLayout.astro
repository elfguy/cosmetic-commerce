---
import '../styles/global.css';
const { title = 'Cosmetic Commerce', description = '화장품 마케팅과 쇼핑몰을 위한 브랜드 커머스 프로젝트' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="noise">
    <slot />
  </body>
</html>
