---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatWon, getVersions, products, statusLabel } from '../../data/marketingOps';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const versions = getVersions(product.slug, product.productId);
const appliedVersion = versions.find((version) => version.status === 'live') ?? versions[0];
const candidateVersion = [...versions].reverse().find((version) => version.status === 'candidate');
const latestReviewVersion = candidateVersion ?? [...versions].reverse().find((version) => version.id !== appliedVersion.id) ?? appliedVersion;
const defaultCompareIds = Array.from(new Set([appliedVersion.id, latestReviewVersion.id, versions.at(-2)?.id].filter(Boolean))).slice(0, 3);
const appliedDetailCount = appliedVersion?.detailImages.length ?? 0;
const appliedMainCount = appliedVersion?.mainImages.length ?? 0;
const versionCompareHref = product.ops.workspaceUrl ?? '/product-comparison/';
const versionCompareLabel = product.ops.workspaceUrl ? '버전 비교' : '전체 상품 비교';
---

<BaseLayout title={product.shortName + ' 상세 이미지 검수'} description={product.shortName + ' 버전별 대표 이미지와 상세 이미지를 검수하고 비교합니다.'}>
  <SiteHeader active="/products/" />

  <main class="asset-review" data-slug={product.slug}>
    <section class="review-hero container">
      <div class="hero-copy">
        <p class="eyebrow">{product.ops.campaignRole}</p>
        <h1>{product.shortName}</h1>
        <p>{product.name}</p>
      </div>

      <dl class="hero-metrics" aria-label="상품 상태 요약">
        <div>
          <dt>현재 적용</dt>
          <dd>{appliedVersion.label}</dd>
        </div>
        <div>
          <dt>검토 후보</dt>
          <dd>{candidateVersion?.label ?? '없음'}</dd>
        </div>
        <div>
          <dt>적용 이미지</dt>
          <dd>{appliedMainCount} + {appliedDetailCount}</dd>
        </div>
        <div>
          <dt>판매가</dt>
          <dd>{formatWon(product.price.sale)}</dd>
        </div>
      </dl>

      <div class="hero-links" aria-label="외부 링크">
        <a href={product.commerce.coupangUrl} target="_blank" rel="noreferrer">쿠팡 상품</a>
        {product.commerce.naverUrl ? <a href={product.commerce.naverUrl} target="_blank" rel="noreferrer">네이버 상품</a> : null}
        <a class="comparison-link" href={versionCompareHref}>{versionCompareLabel}</a>
        {product.ops.workspaceUrl && product.ops.workspaceUrl !== versionCompareHref ? (
          <a class="workspace-link" href={product.ops.workspaceUrl}>
            {product.slug === 'aqua-lotion'
              ? '작업하던 V4 비교 페이지'
              : product.slug === 'hyaluronic-toner'
                ? '토너 V1 비교 페이지'
                : product.slug === 'whitening-cream'
                  ? '화이트닝 V1 비교 페이지'
                  : '소재 작업실'}
          </a>
        ) : null}
      </div>
    </section>

    <section class="version-toolbar container" aria-label="버전 선택">
      <div class="version-tabs" data-version-tabs>
        {versions.map((version) => (
          <button
            type="button"
            class:list={['version-tab', version.id === appliedVersion.id && 'is-applied', version.id === appliedVersion.id && 'is-viewing']}
            data-version-tab={version.id}
          >
            <span>{version.label}</span>
            {version.id === appliedVersion.id && <strong aria-label="현재 적용">✓</strong>}
          </button>
        ))}
      </div>
    </section>

    {versions.map((version) => (
      <section class:list={['version-panel', 'container', version.id === appliedVersion.id && 'is-viewing']} data-version-panel={version.id}>
        <div class="selected-version">
          <aside class="version-brief">
            <div class="brief-head">
              <span class:list={['status-pill', 'status-' + version.status]}>{statusLabel[version.status]}</span>
              <strong>{version.label}</strong>
            </div>
            <p>{version.summary}</p>
            <dl>
              <div><dt>대표</dt><dd>{version.mainImages.length}장</dd></div>
              <div><dt>상세</dt><dd>{version.detailImages.length}장</dd></div>
              <div><dt>날짜</dt><dd>{version.date}</dd></div>
            </dl>
            {version.links && version.links.length > 0 && (
              <div class="asset-links">
                {version.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ))}
              </div>
            )}
          </aside>

          {version.mainImages.length > 0 && (
            <section class="main-images" aria-label={`${version.label} 대표 이미지`}>
              <div class="section-head">
                <p class="eyebrow">Main</p>
                <h2>대표 이미지</h2>
              </div>
              <div class="main-strip">
                {version.mainImages.map((src, index) => (
                  <a href={src} target="_blank" rel="noreferrer" class:list={['main-tile', index === 0 && 'is-primary']}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <img src={src} alt={`${version.label} 대표 이미지 ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="detail-images" aria-label={`${version.label} 상세 이미지`}>
            <div class="section-head">
              <p class="eyebrow">Detail</p>
              <h2>상세 이미지</h2>
            </div>
            <div class="detail-stack">
              {version.detailImages.length > 0 ? version.detailImages.map((src, index) => (
                <a href={src} target="_blank" rel="noreferrer">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <img src={src} alt={`${version.label} 상세 이미지 ${index + 1}`} loading="lazy" />
                </a>
              )) : <p class="empty-state">상세 이미지 없음</p>}
            </div>
          </section>
        </div>
      </section>
    ))}

    {versions.length > 1 && (
      <section id="version-compare" class="desktop-compare container" data-compare-root aria-label="PC 버전 비교">
        <div class="compare-title">
          <div>
            <p class="eyebrow">Compare</p>
            <h2>버전별 비교</h2>
          </div>
          <label class="sync-toggle">
            <input type="checkbox" data-sync-scroll checked />
            <span>상세 스크롤 동기화</span>
          </label>
        </div>

        <div class="compare-controls" aria-label="비교 버전 선택">
          {versions.map((version) => (
            <label class:list={['compare-check', defaultCompareIds.includes(version.id) && 'is-selected']}>
              <input type="checkbox" value={version.id} checked={defaultCompareIds.includes(version.id)} />
              <span>{version.label}</span>
              {version.id === appliedVersion.id && <strong>적용</strong>}
            </label>
          ))}
        </div>
        <p class="compare-note" data-compare-note>최대 3개 버전까지 나란히 비교합니다.</p>

        <div class="compare-grid" data-compare-grid style={`--visible-count: ${Math.max(defaultCompareIds.length, 1)};`}>
          {versions.map((version) => (
            <article class:list={['compare-column', !defaultCompareIds.includes(version.id) && 'is-hidden']} data-compare-column={version.id}>
              <header>
                <div>
                  <span class:list={['status-pill', 'status-' + version.status]}>{version.id === appliedVersion.id ? '현재 적용' : statusLabel[version.status]}</span>
                  <h3>{version.label}</h3>
                </div>
                <p>대표 {version.mainImages.length} · 상세 {version.detailImages.length}</p>
              </header>

              <div class="compare-main">
                {version.mainImages.slice(0, 3).map((src, index) => (
                  <a href={src} target="_blank" rel="noreferrer">
                    <img src={src} alt={`${version.label} 대표 비교 ${index + 1}`} loading="lazy" />
                  </a>
                ))}
              </div>

              <div class="compare-detail" data-compare-scroll>
                {version.detailImages.map((src, index) => (
                  <a href={src} target="_blank" rel="noreferrer">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <img src={src} alt={`${version.label} 상세 비교 ${index + 1}`} loading="lazy" />
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('[data-version-tab]');
  const panels = document.querySelectorAll('[data-version-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-version-tab');
      tabs.forEach((item) => item.classList.toggle('is-viewing', item === tab));
      panels.forEach((panel) => {
        panel.classList.toggle('is-viewing', panel.getAttribute('data-version-panel') === id);
      });
    });
  });

  document.querySelectorAll('[data-compare-root]').forEach((root) => {
    const checkboxes = Array.from(root.querySelectorAll('.compare-check input'));
    const labels = Array.from(root.querySelectorAll('.compare-check'));
    const columns = Array.from(root.querySelectorAll('[data-compare-column]'));
    const grid = root.querySelector('[data-compare-grid]');
    const note = root.querySelector('[data-compare-note]');
    const syncToggle = root.querySelector('[data-sync-scroll]');
    const scrollers = Array.from(root.querySelectorAll('[data-compare-scroll]'));
    let syncing = false;

    function selectedIds() {
      return checkboxes.filter((input) => input.checked).map((input) => input.value);
    }

    function refreshCompare() {
      const selected = selectedIds();
      labels.forEach((label) => {
        const input = label.querySelector('input');
        label.classList.toggle('is-selected', Boolean(input?.checked));
      });
      columns.forEach((column) => {
        column.classList.toggle('is-hidden', !selected.includes(column.getAttribute('data-compare-column')));
      });
      grid?.style.setProperty('--visible-count', String(Math.max(selected.length, 1)));
      if (note) note.textContent = selected.length + '개 버전을 비교 중입니다. 최대 3개까지 선택할 수 있습니다.';
    }

    checkboxes.forEach((input) => {
      input.addEventListener('change', () => {
        const selected = selectedIds();
        if (selected.length > 3) {
          input.checked = false;
        }
        if (selectedIds().length === 0) {
          input.checked = true;
        }
        refreshCompare();
      });
    });

    scrollers.forEach((scroller) => {
      scroller.addEventListener('scroll', () => {
        if (!syncToggle?.checked || syncing || scroller.closest('.compare-column')?.classList.contains('is-hidden')) return;
        const max = scroller.scrollHeight - scroller.clientHeight;
        const ratio = max > 0 ? scroller.scrollTop / max : 0;
        syncing = true;
        scrollers.forEach((target) => {
          if (target === scroller || target.closest('.compare-column')?.classList.contains('is-hidden')) return;
          const targetMax = target.scrollHeight - target.clientHeight;
          target.scrollTop = targetMax * ratio;
        });
        window.requestAnimationFrame(() => {
          syncing = false;
        });
      }, { passive: true });
    });

    refreshCompare();
  });
</script>

<style is:global>
  :global(body) {
    background: var(--bg);
  }

  .asset-review {
    --review-blue: #35647a;
    --review-mint: #dfe9e2;
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .asset-review a {
    color: inherit;
    text-decoration: none;
  }

  .asset-review .eyebrow {
    letter-spacing: 0;
  }

  .review-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: end;
    padding-block: 28px 14px;
  }

  .hero-copy h1 {
    margin: 7px 0 7px;
    font-size: 46px;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .hero-copy p:last-child {
    margin: 0;
    max-width: 660px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(96px, 1fr));
    grid-column: 1 / -1;
    gap: 8px;
    margin: 2px 0 0;
  }

  .hero-metrics div {
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 88%, var(--bg));
  }

  .hero-metrics dt {
    color: var(--muted);
    font-size: 12px;
  }

  .hero-metrics dd {
    margin: 4px 0 0;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.2;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }

  .hero-links a,
  .asset-links a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 8px 13px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
  }

  .hero-links a:first-child,
  .asset-links a:first-child {
    background: var(--forest);
    color: #f7f3e9;
    border-color: var(--forest);
  }

  .version-toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding-block: 6px 12px;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(14px);
  }

  .version-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 88%, var(--bg));
    box-shadow: var(--shadow-sm);
  }

  .version-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 76px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }

  .version-tab.is-viewing {
    border-color: var(--forest);
    background: var(--forest);
    color: #f7f3e9;
  }

  .version-tab strong {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .18);
    color: inherit;
    font-size: 12px;
    line-height: 1;
  }

  .version-panel {
    display: none;
    padding-block: 0 22px;
  }

  .version-panel.is-viewing {
    display: block;
  }

  .selected-version {
    display: grid;
    grid-template-columns: 280px minmax(0, .92fr) minmax(320px, 1.08fr);
    gap: 14px;
    align-items: start;
  }

  .version-brief,
  .main-images,
  .detail-images,
  .desktop-compare {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .version-brief {
    display: grid;
    gap: 14px;
    padding: 16px;
  }

  .brief-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .brief-head strong {
    font-size: 24px;
    line-height: 1.1;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
  }

  .status-live {
    background: var(--review-mint);
    color: #28543b;
  }

  .status-candidate {
    background: #f8e2ce;
    color: #8c4830;
  }

  .status-review {
    background: #d9e8ef;
    color: var(--review-blue);
  }

  .status-draft,
  .status-archive {
    background: var(--surface-3);
    color: var(--muted);
  }

  .version-brief p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .version-brief dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
  }

  .version-brief dl div {
    min-width: 0;
    padding: 10px;
    border-radius: 8px;
    background: var(--surface-3);
  }

  .version-brief dt {
    color: var(--muted);
    font-size: 11px;
  }

  .version-brief dd {
    margin: 3px 0 0;
    font-size: 14px;
    font-weight: 900;
    overflow-wrap: anywhere;
  }

  .asset-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .main-images,
  .detail-images {
    overflow: hidden;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }

  .section-head h2 {
    margin: 3px 0 0;
    font-size: 18px;
    line-height: 1.15;
  }

  .main-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 10px;
    max-height: 710px;
    overflow: auto;
  }

  .main-tile {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 168px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f8f8f4;
    overflow: hidden;
  }

  .main-tile.is-primary {
    grid-column: 1 / -1;
    min-height: 320px;
  }

  .main-tile span,
  .detail-stack span,
  .compare-detail span {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 24px;
    padding-inline: 7px;
    border-radius: 999px;
    background: rgba(31, 42, 36, .82);
    color: #fff;
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    z-index: 1;
  }

  .main-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .detail-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    max-height: 710px;
    overflow: auto;
    background: #f5f5f0;
  }

  .detail-stack a,
  .compare-detail a {
    position: relative;
    display: block;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .detail-stack img,
  .compare-detail img {
    display: block;
    width: 100%;
  }

  .empty-state {
    margin: 0;
    padding: 28px;
    color: var(--muted);
    font-size: 14px;
  }

  .desktop-compare {
    display: block;
    padding: 16px;
    margin-block: 8px 34px;
  }

  .compare-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }

  .compare-title h2 {
    margin: 4px 0 0;
    font-size: 24px;
    line-height: 1.1;
  }

  .sync-toggle,
  .compare-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    color: var(--muted);
    cursor: pointer;
  }

  .sync-toggle input,
  .compare-check input {
    accent-color: var(--forest);
  }

  .compare-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 8px;
  }

  .compare-check {
    min-height: 38px;
    padding: 8px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
  }

  .compare-check.is-selected {
    border-color: var(--forest);
    background: var(--review-mint);
    color: var(--forest);
  }

  .compare-check strong {
    padding: 2px 6px;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    font-size: 11px;
  }

  .compare-note {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 13px;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: repeat(var(--visible-count), minmax(0, 1fr));
    gap: 10px;
  }

  .compare-column {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .compare-column.is-hidden {
    display: none;
  }

  .compare-column header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 10px;
    padding: 12px;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .compare-column h3 {
    margin: 7px 0 0;
    font-size: 20px;
    line-height: 1.1;
  }

  .compare-column header p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .compare-main {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding: 8px;
    border-bottom: 1px solid var(--line);
  }

  .compare-main a {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .compare-main img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .compare-detail {
    display: flex;
    flex-direction: column;
