---
import { existsSync, readdirSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../../data/yourskin-products.json';

export function getStaticPaths() {
  return siteData.products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = siteData.products.filter((item) => item.slug !== product.slug).slice(0, 3);
const formatPrice = (price) => `${Number(price).toLocaleString('ko-KR')}원`;
const discountAmount = product.originalPrice ? product.originalPrice - product.price : 0;
const purchaseUrl = product.smartstoreUrl || product.coupangUrl;
const isAquaLotion = product.slug === 'aqua-lotion';
const freshness = product.freshness;
const benefitCards = product.proofPoints ?? product.benefits.map((benefit, index) => ({
  label: String(index + 1).padStart(2, '0'),
  title: benefit,
  body: '',
}));
const heroBadges = isAquaLotion
  ? ['제조일자 확인', '사용기한 확인', '히알루론산 보습 성분', '산뜻한 데일리 보습']
  : product.keywords;
const purchaseEvidence = freshness
  ? `${freshness.headline}. ${freshness.body}`
  : `${product.volume} 용량, ${formatPrice(product.price)} 가격대, ${product.discountRate} 할인 노출을 구매 버튼 주변에 배치합니다.`;
const pageClass = `detail-page${isAquaLotion ? ' is-aqua' : ''}`;
const heroImage = product.generatedHeroImage ?? product.image;
const visualStageClass = `visual-stage${product.generatedHeroImage ? ' uses-generated-image' : ''}`;
const requestedBrandLogoBase = '/assets/brand/yourskinplus/logo/v2026-05-25-r1';
const requestedBrandLogoDir = new URL('../../../public/assets/brand/yourskinplus/logo/v2026-05-25-r1/', import.meta.url);
const requestedBrandLogoFile = existsSync(requestedBrandLogoDir)
  ? readdirSync(requestedBrandLogoDir)
      .filter((file) => /\.(svg|png|webp|jpe?g)$/i.test(file))
      .sort((a, b) => {
        const order = (file) => ['.svg', '.png', '.webp', '.jpg', '.jpeg'].findIndex((ext) => file.toLowerCase().endsWith(ext));
        return order(a) - order(b) || a.localeCompare(b);
      })[0]
  : null;
const brandLogoSrc = requestedBrandLogoFile ? `${requestedBrandLogoBase}/${requestedBrandLogoFile}` : '/brand/yourskin-plus-logo-primary.svg';
const detailImageVersions = product.detailImageVersions ?? [];
const activeDetailVersion = detailImageVersions.find((version) => version.id === product.activeDetailVersionId) ?? detailImageVersions[0] ?? null;
const activeDetailImages = activeDetailVersion?.detailImages ?? product.salesImageSet ?? [];
const representativeImages = activeDetailVersion?.representativeImages ?? product.representativeImageSet ?? [{ title: product.name, src: heroImage }];
const compareDetailVersion = detailImageVersions.find((version) => version.status === 'original') ?? detailImageVersions.find((version) => version.id !== activeDetailVersion?.id) ?? activeDetailVersion;
const versionPayload = detailImageVersions.map((version) => ({
  id: version.id,
  label: version.label,
  createdAt: version.createdAt,
  status: version.status,
  source: version.source,
  representativeImages: version.representativeImages ?? [],
  detailImages: version.detailImages ?? [],
}));
---

<BaseLayout title={`${product.name} — 유어스킨플러스 상세페이지 시안`} description={product.heroLine}>
  <main class={pageClass}>
    <nav class="detail-nav">
      <a class="brand" href="/" aria-label="유어스킨플러스 홈">
        <img src={brandLogoSrc} alt="YOURSKIN+" />
      </a>
      <a href="/">← 전체 제품</a>
    </nav>

    {isAquaLotion && (
      <section class="aqua-version-hero">
        <div>
          <p class="eyebrow">Aqua lotion detail board</p>
          <h1>{product.name}</h1>
          <p class="hero-line">대표 이미지와 상세 이미지 버전만 간단히 확인하는 검토 화면입니다. 기본 비교는 현재 선택 버전과 원본 상세 이미지입니다.</p>
        </div>
        <dl class="version-summary">
          <div>
            <dt>현재 버전</dt>
            <dd>{activeDetailVersion?.label ?? '상세 이미지'}</dd>
          </div>
          <div>
            <dt>대표 이미지</dt>
            <dd>{representativeImages.length}장</dd>
          </div>
          <div>
            <dt>상세 이미지</dt>
            <dd>{activeDetailImages.length}장</dd>
          </div>
          <div>
            <dt>비교 가능 버전</dt>
            <dd>{detailImageVersions.length}개</dd>
          </div>
        </dl>
      </section>
    )}

    {isAquaLotion && (
      <section class="representative-section" aria-label="대표 이미지" data-representative-board>
        <div class="section-heading">
          <div>
            <p class="eyebrow">Representative images</p>
            <h2>대표 이미지</h2>
          </div>
          <label class="version-picker">
            버전
            <select data-representative-select>
              {detailImageVersions.map((version) => (
                <option value={version.id} selected={version.id === activeDetailVersion?.id}>{version.label}</option>
              ))}
            </select>
          </label>
        </div>
        <div class="representative-grid" data-representative-images>
          {representativeImages.map((image, index) => (
            <figure>
              <img src={image.src} alt={`${product.name} ${image.title}`} loading={index === 0 ? 'eager' : 'lazy'} />
              <figcaption>{image.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {!isAquaLotion && (
    <section class="detail-hero">
      <div class={visualStageClass}>
        <div class="water-grid"></div>
        {freshness && (
          <aside class="fresh-seal" aria-label="제조일자 확인 기준">
            <span>Date</span>
            <strong>제조일자</strong>
            <small>확인 출고 기준</small>
          </aside>
        )}
        <img src={heroImage} alt={product.fullName} />
        {isAquaLotion && <p class="stage-caption">Aqua moisture lotion / 300ml</p>}
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{product.category} / {product.volume}</p>
        {freshness && (
          <div class="fresh-banner">
            <span>{freshness.label}</span>
            <strong>제조일자를 확인할 수 있는 제품 출고 기준</strong>
          </div>
        )}
        <h1>{product.name}</h1>
        <p class="hero-line">{product.heroLine}</p>
        <p class="full-name">네이버 노출명: {product.fullName}</p>
        <div class="price-box">
          <div><span>판매가</span><strong>{formatPrice(product.price)}</strong></div>
          <div><span>할인</span><strong>{product.discountRate}</strong></div>
          <div><span>절약</span><strong>{discountAmount ? formatPrice(discountAmount) : '-'}</strong></div>
        </div>
        <div class="keyword-row">
          {heroBadges.map((keyword) => <span>{keyword}</span>)}
        </div>
        <div class="cta-row">
          <a class="buy" href={purchaseUrl} target="_blank" rel="noreferrer">판매 페이지 보기</a>
          <a class="ghost" href="#blueprint">상세 구성 보기</a>
        </div>
      </div>
    </section>
    )}

    {freshness && !isAquaLotion && (
      <section class="trust-strip" aria-label="제조일자 확인 근거">
        {freshness.checkpoints.map((checkpoint, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{checkpoint}</strong>
          </article>
        ))}
      </section>
    )}

    {!isAquaLotion && (
    <section id="blueprint" class="blueprint">
      <article class="problem-card">
        <p>Customer problem</p>
        <h2>{product.problem}</h2>
      </article>
      <div class="benefit-grid">
        {benefitCards.map((benefit, index) => (
          <article>
            <span>{benefit.label ?? String(index + 1).padStart(2, '0')}</span>
            <strong>{benefit.title}</strong>
            {benefit.body && <p>{benefit.body}</p>}
          </article>
        ))}
      </div>
    </section>
    )}

    {freshness && !isAquaLotion && (
      <section class="freshness-panel">
        <div>
          <p class="eyebrow">Date check standard</p>
          <h2>{freshness.headline}</h2>
          <p>{freshness.body}</p>
        </div>
        <ol class="freshness-steps">
          {freshness.checkpoints.map((checkpoint) => <li>{checkpoint}</li>)}
        </ol>
      </section>
    )}

    {!isAquaLotion && (
    <section class="routine-block">
      <div>
        <p class="eyebrow">How to use</p>
        <h2>상세페이지에 넣을 사용 루틴</h2>
      </div>
      <ol>
        {product.routine.map((step) => <li>{step}</li>)}
      </ol>
    </section>
    )}

    {!isAquaLotion && (
    <section class="copy-board">
      <p class="eyebrow">AI detail copy draft</p>
      <h2>{product.name} 상세페이지 카피 초안</h2>
      <div class="copy-grid">
        <article><span>첫 화면</span><p>{product.heroLine}</p></article>
        <article><span>문제 제기</span><p>{product.problem}</p></article>
        <article><span>구매 근거</span><p>{purchaseEvidence}</p></article>
      </div>
    </section>
    )}

    {!isAquaLotion && product.salesImageSet && (
      <section id="detail-images" class="sales-image-set">
        <div>
          <p class="eyebrow">Upload image set</p>
          <h2>판매 이미지 완성본</h2>
          <p>대표 이미지 후보부터 제조일자 확인 기준, 히알루론산 보습 컨셉, 사용 루틴, 기본 상품 정보까지 업로드 후보 컷으로 정리했습니다.</p>
        </div>
        <div class="sales-grid">
          {product.salesImageSet.map((cut) => (
            <figure>
              <img src={cut.src} alt={`${product.name} ${cut.title}`} loading="lazy" />
              <figcaption>{cut.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {isAquaLotion && activeDetailVersion && compareDetailVersion && (
      <section class="full-preview-section" data-full-preview>
        <div class="preview-head">
          <div>
            <p class="eyebrow">Full page preview</p>
            <h2>상세 이미지 전체 미리보기</h2>
            <p>선택한 버전의 상세 이미지를 실제 상세페이지처럼 한 줄로 이어서 확인합니다.</p>
          </div>
          <div class="preview-actions">
            <label class="version-picker">
              버전
              <select data-preview-select>
                {detailImageVersions.map((version) => (
                  <option value={version.id} selected={version.id === activeDetailVersion.id}>{version.label}</option>
                ))}
              </select>
            </label>
            <button type="button" data-preview-open>전체 화면으로 보기</button>
          </div>
        </div>
        <div class="full-preview-frame" data-preview-stack>
          {activeDetailImages.map((image) => (
            <img src={image.src} alt={`${activeDetailVersion.label} ${image.title}`} loading="lazy" />
          ))}
        </div>
      </section>
    )}

    {isAquaLotion && activeDetailVersion && compareDetailVersion && (
      <section
        id="detail-images"
        class="version-compare"
        data-version-compare
        data-versions={JSON.stringify(versionPayload)}
      >
        <div class="compare-head">
          <div>
            <p class="eyebrow">Detail image comparison</p>
            <h2>상세 이미지 비교</h2>
            <p>왼쪽과 오른쪽 버전을 바꿔 원본 또는 이전 버전과 바로 비교할 수 있습니다.</p>
          </div>
          <div class="compare-controls" aria-label="비교 버전 선택">
            <label>
              왼쪽
              <select data-version-select="left">
                {detailImageVersions.map((version) => (
                  <option value={version.id} selected={version.id === activeDetailVersion.id}>{version.label}</option>
                ))}
              </select>
            </label>
            <label>
              오른쪽
              <select data-version-select="right">
                {detailImageVersions.map((version) => (
                  <option value={version.id} selected={version.id === compareDetailVersion.id}>{version.label}</option>
                ))}
              </select>
            </label>
          </div>
        </div>
        <div class="compare-columns">
          <article class="compare-column" data-version-panel="left">
            <header>
              <span>비교 A</span>
              <h3 data-version-label>{activeDetailVersion.label}</h3>
              <p data-version-meta>{activeDetailVersion.createdAt} · {activeDetailImages.length}장</p>
            </header>
            <div class="compare-stack" data-version-images="left">
              {activeDetailImages.map((image) => (
                <figure>
                  <img src={image.src} alt={`${activeDetailVersion.label} ${image.title}`} loading="lazy" />
                  <figcaption>{image.title}</figcaption>
                </figure>
              ))}
            </div>
          </article>
          <article class="compare-column" data-version-panel="right">
            <header>
              <span>비교 B</span>
              <h3 data-version-label>{compareDetailVersion.label}</h3>
              <p data-version-meta>{compareDetailVersion.createdAt} · {(compareDetailVersion.detailImages ?? []).length}장</p>
            </header>
            <div class="compare-stack" data-version-images="right">
              {(compareDetailVersion.detailImages ?? []).map((image) => (
                <figure>
                  <img src={image.src} alt={`${compareDetailVersion.label} ${image.title}`} loading="lazy" />
                  <figcaption>{image.title}</figcaption>
                </figure>
              ))}
            </div>
          </article>
        </div>
      </section>
    )}

    {isAquaLotion && activeDetailVersion && (
      <div class="preview-modal" data-preview-modal hidden>
        <div class="preview-modal-bar">
          <strong data-preview-modal-title>{activeDetailVersion.label}</strong>
          <button type="button" data-preview-close>닫기</button>
        </div>
        <div class="preview-modal-body">
          <div class="preview-modal-stack" data-preview-modal-stack>
            {activeDetailImages.map((image) => (
              <img src={image.src} alt={`${activeDetailVersion.label} ${image.title}`} loading="lazy" />
            ))}
          </div>
        </div>
      </div>
    )}

    {product.detailCuts && (
      <section class="detail-cuts">
        <div>
          <p class="eyebrow">Renewal tone preview</p>
          <h2>청량한 상세 이미지 흐름</h2>
          <p>첫 화면, 제조일자 확인 근거, 히알루론산 보습 컷을 같은 블루·민트 톤으로 묶어 상품 상세 전체가 하나의 수분 루틴처럼 이어지게 합니다.</p>
        </div>
        <div class="cut-grid">
          {product.detailCuts.map((cut) => (
            <figure>
              <img src={cut.src} alt={`${product.name} ${cut.title}`} loading="lazy" />
              <figcaption>{cut.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {!isAquaLotion && (
    <section id="related" class="related">
      <h2>다른 유어스킨 라인</h2>
      <div>
        {related.map((item) => (
          <a href={`/products/${item.slug}/`}>
            <img src={item.image} alt={item.fullName} loading="lazy" />
            <strong>{item.name}</strong>
            <span>{formatPrice(item.price)}</span>
          </a>
        ))}
      </div>
    </section>
    )}
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-version-compare]');
    if (!root) return;

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));

    const versions = JSON.parse(root.dataset.versions || '[]');
    const versionMap = new Map(versions.map((version) => [version.id, version]));
    const representativeBoard = document.querySelector('[data-representative-board]');
    const previewBoard = document.querySelector('[data-full-preview]');
    const previewModal = document.querySelector('[data-preview-modal]');

    const versionBySelect = (selector) => {
      const select = document.querySelector(selector);
      return versionMap.get(select?.value) || versions[0];
    };

    const representativeImagesFor = (version) => {
      const representatives = version?.representativeImages || [];
      if (representatives.length) return representatives;
      const fallback = version?.detailImages?.[0];
      return fallback ? [{ title: `${version.label} 첫 상세 이미지`, src: fallback.src }] : [];
    };

    const detailImagesFor = (version) => version?.detailImages || [];

    const renderSide = (side) => {
      const select = root.querySelector(`[data-version-select="${side}"]`);
      const panel = root.querySelector(`[data-version-panel="${side}"]`);
      const stack = root.querySelector(`[data-version-images="${side}"]`);
      const version = versionMap.get(select?.value);
      if (!select || !panel || !stack || !version) return;

      const images = version.detailImages || [];
      panel.querySelector('[data-version-label]').textContent = version.label || '';
      panel.querySelector('[data-version-meta]').textContent = `${version.createdAt || ''} · ${images.length}장`;
      stack.innerHTML = images.map((image) => `
        <figure>
          <img src="${escapeHtml(image.src)}" alt="${escapeHtml(`${version.label || ''} ${image.title || ''}`)}" loading="lazy" />
          <figcaption>${escapeHtml(image.title || '')}</figcaption>
        </figure>
      `).join('');
    };

    const renderRepresentative = () => {
      if (!representativeBoard) return;

      const version = versionBySelect('[data-representative-select]');
      const stack = representativeBoard.querySelector('[data-representative-images]');
      if (!version || !stack) return;

      const images = representativeImagesFor(version);
      stack.innerHTML = images.length
        ? images.map((image, index) => `
          <figure>
            <img src="${escapeHtml(image.src)}" alt="${escapeHtml(`${version.label || ''} ${image.title || ''}`)}" loading="${index === 0 ? 'eager' : 'lazy'}" />
            <figcaption>${escapeHtml(image.title || '')}</figcaption>
          </figure>
        `).join('')
        : '<p class="empty-state">이 버전에는 대표 이미지가 등록되어 있지 않습니다.</p>';
    };

    const previewImageMarkup = (version) => detailImagesFor(version).map((image) => (
      `<img src="${escapeHtml(image.src)}" alt="${escapeHtml(`${version.label || ''} ${image.title || ''}`)}" loading="lazy" />`
    )).join('');

    const renderPreview = () => {
      if (!previewBoard) return;

      const version = versionBySelect('[data-preview-select]');
      const stack = previewBoard.querySelector('[data-preview-stack]');
      if (!version || !stack) return;

      stack.innerHTML = previewImageMarkup(version);
      const modalTitle = previewModal?.querySelector('[data-preview-modal-title]');
      const modalStack = previewModal?.querySelector('[data-preview-modal-stack]');
      if (modalTitle) modalTitle.textContent = version.label || '';
      if (modalStack) modalStack.innerHTML = previewImageMarkup(version);
    };

    const openPreview = () => {
      renderPreview();
      if (!previewModal) return;

      previewModal.hidden = false;
      document.documentElement.classList.add('has-preview-modal');
    };

    const closePreview = () => {
      if (!previewModal) return;

      previewModal.hidden = true;
      document.documentElement.classList.remove('has-preview-modal');
    };

    root.querySelectorAll('[data-version-select]').forEach((select) => {
      select.addEventListener('change', () => renderSide(select.dataset.versionSelect));
    });
    document.querySelector('[data-representative-select]')?.addEventListener('change', renderRepresentative);
    document.querySelector('[data-preview-select]')?.addEventListener('change', renderPreview);
    document.querySelector('[data-preview-open]')?.addEventListener('click', openPreview);
    document.querySelector('[data-preview-close]')?.addEventListener('click', closePreview);
    previewModal?.addEventListener('click', (event) => {
      if (event.target === previewModal) closePreview();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePreview();
    });
  })();
</script>

<style>
  :global(body) { background: #fff7ee; }
  .detail-page {
    --ink:#193a34;
    --muted:#5c746f;
    --accent:#087da7;
    --accent-strong:#005f86;
    --leaf:#3f8268;
    --line:#c9e6e3;
    --paper:#f8fffd;
    --soft:#e9fbff;
    box-sizing:border-box;
    min-height:100vh;
    padding:26px clamp(20px, 5vw, 72px) 90px;
    color:var(--ink);
    overflow-x:hidden;
    background:
      linear-gradient(90deg, rgba(8, 125, 167, .055) 1px, transparent 1px),
      linear-gradient(180deg, rgba(8, 125, 167, .055) 1px, transparent 1px),
      linear-gradient(180deg, #ecfbff 0%, #f7fffc 52%, #ffffff 100%);
    background-size:72px 72px, 72px 72px, auto;
  }
  .detail-page *,
  .detail-page *::before,
  .detail-page *::after {
    box-sizing:border-box;
  }
  .detail-page:not(.is-aqua) {
    --ink:#201915;
    --muted:rgba(32,25,21,.64);
    --accent:#8c473a;
    --accent-strong:#6f3429;
    --leaf:#7b8b6f;
    --line:rgba(32,25,21,.13);
    --paper:#fffaf4;
    --soft:#fff2e8;
    background:#fff7ee;
  }
  .detail-nav {
    max-width:1180px;
    margin:0 auto 54px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .brand {
    display:inline-flex;
    align-items:center;
    width:min(210px, 48vw);
    min-height:44px;
    text-decoration:none;
  }
  .brand img {
    display:block;
    width:100%;
    max-height:48px;
    object-fit:contain;
    object-position:left center;
  }
  .detail-nav > a:last-child {
    color:var(--ink);
    font-weight:900;
    text-decoration:none;
  }
  .aqua-version-hero,
  .representative-section,
  .version-compare {
    max-width:1180px;
    margin:0 auto;
  }
  .aqua-version-hero {
    display:grid;
