---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../../data/yourskin-products.json';

export function getStaticPaths() {
  return siteData.products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = siteData.products.filter((item) => item.slug !== product.slug).slice(0, 3);
const formatPrice = (price) => `${Number(price).toLocaleString('ko-KR')}원`;
const discountAmount = product.originalPrice ? product.originalPrice - product.price : 0;
---

<BaseLayout title={`${product.name} — 유어스킨플러스 상세페이지 시안`} description={product.heroLine}>
  <main class="detail-page">
    <nav class="detail-nav">
      <a class="brand" href="/"><span>Your</span><strong>skin+</strong></a>
      <a href="/">← 전체 제품</a>
    </nav>

    <section class="detail-hero">
      <div class="visual-stage">
        <div class="product-orbit"></div>
        <img src={product.image} alt={product.fullName} />
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{product.category} / {product.volume}</p>
        <h1>{product.name}</h1>
        <p class="hero-line">{product.heroLine}</p>
        <p class="full-name">네이버 노출명: {product.fullName}</p>
        <div class="price-box">
          <div><span>판매가</span><strong>{formatPrice(product.price)}</strong></div>
          <div><span>할인</span><strong>{product.discountRate}</strong></div>
          <div><span>절약</span><strong>{discountAmount ? formatPrice(discountAmount) : '-'}</strong></div>
        </div>
        <div class="keyword-row">
          {product.keywords.map((keyword) => <span>{keyword}</span>)}
        </div>
        <div class="cta-row">
          <a class="buy" href={product.smartstoreUrl} target="_blank" rel="noreferrer">스마트스토어에서 보기</a>
          <a class="ghost" href="#blueprint">상세 구성 보기</a>
        </div>
      </div>
    </section>

    <section id="blueprint" class="blueprint">
      <article class="problem-card">
        <p>Customer problem</p>
        <h2>{product.problem}</h2>
      </article>
      <div class="benefit-grid">
        {product.benefits.map((benefit, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{benefit}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="routine-block">
      <div>
        <p class="eyebrow">How to use</p>
        <h2>상세페이지에 넣을 사용 루틴</h2>
      </div>
      <ol>
        {product.routine.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="copy-board">
      <p class="eyebrow">AI detail copy draft</p>
      <h2>{product.name} 상세페이지 카피 초안</h2>
      <div class="copy-grid">
        <article><span>첫 화면</span><p>{product.heroLine}</p></article>
        <article><span>문제 제기</span><p>{product.problem}</p></article>
        <article><span>구매 근거</span><p>{product.volume} 용량, {formatPrice(product.price)} 가격대, {product.discountRate} 할인 노출을 구매 버튼 주변에 배치합니다.</p></article>
      </div>
    </section>

    <section class="related">
      <h2>다른 유어스킨 라인</h2>
      <div>
        {related.map((item) => (
          <a href={`/products/${item.slug}/`}>
            <img src={item.image} alt={item.fullName} loading="lazy" />
            <strong>{item.name}</strong>
            <span>{formatPrice(item.price)}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #fff7ee; }
  .detail-page { --ink:#201915; --muted:rgba(32,25,21,.64); --rose:#8c473a; --line:rgba(32,25,21,.13); color:var(--ink); padding: 26px clamp(20px, 5vw, 72px) 90px; }
  .detail-nav { max-width: 1180px; margin: 0 auto 54px; display:flex; align-items:center; justify-content:space-between; }
  .brand { display:inline-flex; gap:2px; color:var(--ink); font-family:'Cormorant Garamond',serif; font-size:42px; font-weight:700; letter-spacing:-.06em; text-decoration:none; }
  .brand strong { color:var(--rose); }
  .detail-nav > a:last-child { color:var(--ink); font-weight:900; text-decoration:none; }
  .detail-hero { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:.9fr 1fr; gap: clamp(28px,6vw,82px); align-items:center; }
  .visual-stage { position:relative; display:grid; place-items:center; min-height:620px; border:1px solid rgba(255,255,255,.75); border-radius:56px; background:linear-gradient(145deg,#fff,#edd6ca); box-shadow:0 32px 90px rgba(65,39,28,.16); overflow:hidden; }
  .product-orbit { position:absolute; width:72%; aspect-ratio:1; border-radius:50%; border:1px solid rgba(140,71,58,.25); box-shadow:0 0 0 48px rgba(255,255,255,.34), 0 0 0 96px rgba(140,71,58,.05); }
  .visual-stage img { position:relative; width:min(78%,430px); border-radius:36px; filter:drop-shadow(0 30px 52px rgba(32,25,21,.25)); }
  .eyebrow { color:var(--rose); font-size:12px; font-weight:950; letter-spacing:.24em; text-transform:uppercase; }
  h1 { margin:16px 0 0; font-family:'Cormorant Garamond',serif; font-size:clamp(64px,9vw,118px); line-height:.82; letter-spacing:-.075em; }
  .hero-line { margin-top:28px; font-size:22px; line-height:1.75; font-weight:800; }
  .full-name { color:var(--muted); line-height:1.7; }
  .price-box { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; margin-top:28px; overflow:hidden; border:1px solid var(--line); border-radius:28px; background:var(--line); }
  .price-box div { background:rgba(255,255,255,.66); padding:18px; }
  .price-box span { display:block; color:var(--muted); font-size:12px; font-weight:900; }
  .price-box strong { display:block; margin-top:6px; font-size:24px; }
  .keyword-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
  .keyword-row span { border:1px solid var(--line); border-radius:999px; padding:8px 12px; color:var(--rose); font-size:13px; font-weight:900; background:rgba(255,255,255,.5); }
  .cta-row { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
  .buy,.ghost { border-radius:999px; padding:16px 22px; font-weight:950; text-decoration:none; }
  .buy { background:var(--ink); color:#fff7ee; box-shadow:0 18px 46px rgba(32,25,21,.22); }
  .ghost { border:1px solid var(--line); color:var(--ink); background:rgba(255,255,255,.5); }
  .blueprint,.routine-block,.copy-board,.related { max-width:1180px; margin:88px auto 0; }
  .blueprint { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .problem-card { border-radius:42px; background:var(--ink); color:#fff7ee; padding:38px; }
  .problem-card p { color:#dfb6a8; font-weight:950; letter-spacing:.18em; text-transform:uppercase; }
  .problem-card h2 { font-family:'Cormorant Garamond',serif; font-size:52px; line-height:1; letter-spacing:-.05em; }
  .benefit-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
  .benefit-grid article,.copy-grid article,.related a { border:1px solid var(--line); border-radius:32px; background:rgba(255,255,255,.58); padding:24px; }
  .benefit-grid span { color:var(--rose); font-family:'Cormorant Garamond',serif; font-size:34px; font-weight:700; }
  .benefit-grid strong { display:block; margin-top:22px; font-size:22px; }
  .routine-block { display:grid; grid-template-columns:.8fr 1.2fr; gap:34px; border-top:1px solid var(--line); padding-top:48px; }
  .routine-block h2,.copy-board h2,.related h2 { margin:10px 0 0; font-family:'Cormorant Garamond',serif; font-size:56px; line-height:.96; letter-spacing:-.055em; }
  ol { margin:0; padding:0; counter-reset: step; list-style:none; display:grid; gap:12px; }
  li { counter-increment: step; border-bottom:1px solid var(--line); padding:0 0 18px 48px; position:relative; color:var(--muted); font-size:18px; line-height:1.7; }
  li::before { content:counter(step); position:absolute; left:0; top:0; color:var(--rose); font-weight:950; }
  .copy-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:24px; }
  .copy-grid span { color:var(--rose); font-weight:950; }
  .copy-grid p { color:var(--muted); line-height:1.75; }
  .related > div { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:22px; }
  .related a { color:var(--ink); text-decoration:none; }
  .related img { width:100%; border-radius:24px; background:#fff; }
  .related strong { display:block; margin-top:14px; font-size:20px; }
  .related span { color:var(--muted); font-weight:900; }
  @media (max-width: 900px) { .detail-hero,.blueprint,.routine-block,.copy-grid,.related>div { grid-template-columns:1fr; } .visual-stage { min-height:430px; } .price-box { grid-template-columns:1fr; } .benefit-grid { grid-template-columns:1fr; } }
</style>
