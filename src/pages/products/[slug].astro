---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { formatWon, getVersions, statusLabel } from '../../data/marketingOps';
import { products } from '../../data/marketingOps';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const versions = getVersions(product.slug, product.productId);

const playbooks: Record<string, { score: number; headline: string; firstCuts: string[]; copy: string[]; avoid: string[]; brief: string }> = {
  'hyaluronic-toner': {
    score: 82,
    headline: '500ml 대용량 수분 토너를 첫 화면에서 바로 팔아야 합니다.',
    firstCuts: ['500ml 대용량 + 수분 토너 선언', '스킨팩/닦토/레이어링 사용 장면', '히알루론산/병풀/판테놀 성분 + 가격 효율'],
    copy: ['500ml 대용량으로 매일 부담 없이 쓰는 수분 토너', '화장솜에 듬뿍, 스킨팩부터 닦토까지', '8종 히알루론산 컨셉의 데일리 보습 루틴'],
    avoid: ['속건조 개선 단정', '진정 치료/피부 개선 표현', '저자극 단정'],
    brief: '780px 세로 5컷. 제품을 첫 컷 55% 이상.',
  },
  'aqua-lotion': {
    score: 78,
    headline: '토너와 묶이는 300ml 수분 로션, 이유를 더 선명하게.',
    firstCuts: ['토너 다음 단계의 300ml 수분 로션', '토너+로션 수분 루틴 세트', '산뜻함/무향/데일리 사용감'],
    copy: ['토너 다음, 산뜻하게 채우는 300ml 수분 로션', '대용량 보습 루틴을 부담 없이', '무향 데일리 로션으로 가족이 함께'],
    avoid: ['피부 장벽 개선 단정', '발효 원료 효능 단정', '저자극/무자극 단정'],
    brief: 'V8 후보 기준 첫 컷 판매 문구 + 세트 제안 보강.',
  },
  'cleansing-oil': {
    score: 73,
    headline: '블랙헤드는 세정 관리로, 유화 장면을 크게.',
    firstCuts: ['선크림/피지 잔여감 문제 제시', '오일 롤링과 유화 장면', '블랙헤드 신경 쓰이는 부위 세정 관리'],
    copy: ['선크림과 피지까지 부드럽게 녹이는 오일 세안', '물과 만나 산뜻하게 유화되는 클렌징 루틴'],
    avoid: ['블랙헤드 제거', '모공 축소', '여드름 개선'],
    brief: 'Before/After 과장 없이 유화 장면 중심 5컷.',
  },
  'whitening-cream': {
    score: 80,
    headline: '미백 기능성 근거를 첫 화면과 구매 버튼 근처에.',
    firstCuts: ['미백 기능성화장품 고시 범위 표시', '나이아신아마이드 근거', '200ml 대용량 + 낮 사용 시 선케어 안내'],
    copy: ['피부의 미백에 도움을 주는 기능성 톤 케어 크림', '나이아신아마이드 함유 데일리 미백 케어'],
    avoid: ['즉시 미백', '기미/잡티 제거', '글루타티온 미백 효능 단정'],
    brief: '기능성 고시 문구를 구매 근거 영역에 크게 배치.',
  },
};

const playbook = playbooks[product.slug] ?? {
  score: 62,
  headline: '현재 적용 상세와 고시정보를 확인 후 첫 화면부터 정리.',
  firstCuts: ['상품명/용량/핵심 용도 명확화', '고객 사용 상황 제시', '확인된 성분과 구매 근거 배치'],
  copy: ['매일 쓰기 쉬운 데일리 케어 제품', '확인된 성분과 사용법 중심으로 소개'],
  avoid: ['개선/치료/저자극 단정', '확인 전 기능성 표현'],
  brief: '고시정보 확인 후 5컷 구조로 제작.',
};
---

<BaseLayout title={product.shortName + ' 상품상세'} description={product.shortName + ' 버전별 상품상세 관리'}>
  <SiteHeader active="/products/" />

  <main class="detail" data-slug={product.slug}>
    <!-- Product header -->
    <section class="product-header container">
      <div>
        <p class="eyebrow">{product.ops.campaignRole}</p>
        <h1>{product.shortName}</h1>
        <p class="headline">{playbook.headline}</p>
      </div>
      <dl class="stats">
        <div><dt>판매가</dt><dd>{formatWon(product.price.sale)}</dd></div>
        <div><dt>리뷰</dt><dd>{product.rating.coupangReviews}개</dd></div>
        <div><dt>리스크</dt><dd class={'risk-' + product.ops.claimRisk}>{product.ops.claimRisk}</dd></div>
        <div><dt>점수</dt><dd>{playbook.score}</dd></div>
      </dl>
    </section>

    <!-- Version selector -->
    <section class="versions container" aria-label="버전 선택">
      <div class="version-tabs" data-version-tabs>
        {versions.map((v, i) => (
          <button
            type="button"
            class={'version-tab' + (i === 0 ? ' is-active' : '')}
            data-version-id={v.id}
          >
            <span class="tab-label">{v.label}</span>
            <span class={'tab-status status-' + v.status}>{statusLabel[v.status]}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Version content -->
    {versions.map((v, i) => (
      <section class={'version-content container' + (i === 0 ? ' is-active' : '')} data-version-content={v.id}>
        <!-- Preview: Main slider + Detail scroll -->
        <div class="preview-area">
          <div class="phone phone-main">
            <div class="phone-bar">
              <span>메인 이미지</span>
              <strong>{v.mainImages.length}장</strong>
            </div>
            {v.mainImages.length > 0 ? (
              <div class="phone-slider" data-slider>
                <div class="slider-track">
                  {v.mainImages.map((img, idx) => (
                    <div class="slider-slide"><img src={img} alt={product.shortName + ' 메인 ' + (idx + 1)} loading={idx === 0 ? 'eager' : 'lazy'} /></div>
                  ))}
                </div>
                <div class="slider-dots">
                  {v.mainImages.map((_, idx) => (
                    <span class={'dot' + (idx === 0 ? ' is-active' : '')} />
                  ))}
                </div>
                {v.mainImages.length > 1 && (<>
                  <button class="slider-btn slider-prev" type="button" aria-label="이전">‹</button>
                  <button class="slider-btn slider-next" type="button" aria-label="다음">›</button>
                </>)}
              </div>
            ) : <div class="no-image">없음</div>}
          </div>

          <div class="phone phone-detail">
            <div class="phone-bar">
              <span>상세 이미지</span>
              <strong>{v.detailImages.length}장</strong>
            </div>
            <div class="phone-scroll">
              {v.detailImages.length > 0 ? v.detailImages.map((img, idx) => (
                <img src={img} alt={product.shortName + ' 상세 ' + (idx + 1)} loading="lazy" />
              )) : <div class="no-image">없음</div>}
            </div>
          </div>

          <!-- Version info -->
          <div class="version-info">
            <div class="info-row">
              <span>상태</span>
              <strong class={'status-' + v.status}>{statusLabel[v.status]}</strong>
            </div>
            <div class="info-row">
              <span>날짜</span>
              <strong>{v.date}</strong>
            </div>
            <p class="info-desc">{v.summary}</p>
            {v.metrics && v.metrics.length > 0 && (
              <div class="metrics">
                {v.metrics.map((m) => (
                  <div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>
                ))}
              </div>
            )}
            {v.links && v.links.length > 0 && (
              <div class="version-links">
                {v.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noreferrer">{l.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    ))}

    <!-- Work section -->
    <section class="work container">
      <div class="panel next">
        <p class="eyebrow">Next action</p>
        <h2>{product.ops.nextAction}</h2>
        <p>{product.ops.salesNote ?? product.ops.detailStatus}</p>
      </div>

      <div class="panel-grid">
        <div class="panel">
          <h2>첫 3컷</h2>
          <ol>{playbook.firstCuts.map((c) => <li>{c}</li>)}</ol>
        </div>
        <div class="panel copy">
          <h2>사용 가능 카피</h2>
          <ul>{playbook.copy.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>

      <div class="panel-grid">
        <div class="panel">
          <h2>제작 지시</h2>
          <p>{playbook.brief}</p>
        </div>
        <div class="panel danger">
          <h2>금지 표현</h2>
          <ul>{playbook.avoid.map((a) => <li>{a}</li>)}</ul>
        </div>
      </div>

      <div class="links-row">
        <a href={product.commerce.coupangUrl} target="_blank" rel="noreferrer">쿠팡</a>
        {product.commerce.naverUrl ? <a href={product.commerce.naverUrl} target="_blank" rel="noreferrer">네이버</a> : null}
        {product.ops.workspaceUrl ? <a href={product.ops.workspaceUrl}>소재</a> : null}
      </div>
    </section>
  </main>

  <SiteFooter />

  <!-- Lightbox overlay -->
  <div id="lightbox" class="lightbox">
    <div class="lb-header">
      <div class="lb-tabs" data-lb-tabs>
        <button class="lb-tab is-active" data-lb-tab="main" type="button">메인 이미지</button>
        <button class="lb-tab" data-lb-tab="detail" type="button">상세 이미지</button>
      </div>
      <button class="lb-close" type="button" aria-label="닫기">✕</button>
    </div>
    <!-- Main: slider -->
    <div class="lb-main is-active" data-lb-content="main">
      <button class="lb-nav lb-prev" type="button" aria-label="이전">‹</button>
      <div class="lb-slide-wrap">
        <div class="lb-slide-track"></div>
      </div>
      <button class="lb-nav lb-next" type="button" aria-label="다음">›</button>
      <span class="lb-counter"></span>
    </div>
    <!-- Detail: scroll -->
    <div class="lb-detail" data-lb-content="detail">
      <div class="lb-detail-scroll"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('[data-version-id]');
  const contents = document.querySelectorAll('[data-version-content]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-version-id');
      tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
      contents.forEach((c) => c.classList.toggle('is-active', c.getAttribute('data-version-content') === id));
    });
  });

  // Slider logic
  document.querySelectorAll('[data-slider]').forEach((slider) => {
    const track = slider.querySelector('.slider-track') as HTMLElement;
    const dots = slider.querySelectorAll('.dot');
    const prevBtn = slider.querySelector('.slider-prev');
    const nextBtn = slider.querySelector('.slider-next');
    const slideCount = slider.querySelectorAll('.slider-slide').length;
    let current = 0;

    function goTo(index: number) {
      current = Math.max(0, Math.min(index, slideCount - 1));
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, di) => d.classList.toggle('is-active', di === current));
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    // Touch swipe
    let startX = 0;
    slider.addEventListener('touchstart', (e) => {
      startX = (e as TouchEvent).touches[0].clientX;
    }, { passive: true });
    slider.addEventListener('touchend', (e) => {
      const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
    }, { passive: true });
  });

  // Image lightbox
  const overlay = document.getElementById('lightbox');
  const lbClose = overlay?.querySelector('.lb-close');
  const lbTabBtns = overlay?.querySelectorAll('.lb-tab');
  const lbMain = overlay?.querySelector('[data-lb-content="main"]');
  const lbDetail = overlay?.querySelector('[data-lb-content="detail"]');
  const lbTrack = overlay?.querySelector('.lb-slide-track') as HTMLElement;
  const lbDetailScroll = overlay?.querySelector('.lb-detail-scroll');
  const lbPrev = overlay?.querySelector('.lb-prev');
  const lbNext = overlay?.querySelector('.lb-next');
  const lbCounter = overlay?.querySelector('.lb-counter');

  let mainImages: string[] = [];
  let detailImages: string[] = [];
  let slideIndex = 0;

  function openLightbox(mode: 'main' | 'detail', index?: number) {
    if (!overlay) return;
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    switchTab(mode);
    if (mode === 'main' && index !== undefined) {
      slideIndex = index;
      renderMainSlider();
    }
  }

  function closeLightbox() {
    overlay?.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function switchTab(tab: 'main' | 'detail') {
    lbTabBtns?.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-lb-tab') === tab));
    lbMain?.classList.toggle('is-active', tab === 'main');
    lbDetail?.classList.toggle('is-active', tab === 'detail');
    if (tab === 'main') renderMainSlider();
  }

  function renderMainSlider() {
    if (!lbTrack || !lbCounter) return;
    lbTrack.innerHTML = mainImages.map((src) => '<div><img src="' + src + '" alt="" /></div>').join('');
    lbTrack.style.transform = `translateX(-${slideIndex * 100}%)`;
    lbCounter.textContent = (slideIndex + 1) + ' / ' + mainImages.length;
  }

  function renderDetailScroll() {
    if (!lbDetailScroll) return;
    lbDetailScroll.innerHTML = detailImages.map((src) => '<img src="' + src + '" alt="" />').join('');
  }

  // Populate images from the active version
  function loadVersionImages() {
    const active = document.querySelector('.version-content.is-active');
    if (!active) return;
    mainImages = Array.from(active.querySelectorAll('.phone-main img')).map((i: HTMLImageElement) => i.src);
    detailImages = Array.from(active.querySelectorAll('.phone-detail img')).map((i: HTMLImageElement) => i.src);
    slideIndex = 0;
  }

  // Click phone images to open lightbox
  document.querySelectorAll('.phone-main').forEach((phone) => {
    phone.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest('img');
      if (!img) return;
      loadVersionImages();
      const idx = mainImages.indexOf(img.src);
      openLightbox('main', idx >= 0 ? idx : 0);
      renderDetailScroll();
    });
  });

  document.querySelectorAll('.phone-detail').forEach((phone) => {
    phone.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest('img');
      if (!img) return;
      loadVersionImages();
      openLightbox('detail');
      renderDetailScroll();
      // Scroll to clicked image
      setTimeout(() => {
        const imgs = lbDetailScroll?.querySelectorAll('img');
        const idx = detailImages.indexOf(img.src);
        if (imgs && idx >= 0) imgs[idx]?.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    });
  });

  // Tab switching
  lbTabBtns?.forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.getAttribute('data-lb-tab') as 'main' | 'detail'));
  });

  // Nav buttons
  lbPrev?.addEventListener('click', () => {
    if (slideIndex > 0) { slideIndex--; renderMainSlider(); }
  });
  lbNext?.addEventListener('click', () => {
    if (slideIndex < mainImages.length - 1) { slideIndex++; renderMainSlider(); }
  });

  // Swipe in lightbox main
  let lbStartX = 0;
  lbMain?.addEventListener('touchstart', (e) => { lbStartX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
  lbMain?.addEventListener('touchend', (e) => {
    const diff = lbStartX - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      if (diff > 0 && slideIndex < mainImages.length - 1) { slideIndex++; renderMainSlider(); }
      if (diff < 0 && slideIndex > 0) { slideIndex--; renderMainSlider(); }
    }
  }, { passive: true });

  lbClose?.addEventListener('click', closeLightbox);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!overlay?.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft' && slideIndex > 0) { slideIndex--; renderMainSlider(); }
    if (e.key === 'ArrowRight' && slideIndex < mainImages.length - 1) { slideIndex++; renderMainSlider(); }
  });
</script>

<style is:global>
  :global(body) { background: var(--bg); }
  .detail {
    --paper: var(--surface);
    --dark: var(--forest);
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--font-body);
  }
  a { color: inherit; text-decoration: none; }

  /* Product header */
  .product-header {
    display: grid; grid-template-columns: 1fr auto;
    gap: 18px; padding: 26px 0 18px;
  }
  .eyebrow {
    margin: 0; color: var(--accent);
    font-family: var(--font-latin); font-size: 11px;
    font-weight: 800; text-transform: uppercase;
  }
  h1 { margin: 8px 0 6px; font-size: clamp(32px, 5vw, 56px); line-height: 1; letter-spacing: 0; }
  .headline { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.6; max-width: 600px; }
  .stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    margin: 0; padding: 14px;
    border: 1px solid var(--line); border-radius: var(--r);
    background: var(--surface); box-shadow: var(--shadow-sm);
    align-self: start;
  }
  .stats div { padding: 10px; border-radius: var(--r-sm); background: var(--surface-3); }
  dt { color: var(--muted); font-size: 11px; }
  dd { margin: 3px 0 0; font-size: 18px; font-weight: 900; }
  .risk-high { color: #8e2d1c; }
  .risk-medium { color: var(--accent-ink); }
  .risk-low { color: #315b4c; }

  /* Version selector */
  .versions { padding: 0 0 8px; }
  .version-tabs {
    display: flex; gap: 6px; overflow-x: auto;
    padding: 4px; border: 1px solid var(--line); border-radius: var(--r-sm);
    background: var(--surface);
    -webkit-overflow-scrolling: touch;
  }
  .version-tab {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 16px; border-radius: var(--r-sm);
    border: 1px solid transparent; background: transparent;
    font-family: var(--font-body); font-size: 14px; font-weight: 700;
    color: var(--muted); cursor: pointer; white-space: nowrap;
    transition: all .15s;
  }
  .version-tab.is-active {
    background: var(--forest); color: #f7f3e9;
    border-color: var(--forest);
  }
  .version-tab.is-active .tab-status { background: rgba(255,255,255,.15); color: #f7f3e9; }
  .tab-status {
    padding: 2px 8px; border-radius: var(--r-pill);
    font-size: 11px; font-weight: 800;
    background: var(--surface-3); color: #4a6a5c;
  }
  .status-live { background: #d4edda; color: #1a6b3c; }
  .status-candidate { background: #fff3cd; color: #856404; }
  .status-review { background: #d1ecf1; color: #0c5460; }
  .status-draft { background: #e2e3e5; color: #383d41; }
  .status-archive { background: #f0f0f0; color: #999; }

  /* Version content */
  .version-content { display: none; padding: 0 0 20px; }
  .version-content.is-active { display: block; }

  .preview-area {
    display: grid; grid-template-columns: 200px 200px minmax(0, 1fr);
    gap: 18px; align-items: start;
  }

  /* Phone */
  .phone {
    border: 6px solid #1a1a1a; border-radius: 20px;
    overflow: hidden; background: #fff;
    box-shadow: 0 12px 36px rgba(21,34,28,.15);
  }
  .phone-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 14px; background: #1a1a1a; color: #eee;
    font-size: 12px; font-weight: 800;
  }
  .phone-bar strong { color: var(--accent); }
  .phone-scroll {
    max-height: 480px; overflow-y: auto; background: #f5f5f2;
    -webkit-overflow-scrolling: touch;
  }
  .phone-scroll img {
    display: block; width: 100%; min-height: 120px;
    object-fit: cover; border-bottom: 1px solid #eee;
    cursor: pointer; transition: opacity .15s;
  }
  .phone-scroll img:hover { opacity: .85; }

  /* Slider */
  .phone-slider {
    position: relative; overflow: hidden;
    background: #f5f5f2; height: 420px;
  }
  .slider-track {
    display: flex; height: 100%;
    transition: transform .3s ease;
  }
  .slider-slide {
    min-width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
