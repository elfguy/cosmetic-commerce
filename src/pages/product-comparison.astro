---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { formatWon, products } from '../data/marketingOps';

const functionalProducts = products.filter((product) => product.notice.functionalCosmetic !== '해당 없음');
const missingNaver = products.filter((product) => !product.commerce.naverUrl);
const highRisk = products.filter((product) => product.ops.claimRisk === 'high');
---

<BaseLayout title="상품 데이터와 표현 검수표" description="유어스킨플러스 상품별 가격, 채널, 기능성, 표현 리스크를 마케팅 작업 기준으로 확인">
  <SiteHeader active="" />

  <main class="data-tool">
    <section class="hero container">
      <div>
        <p class="eyebrow">Product data sheet</p>
        <h1>상품 데이터와 표현 리스크를 한 번에 확인</h1>
        <p class="lead">예전 비교표를 마케팅 작업용 검수표로 바꿨습니다. 가격, 채널, 기능성 여부, 금지 표현 리스크, 다음 작업을 빠르게 확인합니다.</p>
      </div>
      <div class="summary">
        <article><strong>{products.length}</strong><span>전체 상품</span></article>
        <article><strong>{functionalProducts.length}</strong><span>기능성</span></article>
        <article><strong>{highRisk.length}</strong><span>고위험 표현</span></article>
        <article><strong>{missingNaver.length}</strong><span>네이버 미확인</span></article>
      </div>
    </section>

    <section class="risk-strip container">
      <h2>먼저 확인할 것</h2>
      <div class="risk-grid">
        {highRisk.map((product) => (
          <a href={'/products/' + product.slug + '/'}>
            <strong>{product.shortName}</strong>
            <span>{product.ops.nextAction}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="table-wrap container" aria-label="상품 검수표">
      <table>
        <thead>
          <tr>
            <th>상품</th>
            <th>역할</th>
            <th>가격/리뷰</th>
            <th>기능성/리스크</th>
            <th>다음 작업</th>
            <th>링크</th>
          </tr>
        </thead>
        <tbody>
          {products.map((product) => (
            <tr>
              <td>
                <div class="product-cell">
                  <img src={product.assets.thumbnail} alt={product.shortName + ' 이미지'} loading="lazy" />
                  <div>
                    <strong>{product.shortName}</strong>
                    <span>{product.category}</span>
                  </div>
                </div>
              </td>
              <td>{product.ops.campaignRole}</td>
              <td>
                <strong>{formatWon(product.price.sale)}</strong>
                <span>{product.rating.coupangReviews}개 리뷰</span>
              </td>
              <td>
                <strong>{product.notice.functionalCosmetic}</strong>
                <span class={'risk risk-' + product.ops.claimRisk}>{product.ops.claimRisk}</span>
              </td>
              <td>{product.ops.nextAction}</td>
              <td class="links">
                <a href={'/products/' + product.slug + '/'}>작업실</a>
                <a href={product.commerce.coupangUrl} target="_blank" rel="noreferrer">쿠팡</a>
                {product.commerce.naverUrl ? <a href={product.commerce.naverUrl} target="_blank" rel="noreferrer">네이버</a> : <em>네이버 미확인</em>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  :global(body) { background: var(--bg); }
  .data-tool { color: var(--ink); padding-bottom: 8px; }
  .data-tool a { color: inherit; text-decoration: none; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 18px;
    align-items: end;
    padding-block: clamp(28px, 5vw, 56px) clamp(18px, 3vw, 28px);
  }
  .hero h1 { margin: 10px 0; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.06; letter-spacing: -0.02em; }
  .hero .lead { max-width: 64ch; margin: 0; color: var(--muted); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.65; }

  .summary { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .summary article {
    display: grid; align-content: space-between; gap: 8px; min-height: 110px; padding: 18px;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-sm);
  }
  .summary strong { color: var(--accent); font-size: clamp(26px, 3vw, 34px); line-height: 1; }
  .summary span { font-weight: 800; }

  .risk-strip {
    margin-top: 8px; padding: 22px;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-sm);
  }
  .risk-strip h2 { margin: 0 0 14px; font-size: clamp(20px, 2.4vw, 26px); letter-spacing: -0.01em; }
  .risk-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .risk-grid a {
    display: grid; gap: 6px; padding: 14px;
    border: 1px solid #ecccbe; border-radius: var(--r-sm); background: var(--accent-soft);
  }
  .risk-grid strong { color: var(--accent-ink); }
  .risk-grid span { color: var(--muted); line-height: 1.45; }

  .table-wrap {
    overflow-x: auto; margin-top: 18px; padding: 0;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-sm);
  }
  table { width: 100%; min-width: 980px; border-collapse: collapse; }
  th, td { padding: 14px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  th { position: sticky; top: 0; background: var(--surface-3); font-size: 13px; }
  td { color: var(--ink); line-height: 1.5; }
  td > span, .product-cell span { display: block; color: var(--muted); font-size: 13px; }
  .product-cell { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 10px; align-items: center; }
  .product-cell img { width: 58px; height: 58px; max-width: 100%; object-fit: cover; border-radius: var(--r-sm); background: var(--surface-3); }
  .risk { display: inline-block; margin-top: 6px; padding: 4px 8px; border-radius: var(--r-pill); background: var(--accent-soft); color: var(--accent-ink); font-size: 12px; font-weight: 800; }
  .risk-high { background: #f7ddd2; color: #8e2d1c; }
  .risk-low { background: #e6efdc; color: #3a5a3f; }
  .links { min-width: 160px; }
  .links a { display: inline-block; margin: 0 4px 6px 0; padding: 9px 12px; border-radius: var(--r-pill); background: var(--forest); color: #f7f3e9; font-size: 13px; font-weight: 800; }
  .links em { display: block; color: var(--muted); font-size: 12px; font-style: normal; }

  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; gap: 14px; }
    .risk-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .summary { grid-template-columns: 1fr 1fr; }
    th { top: 0; }
  }
</style>
