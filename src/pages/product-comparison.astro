---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatWon, products } from '../data/marketingOps';

const functionalProducts = products.filter((product) => product.notice.functionalCosmetic !== '해당 없음');
const missingNaver = products.filter((product) => !product.commerce.naverUrl);
const highRisk = products.filter((product) => product.ops.claimRisk === 'high');
---

<BaseLayout title="상품 데이터와 표현 검수표" description="유어스킨플러스 상품별 가격, 채널, 기능성, 표현 리스크를 마케팅 작업 기준으로 확인">
  <main class="data-tool">
    <header class="topbar">
      <a href="/" class="brand"><img src="/yourskin-logo-header-v15.svg" alt="YOURSKIN+" /></a>
      <nav>
        <a href="/">대시보드</a>
        <a href="/products/">상품상세</a>
        <a href="/competitor-comparison/">경쟁상품</a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Product data sheet</p>
        <h1>상품 데이터와 표현 리스크를 한 번에 확인</h1>
        <p>예전 비교표를 마케팅 작업용 검수표로 바꿨습니다. 가격, 채널, 기능성 여부, 금지 표현 리스크, 다음 작업을 빠르게 확인합니다.</p>
      </div>
      <div class="summary">
        <article><strong>{products.length}</strong><span>전체 상품</span></article>
        <article><strong>{functionalProducts.length}</strong><span>기능성</span></article>
        <article><strong>{highRisk.length}</strong><span>고위험 표현</span></article>
        <article><strong>{missingNaver.length}</strong><span>네이버 미확인</span></article>
      </div>
    </section>

    <section class="risk-strip">
      <h2>먼저 확인할 것</h2>
      <div>
        {highRisk.map((product) => (
          <a href={'/products/' + product.slug + '/'}>
            <strong>{product.shortName}</strong>
            <span>{product.ops.nextAction}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="table-wrap" aria-label="상품 검수표">
      <table>
        <thead>
          <tr>
            <th>상품</th>
            <th>역할</th>
            <th>가격/리뷰</th>
            <th>기능성/리스크</th>
            <th>다음 작업</th>
            <th>링크</th>
          </tr>
        </thead>
        <tbody>
          {products.map((product) => (
            <tr>
              <td>
                <div class="product-cell">
                  <img src={product.assets.thumbnail} alt={product.shortName + ' 이미지'} loading="lazy" />
                  <div>
                    <strong>{product.shortName}</strong>
                    <span>{product.category}</span>
                  </div>
                </div>
              </td>
              <td>{product.ops.campaignRole}</td>
              <td>
                <strong>{formatWon(product.price.sale)}</strong>
                <span>{product.rating.coupangReviews}개 리뷰</span>
              </td>
              <td>
                <strong>{product.notice.functionalCosmetic}</strong>
                <span class={'risk risk-' + product.ops.claimRisk}>{product.ops.claimRisk}</span>
              </td>
              <td>{product.ops.nextAction}</td>
              <td class="links">
                <a href={'/products/' + product.slug + '/'}>작업실</a>
                <a href={product.commerce.coupangUrl} target="_blank" rel="noreferrer">쿠팡</a>
                {product.commerce.naverUrl ? <a href={product.commerce.naverUrl} target="_blank" rel="noreferrer">네이버</a> : <em>네이버 미확인</em>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #eef1ec; }
  .data-tool { --ink:#17211d; --muted:#68766f; --line:#d8e0d6; --paper:#fbfcf8; --dark:#12251f; --accent:#c76045; min-height:100vh; color:var(--ink); background:#eef1ec; font-family:var(--font-body); }
  a { color:inherit; text-decoration:none; }
  .topbar { position:sticky; top:0; z-index:10; display:flex; justify-content:space-between; align-items:center; gap:14px; padding:12px 22px; border-bottom:1px solid var(--line); background:rgba(238,241,236,.94); backdrop-filter:blur(12px); }
  .brand img { width:146px; padding:8px 10px; border-radius:6px; background:#f8f4ea; }
  nav { display:flex; flex-wrap:wrap; gap:8px; }
  nav a, .links a { padding:9px 12px; border-radius:999px; background:var(--dark); color:#fffaf0; font-size:13px; font-weight:800; }
  .hero { display:grid; grid-template-columns:minmax(0,1fr) 420px; gap:18px; padding:26px 22px 18px; }
  .eyebrow { margin:0; color:var(--accent); font-family:var(--font-latin); font-size:11px; font-weight:800; text-transform:uppercase; }
  .hero h1 { margin:8px 0 10px; font-size:clamp(38px,5vw,68px); line-height:1; letter-spacing:0; }
  .hero p:not(.eyebrow) { max-width:760px; margin:0; color:var(--muted); font-size:17px; line-height:1.65; }
  .summary { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .summary article, .risk-strip, .table-wrap { border:1px solid var(--line); border-radius:8px; background:var(--paper); box-shadow:0 14px 44px rgba(21,34,28,.08); }
  .summary article { display:grid; gap:8px; padding:16px; }
  .summary strong { color:var(--accent); font-size:32px; }
  .summary span { font-weight:800; }
  .risk-strip { margin:0 22px 18px; padding:20px; }
  .risk-strip h2 { margin:0 0 14px; font-size:24px; }
  .risk-strip div { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .risk-strip a { display:grid; gap:6px; padding:14px; border:1px solid #efc9bb; border-radius:8px; background:#fff7f3; }
  .risk-strip span { color:var(--muted); line-height:1.45; }
  .table-wrap { overflow:auto; margin:0 22px 24px; }
  table { width:100%; min-width:980px; border-collapse:collapse; }
  th, td { padding:14px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
  th { position:sticky; top:67px; background:#f6f8f3; font-size:13px; }
  td { color:#29342f; line-height:1.5; }
  td > span, .product-cell span { display:block; color:var(--muted); font-size:13px; }
  .product-cell { display:grid; grid-template-columns:58px minmax(0,1fr); gap:10px; align-items:center; }
  .product-cell img { width:58px; height:58px; object-fit:cover; border-radius:6px; background:#eef1ec; }
  .risk { display:inline-block; margin-top:6px; padding:4px 8px; border-radius:999px; background:#f6ece7; color:#9c4d36; font-size:12px; font-weight:800; }
  .risk-high { background:#f7dfd6; color:#8e2d1c; }
  .risk-low { background:#e8f1df; color:#315b4c; }
  .links { min-width:160px; }
  .links a { display:inline-block; margin:0 4px 6px 0; }
  .links em { display:block; color:var(--muted); font-size:12px; font-style:normal; }
  @media (max-width:900px) { .hero, .risk-strip div { grid-template-columns:1fr; } }
  @media (max-width:720px) { .topbar { align-items:flex-start; padding:10px 12px; } .brand img { width:118px; padding:6px 8px; } nav { flex-wrap:nowrap; overflow-x:auto; max-width:58vw; } nav a { flex:0 0 auto; padding:8px 10px; font-size:12px; } .hero { padding:18px 12px 12px; } .hero h1 { font-size:30px; line-height:1.08; } .hero p:not(.eyebrow) { font-size:15px; } .summary { grid-template-columns:1fr 1fr; } .risk-strip, .table-wrap { margin-left:12px; margin-right:12px; } th { top:56px; } }
</style>
