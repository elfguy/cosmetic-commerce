---
import { readdirSync, statSync } from 'node:fs';
import { join, relative } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import BackToHub from '../components/BackToHub.astro';

const root = join(process.cwd(), 'public', 'brand', 'generated-logo-study-2026-05-19');
const publicRoot = join(process.cwd(), 'public');

function walk(dir: string): string[] {
  return readdirSync(dir)
    .flatMap((name) => {
      const path = join(dir, name);
      return statSync(path).isDirectory() ? walk(path) : [path];
    })
    .filter((path) => path.endsWith('.png'))
    .sort();
}

const images = walk(root).map((path) => {
  const publicPath = '/' + relative(publicRoot, path).replaceAll('\\', '/');
  const parts = publicPath.split('/');
  const folder = parts.at(-2) ?? 'logos';
  const file = parts.at(-1) ?? '';
  return { src: publicPath, folder, file };
});

const folders = Array.from(new Set(images.map((image) => image.folder)));
---

<BaseLayout title="YOURSKIN Logo Gallery" description="YOURSKIN PLUS generated logo and app icon gallery">
  <BackToHub label="로고 갤러리" kind="브랜드" />
  <main class="gallery-page">
    <section class="gallery-hero">
      <nav class="gallery-nav" aria-label="페이지 이동">
        <a href="/brand-logo/">Brand Logo</a>
        <a href="/logo-inspiration/">Inspiration</a>
        <a href="/brand-typography/">Typography</a>
      </nav>
      <p>Generated logo study</p>
      <h1>YOURSKIN Logo Gallery</h1>
      <span>{images.length} generated images</span>
    </section>

    <section class="folder-nav" aria-label="폴더 바로가기">
      {folders.map((folder) => (
        <a href={'#' + folder}>{folder}</a>
      ))}
    </section>

    {folders.map((folder) => (
      <section class="gallery-section" id={folder}>
        <div class="section-heading">
          <p>{folder}</p>
          <strong>{images.filter((image) => image.folder === folder).length} images</strong>
        </div>
        <div class="image-grid">
          {images
            .filter((image) => image.folder === folder)
            .map((image) => (
              <article>
                <a href={image.src} target="_blank" rel="noreferrer">
                  <img src={image.src} alt={image.file} loading="lazy" />
                </a>
                <p>{image.file}</p>
              </article>
            ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
    background: #f8f1e7;
    color: #172018;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .gallery-page {
    min-height: 100vh;
    padding-bottom: 72px;
    background: #f8f1e7;
  }

  .gallery-hero,
  .folder-nav,
  .gallery-section {
    width: min(1280px, calc(100% - 36px));
    margin: 0 auto;
  }

  .gallery-hero {
    padding: 28px 0 34px;
  }

  .gallery-nav {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }

  .gallery-nav a,
  .folder-nav a {
    color: #435448;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .gallery-hero p,
  .section-heading p {
    margin: 0;
    color: #947e4e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 10px 0 8px;
    color: #143d2e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 500;
    line-height: 0.92;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .gallery-hero span {
    color: #536359;
    font-size: 16px;
  }

  .folder-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 18px 0 28px;
    border-top: 1px solid rgba(20, 61, 46, 0.16);
    border-bottom: 1px solid rgba(20, 61, 46, 0.16);
  }

  .folder-nav a {
    padding: 9px 11px;
    border: 1px solid rgba(20, 61, 46, 0.16);
    background: rgba(255, 252, 246, 0.7);
    text-transform: none;
    letter-spacing: 0;
  }

  .gallery-section {
    padding-top: 42px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
  }

  .section-heading strong {
    color: #526257;
    font-size: 13px;
    font-weight: 500;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  article {
    min-width: 0;
    border: 1px solid rgba(20, 61, 46, 0.14);
    background: #fffaf2;
  }

  article a {
    display: grid;
    place-items: center;
    aspect-ratio: 1.38;
    padding: 14px;
    background:
      linear-gradient(45deg, rgba(20, 61, 46, 0.035) 25%, transparent 25%),
      linear-gradient(-45deg, rgba(20, 61, 46, 0.035) 25%, transparent 25%),
      #fbf7ef;
    background-size: 18px 18px;
  }

  img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  article p {
    margin: 0;
    padding: 10px 12px 12px;
    color: #536058;
    font-size: 12px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .image-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .image-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 400px) {
    :global(html),
    :global(body) {
      overflow-x: hidden;
    }

    h1 {
      font-size: clamp(36px, 12vw, 48px);
    }

    .gallery-nav {
      margin-bottom: 40px;
    }

    .section-heading {
      flex-wrap: wrap;
      gap: 6px;
    }
  }
</style>
