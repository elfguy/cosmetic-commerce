---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackToHub from '../components/BackToHub.astro';

type LogoRef = {
  name: string;
  domain: string;
  category: string;
  pattern: string;
  lesson: string;
};

const logoRefs: LogoRef[] = [
  { name: 'Aesop', domain: 'aesop.com', category: 'Quiet Clinical', pattern: 'plain wordmark, generous copy system', lesson: '로고 자체보다 타이포/문장/패키지 질서가 브랜드를 만든다.' },
  { name: 'La Mer', domain: 'lamer.com', category: 'Luxury Skincare', pattern: 'refined serif, heritage cue', lesson: '세리프 하나만으로 고가 이미지를 만들 수 있다.' },
  { name: 'Augustinus Bader', domain: 'augustinusbader.com', category: 'Luxury Skincare', pattern: 'medical founder name, sober typography', lesson: '기능성과 럭셔리를 동시에 줄 때 장식은 거의 필요 없다.' },
  { name: 'Dr. Barbara Sturm', domain: 'drsturm.com', category: 'Quiet Clinical', pattern: 'doctor-led sans wordmark', lesson: '피부 과학 신뢰감은 차갑게, 여백은 넉넉하게.' },
  { name: 'Tatcha', domain: 'tatcha.com', category: 'Heritage Beauty', pattern: 'soft heritage wordmark, calm color', lesson: '동양적 무드는 노골적 문양보다 비례와 색으로 전달한다.' },
  { name: 'Sulwhasoo', domain: 'sulwhasoo.com', category: 'Heritage Beauty', pattern: 'Korean heritage, elegant wordmark', lesson: '한국 브랜드도 과한 전통 장식 없이 고급감을 만들 수 있다.' },
  { name: 'Amorepacific', domain: 'amorepacific.com', category: 'K-Beauty Premium', pattern: 'corporate premium sans/serif balance', lesson: '대형 브랜드일수록 로고는 조용하고 시스템이 강하다.' },
  { name: 'La Prairie', domain: 'laprairie.com', category: 'Luxury Skincare', pattern: 'serif wordmark, Swiss luxury restraint', lesson: '금색보다 흑백의 정확한 비례가 더 비싸 보인다.' },
  { name: 'Sisley Paris', domain: 'sisley-paris.com', category: 'Luxury Skincare', pattern: 'family-name serif, botanical luxury', lesson: '자연주의라도 잎 그림 없이 이름의 품격으로 간다.' },
  { name: 'Clarins', domain: 'clarins.com', category: 'Classic Beauty', pattern: 'heritage red, approachable luxury', lesson: '색 하나가 브랜드 기억을 만들 수 있지만 로고는 단순하다.' },
  { name: 'Biologique Recherche', domain: 'biologique-recherche.com', category: 'Quiet Clinical', pattern: 'clinical French wordmark', lesson: '전문가 브랜드는 설명보다 절제된 권위가 중요하다.' },
  { name: '111Skin', domain: '111skin.com', category: 'Quiet Clinical', pattern: 'numeric identity, premium clinic feel', lesson: '문자보다 숫자/기호가 심볼 역할을 할 수 있다.' },
  { name: 'SkinCeuticals', domain: 'skinceuticals.com', category: 'Derm Beauty', pattern: 'science-led sans', lesson: '기능성 제품군은 장식보다 명료성이 우선이다.' },
  { name: 'SkinMedica', domain: 'skinmedica.com', category: 'Derm Beauty', pattern: 'medical serif/sans balance', lesson: '피부과 계열은 너무 예쁘게 꾸미면 신뢰감이 줄어든다.' },
  { name: 'Perricone MD', domain: 'perriconemd.com', category: 'Derm Beauty', pattern: 'doctor name, restrained authority', lesson: '전문가 이름형 로고는 간결할수록 신뢰가 오른다.' },
  { name: 'Murad', domain: 'murad.com', category: 'Derm Beauty', pattern: 'bold simple wordmark', lesson: '짧은 이름은 굵기와 여백으로 선반에서 이긴다.' },
  { name: 'Dermalogica', domain: 'dermalogica.com', category: 'Quiet Clinical', pattern: 'lowercase clinical sans', lesson: '소문자 산세리프도 충분히 프리미엄이 될 수 있다.' },
  { name: 'Paula\'s Choice', domain: 'paulaschoice.com', category: 'Ingredient-First', pattern: 'direct, expert-led wordmark', lesson: '성분 중심 브랜드는 로고보다 정보 구조가 더 중요하다.' },
  { name: 'The Ordinary', domain: 'theordinary.com', category: 'Ingredient-First', pattern: 'generic typography as anti-brand', lesson: '평범함을 끝까지 밀면 오히려 강한 정체성이 된다.' },
  { name: 'NIOD', domain: 'niod.com', category: 'Ingredient-First', pattern: 'technical uppercase mark', lesson: '짧은 약어는 스킨케어에서 과학적 인상을 준다.' },
  { name: 'Drunk Elephant', domain: 'drunkelephant.com', category: 'Color System', pattern: 'playful name, color-coded packaging', lesson: '로고가 심플해도 컬러 시스템이 강하면 기억된다.' },
  { name: 'Sunday Riley', domain: 'sundayriley.com', category: 'Modern Beauty', pattern: 'founder wordmark, bright system', lesson: '이름형 로고는 제품명/컬러와 함께 살아난다.' },
  { name: 'Farmacy', domain: 'farmacybeauty.com', category: 'Natural Modern', pattern: 'clean natural, pharmacy pun', lesson: '자연주의라도 촌스럽지 않으려면 기호를 줄여야 한다.' },
  { name: 'Fresh', domain: 'fresh.com', category: 'Natural Modern', pattern: 'soft serif, apothecary cue', lesson: '친근한 자연주의는 부드러운 세리프가 잘 맞는다.' },
  { name: 'Herbivore', domain: 'herbivorebotanicals.com', category: 'Natural Modern', pattern: 'airy wordmark, pastel product world', lesson: '식물 이미지는 로고가 아니라 제품 사진/색으로 맡긴다.' },
  { name: 'Youth To The People', domain: 'youthtothepeople.com', category: 'Modern Beauty', pattern: 'stacked typography, activist energy', lesson: '긴 이름도 구조적으로 쌓으면 강한 로고가 된다.' },
  { name: 'Glow Recipe', domain: 'glowrecipe.com', category: 'Modern Beauty', pattern: 'friendly rounded wordmark', lesson: '타깃이 젊으면 둥근 글꼴도 먹히지만 유어스킨엔 과할 수 있다.' },
  { name: 'Then I Met You', domain: 'thenimetyou.com', category: 'K-Beauty Modern', pattern: 'story-like wordmark', lesson: '감성형 이름은 로고보다 문장형 브랜드톤이 중요하다.' },
  { name: 'Peach & Lily', domain: 'peachandlily.com', category: 'K-Beauty Modern', pattern: 'soft approachable wordmark', lesson: 'K뷰티 대중 브랜드는 럭셔리보다 접근성을 우선한다.' },
  { name: 'Laneige', domain: 'laneige.com', category: 'K-Beauty Premium', pattern: 'clean blue premium sans', lesson: '수분 이미지는 물방울이 아니라 색과 제품명으로도 충분하다.' },
  { name: 'Innisfree', domain: 'innisfree.com', category: 'Natural Modern', pattern: 'green natural wordmark', lesson: '그린은 쉽지만 흔하다. 채도를 낮춰야 고급스럽다.' },
  { name: 'Round Lab', domain: 'roundlab.com', category: 'K-Beauty Modern', pattern: 'plain system, ingredient/place cue', lesson: '장소/원료 스토리가 있으면 로고는 더 조용해도 된다.' },
  { name: 'Beauty of Joseon', domain: 'beautyofjoseon.com', category: 'Heritage Beauty', pattern: 'heritage name, restrained package', lesson: '한국적 스토리는 이름과 패키지 톤으로 충분히 전달된다.' },
  { name: 'Anua', domain: 'anuashop.com', category: 'K-Beauty Modern', pattern: 'short calm wordmark', lesson: '짧은 이름은 작게 써도 고급스럽다. YOURSKIN은 자간 관리가 더 중요하다.' },
  { name: 'COSRX', domain: 'cosrx.com', category: 'K-Beauty Modern', pattern: 'functional uppercase sans', lesson: '기능성/문제해결 브랜드는 로고가 건조해도 괜찮다.' },
  { name: 'KraveBeauty', domain: 'kravebeauty.com', category: 'Modern Beauty', pattern: 'simple sans, community tone', lesson: '친근함은 로고보다 말투에서 만든다.' },
  { name: 'Rhode', domain: 'rhodeskin.com', category: 'Celebrity Minimal', pattern: 'soft lowercase wordmark', lesson: '요즘형 미니멀은 둥글고 부드럽지만 오래갈지는 봐야 한다.' },
  { name: 'Hailey Bieber Rhode', domain: 'rhodeskin.com', category: 'Celebrity Minimal', pattern: 'single-word lifestyle mark', lesson: '사람/라이프스타일 힘이 있으면 로고는 거의 없어도 된다.' },
  { name: 'Fenty Skin', domain: 'fentybeauty.com', category: 'Celebrity Minimal', pattern: 'family brand extension', lesson: '서브 브랜드는 모브랜드의 강한 타입 시스템을 빌린다.' },
  { name: 'Kylie Skin', domain: 'kylieskin.com', category: 'Celebrity Minimal', pattern: 'personal-name mark', lesson: '유명인 없는 브랜드가 따라하면 약해 보일 수 있다.' },
  { name: 'Chanel', domain: 'chanel.com', category: 'Fashion Luxury', pattern: 'iconic sans, black-white authority', lesson: '최고급은 색보다 반복된 일관성과 역사에서 나온다.' },
  { name: 'Dior', domain: 'dior.com', category: 'Fashion Luxury', pattern: 'classic serif fashion house', lesson: '세리프의 얇고 두꺼운 대비가 바로 명품 신호가 된다.' },
  { name: 'YSL Beauty', domain: 'yslbeautyus.com', category: 'Fashion Luxury', pattern: 'monogram + wordmark', lesson: '모노그램은 강하지만 새 브랜드가 과하면 가짜 명품처럼 보인다.' },
  { name: 'Armani Beauty', domain: 'armanibeauty.com', category: 'Fashion Luxury', pattern: 'fashion house extension', lesson: '패션 럭셔리는 심볼 하나보다 이름의 권위가 크다.' },
  { name: 'Hermes', domain: 'hermes.com', category: 'Fashion Luxury', pattern: 'heritage serif and orange', lesson: '전통색 하나가 브랜드 자산이 될 수 있다.' },
  { name: 'Celine', domain: 'celine.com', category: 'Fashion Luxury', pattern: 'precise uppercase wordmark', lesson: '자간/획 두께만으로도 충분히 고급스럽다.' },
  { name: 'Loewe', domain: 'loewe.com', category: 'Fashion Luxury', pattern: 'heritage monogram + wordmark', lesson: '심볼은 작게, 워드마크는 정확하게.' },
  { name: 'Bottega Veneta', domain: 'bottegaveneta.com', category: 'Fashion Luxury', pattern: 'quiet luxury wordmark', lesson: '요란하지 않은 브랜드가 더 비싸 보이는 시대다.' },
  { name: 'Prada', domain: 'prada.com', category: 'Fashion Luxury', pattern: 'triangle heritage, compact wordmark', lesson: '간단한 프레임이 패키지 씰로 확장될 수 있다.' },
  { name: 'Gucci', domain: 'gucci.com', category: 'Fashion Luxury', pattern: 'classic serif, maximal brand world', lesson: '로고가 단순해도 주변 세계관은 강할 수 있다.' },
  { name: 'Tom Ford', domain: 'tomford.com', category: 'Fashion Luxury', pattern: 'stacked uppercase wordmark', lesson: '2단 워드마크는 고급 브랜드에서 매우 강력한 공식이다.' },
  { name: 'Byredo', domain: 'byredo.com', category: 'Fragrance Minimal', pattern: 'plain sans, label system', lesson: '향수/화장품은 라벨 그리드가 로고보다 중요할 때가 많다.' },
  { name: 'Le Labo', domain: 'lelabofragrances.com', category: 'Fragrance Minimal', pattern: 'typewriter label, lab identity', lesson: '불완전한 타이포도 컨셉이 명확하면 프리미엄이 된다.' },
  { name: 'Diptyque', domain: 'diptyqueparis.com', category: 'Fragrance Minimal', pattern: 'oval label, heritage typography', lesson: '라벨 형태 자체가 심볼이 될 수 있다.' },
  { name: 'Jo Malone London', domain: 'jomalone.com', category: 'Fragrance Minimal', pattern: 'classic boxed wordmark', lesson: '박스 라인 하나로 선물감/고급감을 만든다.' },
  { name: 'Maison Margiela Fragrances', domain: 'maisonmargiela-fragrances.us', category: 'Fragrance Minimal', pattern: 'replica label system', lesson: '제품별 스토리 라벨이 강하면 로고는 조연이다.' },
  { name: 'Frederic Malle', domain: 'fredericmalle.com', category: 'Fragrance Minimal', pattern: 'publisher-like typography', lesson: '에디토리얼 감성은 향수/스킨케어 모두에 잘 맞는다.' },
  { name: 'Acqua di Parma', domain: 'acquadiparma.com', category: 'Fragrance Minimal', pattern: 'heritage crest, signature yellow', lesson: '크레스트는 잘못 쓰면 낡아 보이니 극도로 절제해야 한다.' },
  { name: 'Penhaligon\'s', domain: 'penhaligons.com', category: 'Fragrance Minimal', pattern: 'British heritage wordmark', lesson: '역사감은 로고보다 포장 재질/라벨에서 완성된다.' },
  { name: 'Vogue', domain: 'vogue.com', category: 'Editorial', pattern: 'high contrast masthead serif', lesson: 'YOURSKIN의 masthead 방향은 여기서 배울 점이 많다.' },
  { name: 'Harper\'s Bazaar', domain: 'harpersbazaar.com', category: 'Editorial', pattern: 'fashion serif masthead', lesson: '긴 이름도 얇은 세리프와 넓은 여백으로 정리한다.' },
  { name: 'Elle', domain: 'elle.com', category: 'Editorial', pattern: 'distinctive tall masthead', lesson: '글자 자체가 심볼이 될 수 있다.' },
  { name: 'Kinfolk', domain: 'kinfolk.com', category: 'Editorial', pattern: 'quiet lifestyle serif', lesson: '조용한 감도는 색보다 종이 같은 배경과 여백에서 나온다.' },
  { name: 'Monocle', domain: 'monocle.com', category: 'Editorial', pattern: 'editorial seal + wordmark', lesson: '작은 씰은 브랜드 세계관을 만들지만 남용하면 복잡하다.' },
  { name: 'Wallpaper', domain: 'wallpaper.com', category: 'Editorial', pattern: 'bold editorial wordmark', lesson: '심플한 워드마크도 스케일을 키우면 강해진다.' },
  { name: 'The Gentlewoman', domain: 'thegentlewoman.co.uk', category: 'Editorial', pattern: 'literary serif wordmark', lesson: '여성 타깃 고급감은 과장보다 품위가 중요하다.' },
  { name: 'Porter', domain: 'net-a-porter.com', category: 'Editorial Commerce', pattern: 'luxury editorial commerce', lesson: '커머스도 매거진처럼 보이면 가격 저항이 줄어든다.' },
  { name: 'Net-a-Porter', domain: 'net-a-porter.com', category: 'Editorial Commerce', pattern: 'wordmark-first commerce', lesson: '쇼핑몰 로고도 할인몰처럼 보이지 않게 타이포가 중요하다.' },
  { name: 'Farfetch', domain: 'farfetch.com', category: 'Editorial Commerce', pattern: 'simple global commerce mark', lesson: '플랫폼은 과하게 럭셔리하지 않고 중립성을 택한다.' },
  { name: 'SSENSE', domain: 'ssense.com', category: 'Editorial Commerce', pattern: 'uppercase editorial sans', lesson: '짧고 강한 대문자 로고는 디지털에서 잘 버틴다.' },
  { name: 'Mr Porter', domain: 'mrporter.com', category: 'Editorial Commerce', pattern: 'gentleman editorial wordmark', lesson: '타깃 연령이 높을수록 침착한 타이포가 유리하다.' },
  { name: 'Violet Grey', domain: 'violetgrey.com', category: 'Editorial Beauty', pattern: 'beauty editorial curation', lesson: '큐레이션 감성은 유어스킨 상세페이지 톤에도 참고 가능하다.' },
  { name: 'Cult Beauty', domain: 'cultbeauty.com', category: 'Editorial Beauty', pattern: 'retail beauty wordmark', lesson: '판매 사이트는 로고보다 제품 카드/편집 톤이 중요하다.' },
  { name: 'Space NK', domain: 'spacenk.com', category: 'Editorial Beauty', pattern: 'premium beauty retail', lesson: '고급 리테일은 단순하고 읽기 쉬운 이름을 선호한다.' },
  { name: 'Mecca', domain: 'mecca.com', category: 'Editorial Beauty', pattern: 'bold retail wordmark', lesson: '강한 리테일 로고는 브랜드 로고와 달리 명확성이 먼저다.' },
  { name: 'Sephora', domain: 'sephora.com', category: 'Beauty Retail', pattern: 'bold sans + stripe symbol', lesson: '심볼이 있어도 워드마크 인지도가 더 중요하다.' },
  { name: 'Olive Young', domain: 'oliveyoung.com', category: 'Beauty Retail', pattern: 'retail-friendly green mark', lesson: '리테일 그린과 럭셔리 그린은 채도부터 달라야 한다.' },
];

const categories = Array.from(new Set(logoRefs.map((item) => item.category)));
const categoryCounts = categories.map((category) => ({
  category,
  count: logoRefs.filter((item) => item.category === category).length,
}));

const faviconUrl = (domain: string) =>
  `https://www.google.com/s2/favicons?domain=${domain}&sz=128`;
---

<BaseLayout title="Logo Inspiration Board" description="YOURSKIN PLUS 로고 영감 수집 보드">
  <BackToHub label="로고 영감 보드" kind="브랜드" />
  <main class="inspo-page">
    <section class="inspo-hero">
      <nav class="inspo-nav" aria-label="페이지 이동">
        <a href="/brand-logo/">Brand Logo</a>
        <a href="/brand-typography/">Typography Study</a>
        <a href="/shop-concept/">Storefront</a>
      </nav>
      <div class="hero-layout">
        <div>
          <p class="eyebrow">Reference board</p>
          <h1>Luxury Beauty Logo Inspiration</h1>
          <p class="hero-copy">
            스킨케어, 향수, 패션, 에디토리얼 커머스 로고를 한 화면에 모았습니다.
            YOURSKIN PLUS가 참고할 것은 로고 형태 자체보다 여백, 자간, 위계, 브랜드 시스템입니다.
          </p>
        </div>
        <aside>
          <span>{logoRefs.length}</span>
          <strong>references</strong>
          <p>공식 도메인 favicon과 브랜드명, 패턴 메모를 내부 참고용으로 정리했습니다.</p>
        </aside>
      </div>
    </section>

    <section class="principles">
      <article>
        <span>01</span>
        <strong>Wordmark First</strong>
        <p>럭셔리 스킨케어는 잎, 물방울, 얼굴보다 정확한 글자와 여백을 믿습니다.</p>
      </article>
      <article>
        <span>02</span>
        <strong>System Over Trick</strong>
        <p>좋은 로고는 단독 이미지가 아니라 패키지, 상세페이지, 라벨 그리드까지 이어집니다.</p>
      </article>
      <article>
        <span>03</span>
        <strong>Low Symbol Pressure</strong>
        <p>심볼은 작아야 합니다. 모노그램이나 작은 플러스 포인트 정도가 안전합니다.</p>
      </article>
      <article>
        <span>04</span>
        <strong>Color Restraint</strong>
        <p>딥그린과 아이보리, 아주 작은 골드만 남겨야 고급감이 유지됩니다.</p>
      </article>
    </section>

    <section class="category-strip" aria-label="카테고리 요약">
      {categoryCounts.map((item) => (
        <a href={`#${item.category.toLowerCase().replaceAll(' ', '-')}`}>
          <span>{item.count}</span>
          {item.category}
        </a>
      ))}
    </section>

    {categories.map((category) => (
      <section class="logo-section" id={category.toLowerCase().replaceAll(' ', '-')}>
        <div class="section-heading">
          <p class="eyebrow">{category}</p>
          <h2>{category}</h2>
        </div>
        <div class="logo-grid">
          {logoRefs
            .filter((item) => item.category === category)
            .map((item) => (
              <article class="logo-card">
                <div class="logo-top">
                  <img src={faviconUrl(item.domain)} alt={`${item.name} favicon`} loading="lazy" />
                  <a href={`https://${item.domain}`} target="_blank" rel="noreferrer">{item.domain}</a>
                </div>
                <div class="brand-sample">
                  <span>{item.name}</span>
                </div>
                <div class="logo-copy">
                  <strong>{item.pattern}</strong>
                  <p>{item.lesson}</p>
                </div>
              </article>
            ))}
