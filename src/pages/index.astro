---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteSections } from '../data/siteMap';
import { commandTasks, focusProducts, products } from '../data/marketingOps';

const totalPrice = products.reduce((sum, p) => sum + p.price.sale, 0);
const totalReviews = products.reduce((sum, p) => sum + p.rating.coupangReviews, 0);
const activeDetailCount = products.filter((p) => p.assets.detailImageCount > 0).length;

const stats = [
  { label: '관리 상품', value: `${products.length}`, unit: '개', note: '현재 판매 SKU' },
  { label: '판매가 합계', value: totalPrice.toLocaleString('ko-KR'), unit: '원', note: '쿠팡 등록가 기준' },
  { label: '리뷰 합계', value: totalReviews.toLocaleString('ko-KR'), unit: '개', note: '구매 신뢰 신호' },
  { label: '적용 상세', value: `${activeDetailCount}`, unit: '개', note: '상세 이미지 반영' },
];

const focusNames = focusProducts.map((p) => p.shortName).join(' · ');
const todayTasks = commandTasks.slice(0, 3);

---

<BaseLayout
  title="YOURSKIN+ 운영 허브"
  description="유어스킨플러스 내부 운영·마케팅 도구 허브 — 상품상세, 경쟁상품, 상세 이미지 작업, 쇼핑몰 시안을 한 곳에서."
>
  <SiteHeader active="/" />

  <main class="hub">
    <!-- HERO -->
    <section class="hero container">
      <div class="hero__text">
        <p class="eyebrow">Internal marketing tool</p>
        <h1>유어스킨플러스<br />운영·마케팅 허브</h1>
        <p class="hero__lead">
          판매 중인 상품의 상세·경쟁·이미지 작업을 한곳에서 봅니다.
          PC와 모바일 모두에서 동료와 같은 화면을 공유하세요.
        </p>
        <div class="hero__cta">
          <a class="btn" href="/products/">상품상세 보드 →</a>
          <a class="btn-ghost" href="/marketing/meta-owner-setup/">대표님 가입·연결 안내 →</a>
          <a class="btn-ghost" href="/competitor-comparison/">경쟁상품 분석</a>
        </div>
      </div>
      <aside class="hero__panel">
        <span class="hero__panel-eyebrow">오늘 볼 것</span>
        <strong>{focusProducts.length}개 집중 상품</strong>
        <p>{focusNames}</p>
        <a href="/workspaces/">상세 버전 랩으로 →</a>
      </aside>
    </section>

    <!-- TODAY ACTIONS -->
    <section class="today container" aria-label="오늘 우선 작업">
      <div class="today__head">
        <p class="eyebrow">Today's priority</p>
        <h2>오늘 바로 볼 작업</h2>
      </div>
      <div class="today__list">
        {todayTasks.map((task) => (
          <a class="task" href={task.href}>
            <span class="task__state">{task.state}</span>
            <span class="task__body">
              <strong>{task.title}</strong>
              <small>{task.product} · {task.label}</small>
            </span>
            <em aria-hidden="true">→</em>
          </a>
        ))}
      </div>
    </section>

    <!-- STAT STRIP -->
    <section class="stats container" aria-label="운영 지표">
      {stats.map((s) => (
        <article class="stat">
          <span class="stat__label">{s.label}</span>
          <strong class="stat__value">{s.value}<em>{s.unit}</em></strong>
          <small class="stat__note">{s.note}</small>
        </article>
      ))}
    </section>

    <!-- SECTIONS -->
    {siteSections.map((section) => (
      <section class="block container" id={section.id} aria-label={section.label}>
        <header class="block__head">
          <div>
            <p class="eyebrow">{section.eyebrow}</p>
            <h2>{section.label}</h2>
          </div>
          <p class="block__desc">{section.desc}</p>
        </header>
        <div class="grid">
          {section.links.map((link) => (
            <a class="tile" href={link.href}>
              {link.thumb && (
                <span class="tile__thumb">
                  <img src={link.thumb} alt="" loading="lazy" />
                </span>
              )}
              <span class="tile__body">
                <span class="tile__meta">
                  <span>{section.label}</span>
                  {link.tag && <em>{link.tag}</em>}
                </span>
                <strong>{link.title}</strong>
                <small>{link.desc}</small>
                <span class="tile__go" aria-hidden="true">열기 →</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hub { position: relative; z-index: 1; padding-bottom: 8px; }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    padding-block: clamp(36px, 7vw, 84px) clamp(24px, 4vw, 44px);
  }
  .hero__text h1 {
    margin: 14px 0 16px;
    font-size: clamp(34px, 6.4vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .hero__lead {
    margin: 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.7;
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .hero__panel {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: center;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-lg);
    background: var(--forest);
    color: #f4efe4;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .hero__panel::after {
    content: '';
    position: absolute;
    right: -40px; top: -40px;
    width: 180px; height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 101, 74, 0.5), transparent 70%);
  }
  .hero__panel-eyebrow {
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--forest-soft);
  }
  .hero__panel strong { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.15; }
  .hero__panel p { margin: 2px 0 10px; color: #cdd8cf; font-size: 14px; line-height: 1.55; }
  .hero__panel a { color: #fff; font-weight: 700; font-size: 14px; text-decoration: none; }
  .hero__panel a:hover { text-decoration: underline; }

  /* TODAY ACTIONS */
  .today {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 14px;
    align-items: stretch;
    padding-block: 4px clamp(20px, 4vw, 34px);
  }
  .today__head {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface-2);
  }
  .today__head h2 { margin: 7px 0 0; font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -0.01em; }
  .today__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .task {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 11px;
    align-items: center;
    min-height: 96px;
    padding: 16px;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
  }
  .task:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  .task__state {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 30px;
    padding-inline: 10px;
    border-radius: var(--r-pill);
    background: var(--forest);
    color: #f7f3e9;
    font-size: 12px;
    font-weight: 800;
  }
  .task__body { display: grid; gap: 4px; min-width: 0; }
  .task__body strong { font-size: 15px; line-height: 1.35; }
  .task__body small { color: var(--muted); font-size: 12.5px; line-height: 1.4; }
  .task em { color: var(--accent); font-style: normal; font-weight: 900; }

  /* STAT STRIP */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    padding-block: 6px clamp(28px, 5vw, 52px);
  }
  .stat {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border-radius: var(--r);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .stat__label { color: var(--muted); font-size: 12.5px; font-weight: 700; }
  .stat__value { font-size: clamp(24px, 3vw, 34px); line-height: 1; font-weight: 800; color: var(--ink); }
  .stat__value em { font-size: 0.5em; font-weight: 700; font-style: normal; color: var(--accent); margin-left: 3px; }
  .stat__note { color: var(--faint); font-size: 12px; }

  /* SECTION BLOCKS */
  .block { padding-block: clamp(18px, 3vw, 30px); }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .block__head h2 { margin: 6px 0 0; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.01em; }
  .block__desc { margin: 0; max-width: 52ch; color: var(--muted); font-size: 14px; line-height: 1.6; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 12px;
  }
  .tile {
    position: relative;
    display: flex;
    min-height: 148px;
    border-radius: var(--r);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--accent);
    opacity: 0.72;
  }
  .tile:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--line-strong); background: var(--surface-2); }
  .tile__thumb {
    flex: 0 0 104px;
    min-height: 100%;
    overflow: hidden;
    background: var(--surface-3);
  }
  .tile__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tile__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 18px 18px 18px 22px;
    flex: 1;
  }
  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    color: var(--faint);
    font-size: 11.5px;
    font-weight: 800;
  }
  .tile__meta span,
  .tile__meta em {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--surface-3);
    font-style: normal;
  }
  .tile__meta em { background: var(--accent-soft); color: var(--accent-ink); }
  .tile__body strong { font-size: 17px; line-height: 1.3; letter-spacing: -0.01em; }
  .tile__body small { color: var(--muted); font-size: 13px; line-height: 1.55; flex: 1; }
  .tile__go { margin-top: 2px; color: var(--accent); font-size: 13px; font-weight: 800; }

  /* RESPONSIVE */
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .today { grid-template-columns: 1fr; }
    .today__list { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .hero { padding-block-start: 28px; }
    .hero__text h1 { font-size: clamp(31px, 9vw, 38px); }
    .hero__cta .btn, .hero__cta .btn-ghost { flex: 1 1 auto; }
    .today__head { padding: 0; border: 0; background: transparent; }
    .task { min-height: 82px; }
    .stat { padding: 14px 15px; }
  }
</style>
