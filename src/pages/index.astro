---
import BaseLayout from '../layouts/BaseLayout.astro';
import { focusProducts, formatWon, products, supportProducts, watchProducts } from '../data/marketingOps';

const totalPrice = products.reduce((sum, product) => sum + product.price.sale, 0);
const totalReviews = products.reduce((sum, product) => sum + product.rating.coupangReviews, 0);
const highRiskCount = products.filter((product) => product.ops.claimRisk === 'high').length;
const activeDetailCount = products.filter((product) => product.assets.detailImageCount > 0).length;
const versionReadyCount = products.filter((product) => product.ops.workspaceUrl).length;
const focusNames = focusProducts.map((product) => product.shortName).join(', ');

const nextProducts = products.slice().sort((a, b) => {
  const order = { focus: 0, support: 1, watch: 2, archive: 3 };
  return order[a.ops.priority] - order[b.ops.priority];
}).slice(0, 5);

const dashboardCards = [
  { label: '상품개수', value: products.length + '개', note: '현재 관리 SKU' },
  { label: '현재 판매가 합계', value: formatWon(totalPrice), note: '쿠팡 등록가 기준' },
  { label: '리뷰 합계', value: totalReviews.toLocaleString('ko-KR') + '개', note: '구매 신뢰 신호' },
  { label: '현재 적용 상세', value: activeDetailCount + '개', note: '상품상세 메뉴에서 확인' },
];
---

<BaseLayout title="유어스킨플러스 운영 대시보드" description="상품상세와 경쟁상품을 간결하게 관리하는 유어스킨플러스 운영 대시보드">
  <main class="dashboard">
    <header class="topbar">
      <a href="/" class="logo" aria-label="대시보드로 이동"><img src="/yourskin-logo-header-v15.svg" alt="YOURSKIN+" /></a>
      <button class="menu-toggle" type="button" aria-label="메뉴 열기" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav aria-label="주 메뉴">
        <a class="is-active" href="/">대시보드</a>
        <a href="/products/">상품상세</a>
        <a href="/competitor-comparison/">경쟁상품</a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Operation dashboard</p>
        <h1>상품상세와 경쟁상품을 먼저 정리하는 운영판</h1>
        <p>첫 화면은 숫자와 우선순위만 보여줍니다. 상세 제작 버전은 계속 늘리되, 기준은 현재 판매 중인 상품상세입니다.</p>
      </div>
      <aside class="priority-card">
        <span>오늘 볼 것</span>
        <strong>{focusProducts.length}개 집중 상품</strong>
        <small>{focusNames}</small>
      </aside>
    </section>

    <section class="metrics" aria-label="운영 지표">
      {dashboardCards.map((card) => (
        <article>
          <span>{card.label}</span>
          <strong>{card.value}</strong>
          <small>{card.note}</small>
        </article>
      ))}
    </section>

    <section class="menu-grid" aria-label="주요 메뉴">
      <a class="menu-card primary" href="/products/">
        <span>상품상세</span>
        <strong>현재 적용된 상세 관리</strong>
        <small>상품별 가격, 리뷰, 상세 상태, 다음 작업</small>
      </a>
      <a class="menu-card" href="/competitor-comparison/">
        <span>경쟁상품</span>
        <strong>쿠팡 경쟁군 대응</strong>
        <small>리뷰 격차, 월 구매 신호, 대응 메시지</small>
      </a>
    </section>

    <section class="work-grid">
      <article class="panel">
        <div class="panel-head">
          <div>
            <p class="eyebrow">Product detail</p>
            <h2>먼저 정리할 상품상세</h2>
          </div>
          <a href="/products/">전체 보기</a>
        </div>
        <div class="product-list">
          {nextProducts.map((product) => (
            <a href={'/products/' + product.slug + '/'} class="product-row">
              <img src={product.assets.thumbnail} alt={product.shortName + ' 대표 이미지'} loading="lazy" />
              <span>
                <strong>{product.shortName}</strong>
                <small>{product.ops.detailStatus}</small>
              </span>
              <em>{formatWon(product.price.sale)}</em>
            </a>
          ))}
        </div>
      </article>

      <article class="panel compact">
        <p class="eyebrow">Status</p>
        <h2>운영 상태</h2>
        <dl>
          <div><dt>집중</dt><dd>{focusProducts.length}개</dd></div>
          <div><dt>보조</dt><dd>{supportProducts.length}개</dd></div>
          <div><dt>관찰</dt><dd>{watchProducts.length}개</dd></div>
          <div><dt>표현 고위험</dt><dd>{highRiskCount}개</dd></div>
          <div><dt>버전 후보</dt><dd>{versionReadyCount}개</dd></div>
        </dl>
      </article>
    </section>
  </main>
</BaseLayout>

<script>
  const menuButton = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('.topbar nav');
  menuButton?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    menuButton.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  :global(body) { background: #eef1ec; }
  .dashboard {
    --ink:#17211d;
    --muted:#68766f;
    --line:#d8e0d6;
    --paper:#fbfcf8;
    --dark:#12251f;
    --accent:#c76045;
    min-height:100vh;
    color:var(--ink);
    background:#eef1ec;
    font-family:var(--font-body);
  }
  a { color:inherit; text-decoration:none; }
  .topbar {
    position:sticky;
    top:0;
    z-index:10;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:14px;
    padding:12px 22px;
    border-bottom:1px solid var(--line);
    background:rgba(238,241,236,.94);
    backdrop-filter:blur(12px);
  }
  .logo img { width:146px; padding:8px 10px; border-radius:6px; background:#f8f4ea; }
  nav { display:flex; gap:8px; overflow-x:auto; }
  nav a {
    flex:0 0 auto;
    padding:9px 12px;
    border-radius:999px;
    background:#fff;
    color:var(--ink);
    border:1px solid var(--line);
    font-size:13px;
    font-weight:800;
  }
  nav a.is-active { background:var(--dark); color:#fffaf0; border-color:var(--dark); }
  .menu-toggle { display:none; }
  .hero {
    display:grid;
    grid-template-columns:minmax(0,1fr) 320px;
    gap:18px;
    padding:28px 22px 16px;
  }
  .eyebrow {
    margin:0;
    color:var(--accent);
    font-family:var(--font-latin);
    font-size:11px;
    font-weight:800;
    letter-spacing:0;
    text-transform:uppercase;
  }
  h1 { max-width:880px; margin:8px 0 10px; font-size:clamp(34px,4.5vw,64px); line-height:1; letter-spacing:0; }
  .hero p:not(.eyebrow) { max-width:720px; margin:0; color:var(--muted); font-size:17px; line-height:1.6; }
  .priority-card, .metrics article, .menu-card, .panel {
    border:1px solid var(--line);
    border-radius:8px;
    background:var(--paper);
    box-shadow:0 14px 44px rgba(21,34,28,.08);
  }
  .priority-card {
    display:grid;
    align-content:end;
    gap:8px;
    padding:20px;
    background:var(--dark);
    color:#fffaf0;
  }
  .priority-card span, .priority-card small { color:#c7d5cd; }
  .priority-card strong { font-size:26px; line-height:1.16; }
  .metrics {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:12px;
    padding:0 22px 16px;
  }
  .metrics article { min-height:124px; display:grid; align-content:space-between; padding:18px; }
  .metrics span, .menu-card span { color:var(--muted); font-size:13px; font-weight:800; }
  .metrics strong { color:var(--accent); font-size:32px; line-height:1.05; }
  .metrics small, .menu-card small, .product-row small { color:var(--muted); line-height:1.45; }
  .menu-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    padding:0 22px 16px;
  }
  .menu-card { display:grid; gap:8px; padding:20px; min-height:144px; }
  .menu-card strong { font-size:26px; line-height:1.14; }
  .menu-card.primary { background:#17211d; color:#fffaf0; border-color:#17211d; }
  .menu-card.primary span, .menu-card.primary small { color:#c7d5cd; }
  .work-grid {
    display:grid;
    grid-template-columns:minmax(0,1fr) 340px;
    gap:16px;
    padding:0 22px 24px;
  }
  .panel { padding:18px; }
  .panel-head { display:flex; justify-content:space-between; gap:14px; align-items:start; margin-bottom:14px; }
  .panel h2 { margin:5px 0 0; font-size:25px; letter-spacing:0; }
  .panel-head a {
    flex:0 0 auto;
    padding:8px 10px;
    border-radius:999px;
    background:var(--dark);
    color:#fffaf0;
    font-size:13px;
    font-weight:800;
  }
  .product-list { display:grid; gap:9px; }
  .product-row {
    display:grid;
    grid-template-columns:58px minmax(0,1fr) auto;
    gap:11px;
    align-items:center;
    padding:10px;
    border:1px solid var(--line);
    border-radius:8px;
    background:#fff;
  }
  .product-row img { width:58px; height:58px; object-fit:cover; border-radius:6px; background:#edf1ec; }
  .product-row span { min-width:0; display:grid; gap:4px; }
  .product-row strong, .product-row small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .product-row em { color:var(--accent); font-style:normal; font-weight:900; }
  .compact dl { display:grid; gap:8px; margin:16px 0 0; }
  .compact dl div { display:flex; justify-content:space-between; gap:12px; padding:12px; border-radius:8px; background:#f2f6f1; }
  dt { color:var(--muted); font-size:13px; }
  dd { margin:0; font-weight:900; }
  @media (max-width:1040px) {
    .hero, .work-grid { grid-template-columns:1fr; }
    .metrics { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media (max-width:720px) {
    .topbar { justify-content:space-between; padding:10px 12px; }
    .logo img { width:118px; padding:6px 8px; }
    .menu-toggle {
      display:grid;
      place-content:center;
      gap:4px;
      width:42px;
      height:42px;
      border:1px solid var(--line);
      border-radius:12px;
      background:#fff;
      cursor:pointer;
    }
    .menu-toggle span { display:block; width:18px; height:2px; border-radius:999px; background:var(--ink); }
    nav {
      position:absolute;
      top:62px;
      right:12px;
      z-index:30;
      display:none;
      width:min(220px, calc(100vw - 24px));
      grid-template-columns:1fr;
      gap:6px;
      max-width:none;
      padding:6px;
      border:1px solid rgba(216,224,214,.9);
      border-radius:18px;
      background:rgba(251,252,248,.94);
      box-shadow:0 12px 36px rgba(18,37,31,.18);
      backdrop-filter:blur(14px);
      overflow:visible;
    }
    nav.is-open { display:grid; }
    nav a { display:flex; align-items:center; justify-content:flex-start; min-height:42px; padding:0 12px; border-radius:13px; font-size:14px; }
    .hero { padding:18px 12px 12px; }
    h1 { font-size:30px; line-height:1.08; }
    .hero p:not(.eyebrow) { font-size:15px; line-height:1.55; }
    .priority-card { padding:16px; }
    .metrics { grid-template-columns: repeat(2, 1fr); padding-left:12px; padding-right:12px; }
    .menu-grid, .work-grid { grid-template-columns:1fr; padding-left:12px; padding-right:12px; }
    .metrics article { min-height:90px; padding:14px; }
    .metrics strong { font-size:24px; }
    .metrics small { font-size: 11px; }
    .menu-card { min-height:110px; padding:16px; }
    .menu-card strong { font-size:20px; }
    .panel { padding:15px; }
    .panel h2 { font-size:20px; }
    .product-row { grid-template-columns:48px minmax(0,1fr); }
    .product-row img { width:48px; height:48px; }
    .product-row em { grid-column:2; font-size:13px; }
    .priority-card strong { font-size: 20px; }
  }
</style>
