---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../../data/yourskin-products.json';

const { brand, products } = siteData;
const heroProduct = products[0];
const featured = products.slice(0, 4);
const extended = products.slice(4);
const formatPrice = (price) => `${Number(price).toLocaleString('ko-KR')}원`;
---

<BaseLayout title="유어스킨플러스 — 대용량 스킨케어 공식 사이트 시안" description="유어스킨플러스 네이버/쿠팡 공개 상품 데이터를 기반으로 제작한 브랜드형 커머스 사이트 초안">
  <main class="ys-site">
    <section class="hero-shell">
      <nav class="top-nav" aria-label="주요 메뉴">
        <a class="logo" href="/" aria-label="유어스킨플러스 홈">
          <span>Your</span><strong>skin+</strong>
        </a>
        <div class="nav-links">
          <a href="#products">제품</a>
          <a href="#routine">루틴</a>
          <a href="/shop-concept">공식몰 컨셉</a>
          <a href="/mock-shop">수집 데이터</a>
          <a href="/coupang-mock">쿠팡 분석</a>
          <a href={brand.smartstoreUrl} target="_blank" rel="noreferrer">스토어</a>
        </div>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Yourskin+ / public data rebuild</p>
          <h1>피부가 매일 쓰는 것부터, 더 정직하게.</h1>
          <p class="lead">{brand.story}</p>
          <div class="hero-actions">
            <a class="primary" href="#products">제품 라인 보기</a>
            <a class="secondary" href={brand.smartstoreUrl} target="_blank" rel="noreferrer">네이버 스토어</a>
          </div>
          <div class="proof-strip" aria-label="수집된 공개 지표">
            <div><strong>{products.length}</strong><span>수집 상품</span></div>
            <div><strong>4.96</strong><span>최고 평점</span></div>
            <div><strong>500ml</strong><span>대용량 라인</span></div>
          </div>
        </div>

        <div class="hero-product-card">
          <div class="halo"></div>
          <img src={heroProduct.image} alt={heroProduct.fullName} />
          <div class="floating-note top">검색 노출 대표 상품</div>
          <div class="floating-note bottom">
            <span>{heroProduct.category}</span>
            <strong>{formatPrice(heroProduct.price)}</strong>
          </div>
        </div>
      </div>
    </section>

    <section id="products" class="product-section">
      <div class="section-heading">
        <p>Smartstore indexed line-up</p>
        <h2>네이버에 이미 노출된 제품을 브랜드형 상세 구조로 재배치</h2>
      </div>

      <div class="featured-grid">
        {featured.map((product, index) => (
          <article class:list={["product-card", index === 0 && "is-large"]}>
            <a href={`/products/${product.slug}/`} class="image-panel" aria-label={`${product.name} 상세 보기`}>
              <img src={product.image} alt={product.fullName} loading={index === 0 ? 'eager' : 'lazy'} />
            </a>
            <div class="card-body">
              <p class="category">{product.category} · {product.volume}</p>
              <h3>{product.name}</h3>
              <p>{product.heroLine}</p>
              <div class="metric-row">
                <span>{product.discountRate} OFF</span>
                <strong>{formatPrice(product.price)}</strong>
                <em>★ {product.rating} ({product.reviewCount})</em>
              </div>
              <div class="tag-row">
                {product.keywords.map((keyword) => <span>{keyword}</span>)}
              </div>
              <a class="text-link" href={`/products/${product.slug}/`}>상세페이지 시안 보기 →</a>
            </div>
          </article>
        ))}
      </div>

      <div class="extended-strip" aria-label="추가 가격비교 노출 제품">
        {extended.map((product) => (
          <a href={`/products/${product.slug}/`} class="mini-product">
            <img src={product.image} alt={product.fullName} loading="lazy" />
            <span>{product.category}</span>
            <strong>{product.name}</strong>
            <em>{formatPrice(product.price)}</em>
          </a>
        ))}
      </div>
    </section>

    <section id="routine" class="routine-section">
      <div class="routine-copy">
        <p>Detail rebuild strategy</p>
        <h2>상세페이지는 예쁘게만 바꾸는 게 아니라, 구매 결정을 순서대로 도와야 해.</h2>
      </div>
      <div class="routine-steps">
        {[
          ['01', '검색어를 첫 화면에 흡수', '네이버에 노출되는 긴 상품명을 고객 언어로 정리해서 첫 문장에 배치합니다.'],
          ['02', '피부 고민별 사용 장면', '보습·블랙헤드·약산성·톤케어처럼 검색 의도를 섹션 제목으로 만듭니다.'],
          ['03', '이미지 중심 구매 설득', '대표 이미지와 AI 보강 비주얼로 사용감, 제형, 루틴을 상세 이미지처럼 재구성합니다.'],
          ['04', '스마트스토어 CTA 연결', '초기에는 결제 개발보다 네이버 구매 버튼 연결로 빠르게 전환을 검증합니다.']
        ].map(([no, title, body]) => (
          <article>
            <span>{no}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #f7efe5; }

  .ys-site {
    --ink: #211b16;
    --muted: rgba(33, 27, 22, 0.66);
    --line: rgba(33, 27, 22, 0.12);
    --cream: #f7efe5;
    --paper: #fffaf3;
    --rose: #8c473a;
    --petal: #d9a99a;
    --leaf: #697a55;
    color: var(--ink);
    overflow: hidden;
  }

  .hero-shell {
    min-height: 100vh;
    padding: 28px clamp(20px, 5vw, 72px) 80px;
    background:
      radial-gradient(circle at 74% 18%, rgba(217, 169, 154, .36), transparent 28rem),
      radial-gradient(circle at 8% 88%, rgba(105, 122, 85, .18), transparent 26rem),
      linear-gradient(135deg, #fffaf3 0%, #f2dfd2 54%, #e9c9b8 100%);
  }

  .top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 auto;
    max-width: 1240px;
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    color: var(--ink);
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .logo strong { color: var(--rose); }

  .nav-links {
    display: flex;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, .7);
    border-radius: 999px;
    background: rgba(255, 250, 243, .58);
    padding: 8px;
    backdrop-filter: blur(18px);
  }

  .nav-links a {
    border-radius: 999px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
    padding: 10px 14px;
    text-decoration: none;
  }

  .nav-links a:hover { background: rgba(255,255,255,.8); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, .82fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    max-width: 1240px;
    min-height: calc(100vh - 120px);
    margin: 0 auto;
  }

  .eyebrow,
  .section-heading p,
  .routine-copy p {
    color: var(--rose);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 820px;
    margin: 18px 0 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(70px, 10vw, 138px);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: .82;
  }

  .lead {
    max-width: 650px;
    margin-top: 32px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.9;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .primary, .secondary, .text-link {
    border-radius: 999px;
    font-weight: 900;
    text-decoration: none;
  }
  .primary { background: var(--ink); color: #fffaf3; padding: 16px 24px; box-shadow: 0 18px 48px rgba(33,27,22,.22); }
  .secondary { border: 1px solid var(--line); color: var(--ink); padding: 16px 24px; background: rgba(255,255,255,.45); }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    max-width: 560px;
    margin-top: 42px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.7);
    border-radius: 28px;
    background: rgba(255,255,255,.52);
  }

  .proof-strip div { padding: 18px; }
  .proof-strip strong { display: block; font-family: 'Cormorant Garamond', serif; font-size: 40px; line-height: 1; }
  .proof-strip span { color: var(--muted); font-size: 13px; font-weight: 800; }

  .hero-product-card {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(255,255,255,.72);
    border-radius: 52px;
    background: rgba(255, 250, 243, .46);
    box-shadow: 0 38px 100px rgba(91, 55, 37, .2);
    backdrop-filter: blur(20px);
  }

  .halo {
    position: absolute;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,.98), rgba(217,169,154,.2) 58%, transparent 70%);
  }

  .hero-product-card img {
    position: relative;
    width: min(78%, 430px);
    border-radius: 36px;
    filter: drop-shadow(0 26px 48px rgba(40, 28, 22, .22));
  }

  .floating-note {
    position: absolute;
    border: 1px solid rgba(255,255,255,.72);
    border-radius: 24px;
    background: rgba(255,250,243,.82);
    box-shadow: 0 18px 42px rgba(33,27,22,.14);
    padding: 14px 16px;
    font-weight: 900;
    backdrop-filter: blur(18px);
  }

  .floating-note.top { right: -12px; top: 72px; color: var(--rose); }
  .floating-note.bottom { left: -18px; bottom: 86px; display: grid; gap: 3px; }
  .floating-note.bottom span { color: var(--muted); font-size: 12px; }

  .product-section, .routine-section { max-width: 1240px; margin: 0 auto; padding: 112px clamp(20px, 5vw, 0px); }
  .section-heading { display: grid; grid-template-columns: .8fr 1.4fr; gap: 32px; align-items: end; margin-bottom: 38px; }
  .section-heading h2, .routine-copy h2 { margin: 0; font-family: 'Cormorant Garamond', serif; font-size: clamp(44px, 6vw, 84px); letter-spacing: -0.06em; line-height: .94; }

  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .product-card {
    border: 1px solid var(--line);
    border-radius: 38px;
    background: rgba(255,250,243,.78);
    overflow: hidden;
    box-shadow: 0 16px 50px rgba(33,27,22,.08);
  }
  .product-card.is-large { grid-column: span 2; display: grid; grid-template-columns: .9fr 1fr; }
  .image-panel { display: grid; min-height: 340px; place-items: center; background: linear-gradient(145deg, #fff, #ead4c8); }
  .image-panel img { width: min(78%, 360px); border-radius: 28px; transition: transform .35s ease; }
  .image-panel:hover img { transform: translateY(-8px) rotate(-1deg); }
  .card-body { padding: 26px; }
  .category { margin: 0; color: var(--rose); font-size: 12px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .card-body h3 { margin: 12px 0 0; font-size: 28px; line-height: 1.15; }
  .card-body > p:not(.category) { color: var(--muted); line-height: 1.75; }
  .metric-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 18px; }
  .metric-row span, .metric-row em { border-radius: 999px; background: #f2e2d8; padding: 8px 11px; color: var(--rose); font-size: 12px; font-style: normal; font-weight: 900; }
  .metric-row strong { margin-right: 6px; font-size: 22px; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .tag-row span { border: 1px solid var(--line); border-radius: 999px; padding: 7px 10px; color: var(--muted); font-size: 12px; font-weight: 800; }
  .text-link { display: inline-flex; margin-top: 20px; color: var(--ink); }

  .extended-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 18px; }
  .mini-product { display: grid; grid-template-columns: 92px 1fr; gap: 14px; align-items: center; border: 1px solid var(--line); border-radius: 28px; background: rgba(255,250,243,.66); padding: 12px; color: var(--ink); text-decoration: none; }
  .mini-product img { grid-row: span 3; width: 92px; border-radius: 20px; background: white; }
  .mini-product span { color: var(--rose); font-size: 12px; font-weight: 900; }
  .mini-product strong { line-height: 1.25; }
  .mini-product em { color: var(--muted); font-style: normal; font-weight: 900; }

  .routine-section { display: grid; grid-template-columns: .9fr 1.1fr; gap: 44px; padding-top: 40px; }
  .routine-steps { display: grid; gap: 12px; }
  .routine-steps article { border-top: 1px solid var(--line); padding: 22px 0 24px; }
  .routine-steps span { color: var(--rose); font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 700; }
  .routine-steps h3 { margin: 2px 0 8px; font-size: 24px; }
  .routine-steps p { margin: 0; color: var(--muted); line-height: 1.75; }

  @media (max-width: 920px) {
    .nav-links { display: none; }
    .hero-grid, .section-heading, .routine-section { grid-template-columns: 1fr; }
    .hero-grid { min-height: auto; padding-top: 72px; }
    .product-card.is-large, .featured-grid, .extended-strip { grid-template-columns: 1fr; }
    .product-card.is-large { grid-column: auto; display: block; }
    .hero-product-card { max-width: 520px; margin: 0 auto; }
  }
</style>
