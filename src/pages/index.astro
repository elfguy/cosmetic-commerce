---
import BaseLayout from '../layouts/BaseLayout.astro';
import comparisonData from '../../data/yourskinplus-8-product-comparison.json';

const products = comparisonData.products;
const formatWon = (value) => `${Number(value).toLocaleString('ko-KR')}원`;
const totalReviews = products.reduce((sum, product) => sum + product.rating.coupangReviews, 0);
const averagePrice = Math.round(products.reduce((sum, product) => sum + product.price.sale, 0) / products.length);
const functionalProducts = products.filter((product) => product.notice.functionalCosmetic !== '해당 없음');
const naverReadyProducts = products.filter((product) => product.commerce.naverUrl);
const lowestUnit = products.reduce((min, product) => (product.price.unitPrice < min.price.unitPrice ? product : min), products[0]);
const generatedLabel = new Date(comparisonData.generatedAt).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

const bySlug = new Map(products.map((product) => [product.slug, product]));
const priorityProducts = [
  {
    product: bySlug.get('hyaluronic-toner'),
    lane: '진입 상품',
    reason: '500ml 대용량, 최저 단가, 수분 키워드로 광고 테스트가 쉽다.',
    action: '스킨팩, 닦토, 대용량 수분 루틴 소재 제작',
  },
  {
    product: bySlug.get('aqua-lotion'),
    lane: '세트 확장',
    reason: '토너와 같이 묶기 좋고 300ml 로션 가격 경쟁력이 있다.',
    action: '토너+로션 보습 루틴 세트 페이지 구성',
  },
  {
    product: bySlug.get('cleansing-oil'),
    lane: '검색 수요',
    reason: '클렌징 오일, 블랙헤드, 모공 세정 검색 의도와 연결된다.',
    action: '유화 장면 중심의 상세 첫 화면 재구성',
  },
  {
    product: bySlug.get('whitening-cream'),
    lane: '기능성 전환',
    reason: '미백 기능성 고시, 200ml 용량, 톤 케어 메시지가 명확하다.',
    action: '기능성 근거와 제조 신선도 배지를 구매 CTA 근처로 이동',
  },
  {
    product: bySlug.get('all-in-one-lotion'),
    lane: '남성 타깃',
    reason: '미백 및 주름개선 이중기능성으로 남성 간편 루틴을 만들 수 있다.',
    action: '네이버 노출 확인 후 면도 후 올인원 소재 테스트',
  },
].filter((item) => item.product);

const workLinks = [
  {
    href: '/product-comparison/',
    label: '제품/성분 비교표',
    meta: '8 SKU 데이터',
    text: '가격, 채널, 전성분, 성분 역할, 표현 주의사항을 비교합니다.',
  },
  {
    href: '/competitor-comparison/',
    label: '타사 제품 비교',
    meta: '쿠팡 경쟁군',
    text: '리뷰와 월 구매 신호가 큰 유사 상품을 기준으로 가격, 단가, 대응 전략을 봅니다.',
  },
  {
    href: '/coupang-mock/',
    label: '상세 이미지 분석',
    meta: '쿠팡 아카이브',
    text: '상품별 상세 이미지 흐름과 자사몰 재구성 포인트를 봅니다.',
  },
];

const conceptLinks = [
  { href: '/shop-concept/', label: 'Natural Premium', text: '제품 중심 브랜드 대표안' },
  { href: '/shop-clinical/', label: 'Fresh Chain', text: '성분과 제조 신뢰 중심' },
  { href: '/shop-luxury/', label: 'Clean Beauty', text: '미니멀 성분 투명성' },
  { href: '/shop-editorial/', label: 'Lifestyle', text: '자연주의 콘텐츠형' },
];

const campaignRows = [
  {
    stage: '검색 유입',
    product: '히알루론산 토너, 아쿠아 로션',
    message: '대용량 수분 루틴, 500ml 토너와 300ml 로션의 가격 효율을 전면에 둔다.',
    next: '수분, 대용량, 스킨팩, 무향 키워드 광고 문안 3종',
  },
  {
    stage: '문제 인식',
    product: '클렌징 오일, 클렌징 젤',
    message: '선크림, 피지, 아침 세안, 약산성 검색 의도를 분리해 세안 루틴으로 묶는다.',
    next: '1차 오일 세안과 2차 젤 세안 비교 상세 섹션',
  },
  {
    stage: '전환 설득',
    product: '화이트닝 톤 케어 크림',
    message: '미백 기능성, 나이아신아마이드, 200ml 용량, 제조 신선도를 구매 근거로 압축한다.',
    next: 'CTA 상단 기능성 근거 배지와 전성분 요약',
  },
  {
    stage: '타깃 확장',
    product: '영거 댄 올인원, 모이스춰 립밤',
    message: '남성 간편 루틴과 휴대용 립케어로 객단가 보조 상품을 만든다.',
    next: '네이버 미노출 상품 등록 상태 확인',
  },
];

const actionItems = [
  '화이트닝 톤 케어 크림 상세 첫 화면을 기능성 근거 중심으로 재배치',
  '히알루론산 토너와 아쿠아 로션을 수분 루틴 세트로 묶는 광고 소재 제작',
  '클렌징 오일과 클렌징 젤은 모공 세정, 약산성 키워드로 분리 테스트',
  '네이버 미노출 상품 2개, 영거 댄 올인원과 립밤의 등록 상태 재확인',
];

const complianceNotes = [
  '미백, 주름개선 표현은 고시된 기능성 상품에만 사용한다.',
  '블랙헤드 제거 단정 대신 블랙헤드가 신경 쓰이는 부위의 세정 관리로 쓴다.',
  'PDRN, 발효, 글루타티온은 원료 컨셉으로 설명하고 개선 효과를 단정하지 않는다.',
  '립밤은 비즈왁스 포함 제품이라 비건 표현을 쓰지 않는다.',
];
---

<BaseLayout title="유어스킨플러스 마케팅 대시보드" description="유어스킨플러스 제품 판매를 위한 마케팅 운영 대시보드">
  <main class="marketing-dashboard">
    <aside class="side-rail" aria-label="작업 메뉴">
      <a class="brand-lockup" href="/">
        <img src="/yourskin-logo-header-v18.png" alt="YOURSKIN+" />
        <span>Marketing Command</span>
      </a>

      <section class="rail-block">
        <p class="rail-label">현재 기준</p>
        <strong>{generatedLabel}</strong>
        <span>{products.length}개 상품, 쿠팡 상세 기준 데이터</span>
      </section>

      <nav class="work-nav" aria-label="분석 화면 링크">
        {workLinks.map((link) => (
          <a href={link.href}>
            <span>{link.label}</span>
            <small>{link.meta}</small>
          </a>
        ))}
      </nav>

      <section class="rail-block compact">
        <p class="rail-label">자사몰 목업 시안</p>
        <div class="concept-nav">
          {conceptLinks.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <small>{link.text}</small>
            </a>
          ))}
        </div>
      </section>
    </aside>

    <section class="workspace">
      <header class="masthead">
        <div>
          <p class="eyebrow">Yourskin+ sales operation</p>
          <h1>유어스킨플러스를 더 잘 팔기 위한 마케팅 대시보드</h1>
          <p class="lead">
            이 화면은 상품 분석 보고서가 아니라 실행 보드입니다. 수집한 8개 상품 데이터를 바탕으로 어떤 상품을 먼저 밀고, 어떤 상세 페이지와 광고 소재를 고도화할지 한눈에 관리합니다.
          </p>
        </div>
        <div class="focus-card">
          <span>이번 주 집중</span>
          <strong>수분 루틴으로 유입, 기능성 크림으로 전환</strong>
          <p>토너와 로션은 광고 유입용, 화이트닝 톤 케어 크림과 올인원은 기능성 근거를 구매 결심 영역에 배치합니다.</p>
        </div>
      </header>

      <section class="metric-grid" aria-label="핵심 지표">
        <article>
          <span>운영 상품</span>
          <strong>{products.length}개</strong>
          <small>쿠팡 기준 전체 라인업</small>
        </article>
        <article>
          <span>쿠팡 리뷰</span>
          <strong>{totalReviews.toLocaleString('ko-KR')}개</strong>
          <small>상세 저장일 기준 합계</small>
        </article>
        <article>
          <span>평균 판매가</span>
          <strong>{formatWon(averagePrice)}</strong>
          <small>저가 진입 장벽 낮음</small>
        </article>
        <article>
          <span>기능성 상품</span>
          <strong>{functionalProducts.length}개</strong>
          <small>{functionalProducts.map((product) => product.shortName).join(', ')}</small>
        </article>
        <article>
          <span>최저 단가</span>
          <strong>{lowestUnit.shortName}</strong>
          <small>{formatWon(lowestUnit.price.unitPrice)} / {lowestUnit.price.unitBasis}</small>
        </article>
        <article>
          <span>네이버 확인</span>
          <strong>{naverReadyProducts.length}/{products.length}개</strong>
          <small>올인원, 립밤 추가 확인 필요</small>
        </article>
      </section>

      <section class="dashboard-grid">
        <article class="panel action-panel">
          <div class="panel-heading">
            <p class="eyebrow">Action queue</p>
            <h2>오늘 바로 볼 작업</h2>
          </div>
          <ol class="action-list">
            {actionItems.map((item, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </li>
            ))}
          </ol>
        </article>

        <article class="panel priority-panel">
          <div class="panel-heading">
            <p class="eyebrow">SKU priority</p>
            <h2>먼저 밀 상품</h2>
          </div>
          <div class="priority-list">
            {priorityProducts.map(({ product, lane, reason, action }, index) => (
              <a class="priority-item" href="/product-comparison/">
                <img src={product.assets.thumbnail} alt={`${product.shortName} 대표 이미지`} loading="lazy" />
                <div>
                  <span>{String(index + 1).padStart(2, '0')} · {lane}</span>
                  <strong>{product.shortName}</strong>
                  <p>{reason}</p>
                  <small>{action}</small>
                </div>
              </a>
            ))}
          </div>
        </article>
      </section>

      <section class="panel campaign-panel">
        <div class="panel-heading wide-heading">
          <div>
            <p class="eyebrow">Campaign map</p>
            <h2>판매 퍼널별 메시지</h2>
          </div>
          <a href="/coupang-mock/">상세 이미지 분석으로 이동</a>
        </div>
        <div class="campaign-table-wrap">
          <table class="campaign-table">
            <colgroup>
              <col class="stage-col" />
              <col class="product-col" />
              <col class="message-col" />
              <col class="next-col" />
            </colgroup>
            <thead>
              <tr>
                <th>퍼널</th>
                <th>상품</th>
                <th>핵심 메시지</th>
                <th>다음 작업</th>
              </tr>
            </thead>
            <tbody>
              {campaignRows.map((row) => (
                <tr>
                  <td>{row.stage}</td>
                  <td>{row.product}</td>
                  <td>{row.message}</td>
                  <td>{row.next}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="workspace-row">
        <article class="panel link-panel">
          <div class="panel-heading">
            <p class="eyebrow">Analysis library</p>
            <h2>부속 분석 화면</h2>
          </div>
          <div class="analysis-links">
            {workLinks.map((link) => (
              <a href={link.href}>
                <span>{link.label}</span>
                <p>{link.text}</p>
              </a>
            ))}
          </div>
        </article>

        <article class="panel compliance-panel">
          <div class="panel-heading">
            <p class="eyebrow">Copy guardrail</p>
            <h2>표현 주의</h2>
          </div>
          <ul>
            {complianceNotes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </article>
      </section>

      <section class="panel lineup-panel">
        <div class="panel-heading wide-heading">
          <div>
            <p class="eyebrow">Product lineup</p>
            <h2>8개 상품 라인업</h2>
          </div>
          <a href="/product-comparison/">전체 비교표 보기</a>
        </div>
        <div class="lineup-grid">
          {products.map((product) => (
            <article class="sku-card">
              <img src={product.assets.thumbnail} alt={`${product.shortName} 대표 이미지`} loading="lazy" />
              <div>
                <span>{product.category}</span>
                <h3>{product.shortName}</h3>
                <p>{product.positioning.oneLine}</p>
                <dl>
                  <div>
                    <dt>판매가</dt>
                    <dd>{formatWon(product.price.sale)}</dd>
                  </div>
                  <div>
                    <dt>리뷰</dt>
                    <dd>{product.rating.coupangReviews}개</dd>
                  </div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #eff3ed;
  }

  .marketing-dashboard {
    --ink: #17221d;
    --muted: #65736a;
    --paper: #f8faf5;
    --panel: #ffffff;
    --line: #dbe2d8;
    --green: #254d3e;
    --green-2: #dceade;
    --coral: #c9684d;
    --amber: #e7b95d;
    --blue: #376e83;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 304px minmax(0, 1fr);
    background:
      linear-gradient(90deg, rgba(19, 34, 29, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(19, 34, 29, 0.035) 1px, transparent 1px),
      #eff3ed;
    background-size: 36px 36px;
    color: var(--ink);
    font-family: var(--font-body);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .side-rail {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 22px;
    overflow-y: auto;
    background: #122620;
    color: #f5f1e9;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .brand-lockup {
    display: grid;
    gap: 12px;
  }

  .brand-lockup img {
    width: 168px;
    max-width: 100%;
    height: auto;
    padding: 10px 12px;
    background: #f7f5ee;
    border-radius: 6px;
  }

  .brand-lockup span {
    color: #aab9ae;
    font-family: var(--font-latin);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .rail-block {
    display: grid;
    gap: 8px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
  }

  .rail-block strong {
    font-size: 22px;
  }

  .rail-block span,
  .rail-block small {
    color: #c9d5cd;
    font-size: 13px;
    line-height: 1.55;
  }

  .rail-label,
  .eyebrow {
    margin: 0;
    color: var(--coral);
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .work-nav,
  .concept-nav {
    display: grid;
    gap: 8px;
  }

  .work-nav a,
  .concept-nav a {
    display: grid;
    gap: 4px;
    padding: 13px 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.045);
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .work-nav a:hover,
  .concept-nav a:hover {
    transform: translateX(2px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .work-nav span,
  .concept-nav span {
    font-size: 14px;
    font-weight: 800;
  }

  .work-nav small,
  .concept-nav small {
    color: #b6c5bd;
    font-size: 12px;
    line-height: 1.45;
  }

  .workspace {
    min-width: 0;
    padding: 34px;
  }

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 24px;
    align-items: stretch;
    margin-bottom: 22px;
  }

  .masthead h1 {
    max-width: 900px;
    margin: 8px 0 14px;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.05;
    letter-spacing: 0;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .lead {
    max-width: 820px;
    margin: 0;
    color: #4f5c54;
    font-size: 16px;
    line-height: 1.75;
    word-break: keep-all;
  }

  .focus-card,
  .panel,
  .metric-grid article {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 45px rgba(26, 39, 32, 0.08);
  }

  .focus-card {
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 24px;
    border-top: 5px solid var(--coral);
  }

  .focus-card span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .focus-card strong {
    font-size: 26px;
    line-height: 1.22;
    word-break: keep-all;
  }

  .focus-card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    word-break: keep-all;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 22px;
  }

  .metric-grid article {
    min-height: 132px;
    display: grid;
    align-content: space-between;
    gap: 10px;
    padding: 18px;
  }

  .metric-grid span,
  .sku-card span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .metric-grid strong {
    font-family: var(--font-latin);
    font-size: 28px;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .metric-grid small {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .dashboard-grid,
  .workspace-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .panel {
    padding: 22px;
  }

  .panel-heading {
    display: flex;
    justify-content: space-between;
