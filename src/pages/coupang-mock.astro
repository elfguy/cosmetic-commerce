---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import coupangData from '../../data/coupang/downloaded-products.json';
import { products as opsProducts } from '../data/marketingOps';

const opsByProductId = new Map(opsProducts.map((product) => [String(product.productId), product]));
const products = coupangData.products.map((product) => ({
  ...product,
  ops: opsByProductId.get(String(product.productId)),
}));
const activeProduct = products.find((product) => product.productId === '9025733014') ?? products[0];
---

<BaseLayout title="쿠팡 원본 상세 검토실" description="쿠팡에 등록된 원본 상세 이미지 흐름을 보고 상품상세 개선 작업으로 연결">
  <SiteHeader active="" />

  <main class="source-review">
    <section class="hero container">
      <div>
        <p class="eyebrow">Coupang source review</p>
        <h1>원본 상세 이미지를 보고 개선 작업으로 바로 연결</h1>
        <p class="lead">쿠팡 OpenAPI로 수집한 원본 상세 이미지를 제품별로 확인합니다. 목적은 예쁘게 보는 것이 아니라 첫 3컷, 근거 배치, 금지 표현을 찾아 개선 작업실로 넘기는 것입니다.</p>
      </div>
      <div class="hero-card">
        <span>수집 상품</span>
        <strong>{products.length}개</strong>
        <small>{coupangData.source}</small>
      </div>
    </section>

    <section class="review-grid container">
      <aside class="product-list">
        {products.map((product) => (
          <a class:list={['source-item', product.productId === activeProduct.productId && 'is-active']} href={'#product-' + product.productId}>
            <img src={product.detailImages?.[0]?.src ?? product.images?.[0]} alt={product.name + ' 이미지'} loading="lazy" />
            <span>
              <strong>{product.ops?.shortName ?? product.name.replace('유어스킨플러스 ', '')}</strong>
              <small>{product.detailImages?.length ?? 0}장 · {product.ops?.ops.detailStatus ?? product.availability}</small>
            </span>
          </a>
        ))}
      </aside>

      <section class="source-products">
        {products.map((product) => (
          <article id={'product-' + product.productId} class="source-card">
            <div class="source-head">
              <div>
                <p class="eyebrow">{product.category}</p>
                <h2>{product.ops?.shortName ?? product.name}</h2>
                <p>{product.ops?.ops.nextAction ?? '상세 이미지와 고시정보를 확인해 개선 작업으로 연결합니다.'}</p>
              </div>
              <dl>
                <div><dt>상세 이미지</dt><dd>{product.detailImages?.length ?? 0}장</dd></div>
                <div><dt>가격</dt><dd>{Number(product.price || 0).toLocaleString('ko-KR')}원</dd></div>
                <div><dt>리스크</dt><dd>{product.ops?.ops.claimRisk ?? '확인'}</dd></div>
              </dl>
            </div>

            <div class="action-row">
              {product.ops ? <a href={'/products/' + product.ops.slug + '/'}>상품상세</a> : null}
              <a href={product.url} target="_blank" rel="noreferrer">쿠팡 원본</a>
            </div>

            <div class="detail-strip">
              {(product.detailImages ?? []).slice(0, 8).map((image, index) => (
                <figure>
                  <img src={image.src} alt={product.name + ' 상세 ' + String(index + 1)} loading="lazy" />
                  <figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
                </figure>
              ))}
            </div>
          </article>
        ))}
      </section>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .source-review { color: var(--ink); }
  .source-review a { color: inherit; text-decoration: none; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: end;
    padding-block: clamp(28px, 5vw, 56px) clamp(18px, 3vw, 28px);
  }
  .hero h1 { max-width: 940px; margin: 10px 0; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.06; letter-spacing: -0.02em; }
  .hero .lead { max-width: 64ch; margin: 0; color: var(--muted); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.65; }
  .hero-card {
    display: grid; align-content: end; gap: 6px;
    padding: 22px; border-radius: var(--r);
    background: var(--forest); color: #f4efe4; box-shadow: var(--shadow);
  }
  .hero-card span, .hero-card small { color: var(--forest-soft); font-size: 13px; }
  .hero-card strong { font-size: 40px; line-height: 1; }

  .review-grid {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 18px;
    padding-bottom: clamp(28px, 5vw, 52px);
  }
  .product-list {
    position: sticky; top: 82px; align-self: start;
    max-height: calc(100vh - 104px); overflow-y: auto;
    display: grid; gap: 8px; padding: 10px;
    border: 1px solid var(--line); border-radius: var(--r);
    background: var(--surface); box-shadow: var(--shadow-sm);
  }
  .source-item {
    display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 10px; align-items: center;
    padding: 8px; border-radius: var(--r-sm); background: var(--surface);
    border: 1px solid transparent;
  }
  .source-item.is-active { border-color: var(--accent); background: var(--accent-soft); }
  .source-item img { width: 56px; height: 56px; object-fit: cover; border-radius: var(--r-sm); background: var(--surface-3); }
  .source-item span { display: grid; gap: 4px; min-width: 0; }
  .source-item strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .source-item small { overflow: hidden; color: var(--muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }

  .source-products { display: grid; gap: 18px; min-width: 0; }
  .source-card {
    padding: 22px;
    border: 1px solid var(--line); border-radius: var(--r);
    background: var(--surface); box-shadow: var(--shadow-sm);
  }
  .source-head { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; }
  .source-card h2 { margin: 5px 0 8px; font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -0.01em; }
  .source-head p:not(.eyebrow) { margin: 0; color: var(--muted); line-height: 1.6; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  dl div { padding: 12px; border-radius: var(--r-sm); background: var(--surface-3); }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 4px 0 0; font-weight: 900; }
  .action-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
  .action-row a { padding: 9px 13px; border-radius: var(--r-pill); background: var(--forest); color: #f7f3e9; font-size: 13px; font-weight: 700; }
  .detail-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  figure { overflow: hidden; margin: 0; border: 1px solid var(--line); border-radius: var(--r-sm); background: var(--surface); }
  figure img { display: block; width: 100%; max-width: 100%; aspect-ratio: 780 / 1360; object-fit: cover; object-position: top; }
  figcaption { padding: 7px 9px; color: var(--muted); font-size: 12px; font-weight: 800; }

  @media (max-width: 1050px) {
    .hero, .review-grid, .source-head { grid-template-columns: 1fr; }
    .product-list {
      position: static; max-height: none;
      grid-auto-flow: column; grid-auto-columns: minmax(240px, 1fr);
      overflow-x: auto; overflow-y: hidden;
    }
    .detail-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .hero { gap: 14px; }
    .hero h1 { font-size: clamp(28px, 8vw, 32px); line-height: 1.08; }
    .review-grid { gap: 14px; }
    .product-list { grid-auto-columns: minmax(220px, 82vw); }
    .source-card { padding: 16px; }
    dl { grid-template-columns: 1fr; }
    .detail-strip { grid-template-columns: 1fr 1fr; }
  }
</style>
