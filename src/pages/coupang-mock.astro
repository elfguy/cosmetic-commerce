---
import BaseLayout from '../layouts/BaseLayout.astro';
import coupangData from '../../data/coupang/downloaded-products.json';
import { products as opsProducts } from '../data/marketingOps';

const opsByProductId = new Map(opsProducts.map((product) => [String(product.productId), product]));
const products = coupangData.products.map((product) => ({
  ...product,
  ops: opsByProductId.get(String(product.productId)),
}));
const activeProduct = products.find((product) => product.productId === '9025733014') ?? products[0];
---

<BaseLayout title="쿠팡 원본 상세 검토실" description="쿠팡에 등록된 원본 상세 이미지 흐름을 보고 상품상세 개선 작업으로 연결">
  <main class="source-review">
    <header class="topbar">
      <a href="/" class="brand"><img src="/yourskin-logo-header-v15.svg" alt="YOURSKIN+" /></a>
      <nav>
        <a href="/">대시보드</a>
        <a href="/products/">상품상세</a>
        <a href="/competitor-comparison/">경쟁상품</a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <p class="eyebrow">Coupang source review</p>
        <h1>원본 상세 이미지를 보고 개선 작업으로 바로 연결</h1>
        <p>쿠팡 OpenAPI로 수집한 원본 상세 이미지를 제품별로 확인합니다. 목적은 예쁘게 보는 것이 아니라 첫 3컷, 근거 배치, 금지 표현을 찾아 개선 작업실로 넘기는 것입니다.</p>
      </div>
      <div class="hero-card">
        <span>수집 상품</span>
        <strong>{products.length}개</strong>
        <small>{coupangData.source}</small>
      </div>
    </section>

    <section class="review-grid">
      <aside class="product-list">
        {products.map((product) => (
          <a class:list={['source-item', product.productId === activeProduct.productId && 'is-active']} href={'#product-' + product.productId}>
            <img src={product.detailImages?.[0]?.src ?? product.images?.[0]} alt={product.name + ' 이미지'} loading="lazy" />
            <span>
              <strong>{product.ops?.shortName ?? product.name.replace('유어스킨플러스 ', '')}</strong>
              <small>{product.detailImages?.length ?? 0}장 · {product.ops?.ops.detailStatus ?? product.availability}</small>
            </span>
          </a>
        ))}
      </aside>

      <section class="source-products">
        {products.map((product) => (
          <article id={'product-' + product.productId} class="source-card">
            <div class="source-head">
              <div>
                <p class="eyebrow">{product.category}</p>
                <h2>{product.ops?.shortName ?? product.name}</h2>
                <p>{product.ops?.ops.nextAction ?? '상세 이미지와 고시정보를 확인해 개선 작업으로 연결합니다.'}</p>
              </div>
              <dl>
                <div><dt>상세 이미지</dt><dd>{product.detailImages?.length ?? 0}장</dd></div>
                <div><dt>가격</dt><dd>{Number(product.price || 0).toLocaleString('ko-KR')}원</dd></div>
                <div><dt>리스크</dt><dd>{product.ops?.ops.claimRisk ?? '확인'}</dd></div>
              </dl>
            </div>

            <div class="action-row">
              {product.ops ? <a href={'/products/' + product.ops.slug + '/'}>상품상세</a> : null}
              <a href={product.url} target="_blank" rel="noreferrer">쿠팡 원본</a>
            </div>

            <div class="detail-strip">
              {(product.detailImages ?? []).slice(0, 8).map((image, index) => (
                <figure>
                  <img src={image.src} alt={product.name + ' 상세 ' + String(index + 1)} loading="lazy" />
                  <figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
                </figure>
              ))}
            </div>
          </article>
        ))}
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background:#eef1ec; }
  .source-review { --ink:#17211d; --muted:#68766f; --line:#d8e0d6; --paper:#fbfcf8; --dark:#12251f; --accent:#c76045; min-height:100vh; color:var(--ink); background:#eef1ec; font-family:var(--font-body); }
  a { color:inherit; text-decoration:none; }
  .topbar { position:sticky; top:0; z-index:10; display:flex; justify-content:space-between; align-items:center; gap:14px; padding:12px 22px; border-bottom:1px solid var(--line); background:rgba(238,241,236,.94); backdrop-filter:blur(12px); }
  .brand img { width:146px; padding:8px 10px; border-radius:6px; background:#f8f4ea; }
  nav { display:flex; flex-wrap:wrap; gap:8px; }
  nav a, .action-row a { padding:9px 12px; border-radius:999px; background:var(--dark); color:#fffaf0; font-size:13px; font-weight:800; }
  .hero { display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:18px; padding:26px 22px 18px; }
  .eyebrow { margin:0; color:var(--accent); font-family:var(--font-latin); font-size:11px; font-weight:800; text-transform:uppercase; }
  .hero h1 { max-width:940px; margin:8px 0 10px; font-size:clamp(38px,5vw,68px); line-height:1; letter-spacing:0; }
  .hero p:not(.eyebrow) { max-width:780px; margin:0; color:var(--muted); font-size:17px; line-height:1.65; }
  .hero-card, .product-list, .source-card { border:1px solid var(--line); border-radius:8px; background:var(--paper); box-shadow:0 14px 44px rgba(21,34,28,.08); }
  .hero-card { display:grid; align-content:end; gap:8px; padding:20px; background:var(--dark); color:#fffaf0; }
  .hero-card span, .hero-card small { color:#c7d5cd; }
  .hero-card strong { font-size:38px; }
  .review-grid { display:grid; grid-template-columns:320px minmax(0,1fr); gap:18px; padding:0 22px 24px; }
  .product-list { position:sticky; top:82px; align-self:start; max-height:calc(100vh - 104px); overflow-y:auto; display:grid; gap:8px; padding:10px; }
  .source-item { display:grid; grid-template-columns:56px minmax(0,1fr); gap:10px; align-items:center; padding:8px; border-radius:8px; background:#fff; border:1px solid transparent; }
  .source-item.is-active { border-color:var(--accent); background:#fff6f1; }
  .source-item img { width:56px; height:56px; object-fit:cover; border-radius:6px; background:#eef1ec; }
  .source-item span { display:grid; gap:4px; min-width:0; }
  .source-item strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .source-item small { overflow:hidden; color:var(--muted); font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
  .source-products { display:grid; gap:18px; }
  .source-card { padding:20px; }
  .source-head { display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:18px; }
  h2 { margin:5px 0 8px; font-size:30px; letter-spacing:0; }
  .source-head p:not(.eyebrow) { margin:0; color:var(--muted); line-height:1.6; }
  dl { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:0; }
  dl div { padding:12px; border-radius:8px; background:#f2f6f1; }
  dt { color:var(--muted); font-size:12px; }
  dd { margin:4px 0 0; font-weight:900; }
  .action-row { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
  .detail-strip { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
  figure { overflow:hidden; margin:0; border:1px solid var(--line); border-radius:8px; background:#fff; }
  figure img { display:block; width:100%; aspect-ratio:780 / 1360; object-fit:cover; object-position:top; }
  figcaption { padding:7px 9px; color:var(--muted); font-size:12px; font-weight:800; }
  @media (max-width:1050px) { .hero, .review-grid, .source-head { grid-template-columns:1fr; } .product-list { position:static; max-height:none; grid-auto-flow:column; grid-auto-columns:minmax(240px,1fr); overflow-x:auto; overflow-y:hidden; } .detail-strip { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:720px) { .topbar { align-items:flex-start; padding:10px 12px; } .brand img { width:118px; padding:6px 8px; } nav { flex-wrap:nowrap; overflow-x:auto; max-width:58vw; } nav a { flex:0 0 auto; padding:8px 10px; font-size:12px; } .hero { padding:18px 12px 12px; } .hero h1 { font-size:30px; line-height:1.08; } .hero p:not(.eyebrow) { font-size:15px; } .review-grid { padding:0 12px 18px; gap:14px; } .product-list { grid-auto-columns:minmax(220px,82vw); } .source-card { padding:15px; } h2 { font-size:23px; } dl { grid-template-columns:1fr; } .detail-strip { grid-template-columns:1fr 1fr; } }
</style>
