---
import BaseLayout from '../layouts/BaseLayout.astro';
import coupangData from '../../data/coupang/downloaded-products.json';

const defaultInsight = (product) => ({
  summary: `${product.category} 카테고리 검색 의도, 할인율, 리뷰 수, 상세 이미지 구성을 기준으로 후킹과 구매 근거를 재배치합니다.`,
  strategy: [
    `${product.category} 카테고리 검색 의도를 첫 화면 문장에 반영`,
    `${product.discountRate}% 할인과 ${product.reviewCount}개 리뷰를 구매 버튼 근처에 고정`,
    `상세 이미지 ${product.detailImages.length}장을 후킹, 성분 근거, 사용감, 구매 근거 순서로 분석`,
  ],
  auditTitle: `${product.name.replace('유어스킨플러스 ', '')} 상세 흐름`,
  auditLead: '저장된 상세 이미지를 후킹, 근거, 사용법, 구매 불안 해소 단계로 나누어 자사몰 상세페이지에 재배치합니다.',
  flow: [
    { label: 'Hook', range: '대표 이미지', text: '상품명과 카테고리 니즈를 첫 화면에서 바로 이해시키는 구조가 필요합니다.' },
    { label: 'Proof', range: '성분/효능 근거', text: '원료와 기능성 표현은 단정형 카피보다 확인 가능한 근거와 함께 배치합니다.' },
    { label: 'Routine', range: '사용법', text: '사용 시점, 사용 부위, 함께 쓰기 좋은 루틴을 짧게 정리합니다.' },
    { label: 'Trust', range: '구매 안심', text: '제조사, 배송, 교환, 공식 판매자 확인 정보를 구매 하단에 둡니다.' },
  ],
  strengths: ['가격과 용량을 한눈에 비교하기 쉽다', '상세 이미지 수가 충분해 설득 흐름을 만들 수 있다'],
  risks: ['상세 이미지 안의 강한 표현은 기능성 근거 확인 후 자사몰 카피로 재작성해야 한다'],
  nextActions: ['첫 화면 CTA 근처에 핵심 효능, 용량, 공식 판매자 신뢰 요소를 압축 배치한다'],
});

const insightByProductId = {
  '9264527939': {
    summary: '14장 상세 이미지는 자연스러운 톤 정리 후킹에서 미백 기능성, 비타민/글루타치온, Fresh Bud No.6, 저자극/EWG, 제조 신선도, 공식 판매자 경고까지 이어지는 풀 퍼널 구조입니다.',
    strategy: [
      '첫 화면은 자연스러운 톤 케어, 200ml 용량, 미백 기능성화장품 인증을 한 줄로 압축',
      '나이아신아마이드, 비타민 콤플렉스, 글루타치온, Fresh Bud No.6 근거는 원료 특성 표현으로 정리',
      '저자극 지수 0.00, EWG 그린, 제조 6개월 이내 보증은 구매 버튼 하단 신뢰 배지로 재배치',
    ],
    auditTitle: '화이트닝 톤 케어 크림 상세페이지 분석',
    auditLead: '현재 상세페이지는 근거가 많지만 메시지가 길게 흩어져 있습니다. 자사몰에서는 첫 화면을 간결하게 만들고, 인증/시험/제조 신뢰 요소를 접히지 않는 영역과 구매 CTA 주변에 모아야 합니다.',
    flow: [
      { label: '01 Hook', range: '1-3장', text: '제품컷, 추천 대상, 5대 포인트로 톤 케어 필요성을 빠르게 제시합니다. 다만 첫 화면의 핵심 문장은 더 짧게 압축할 여지가 있습니다.' },
      { label: '02 Functional Proof', range: '4-6장', text: '비타민 B3/B5, 글루타치온, 나이아신아마이드, 미백 기능성 고시를 중심으로 브라이트닝 근거를 제시합니다.' },
      { label: '03 Sensitive Skin Trust', range: '7-9장', text: 'Fresh Bud No.6, 저자극 지수 0.00, EWG 그린, 무향을 묶어 민감 피부 안심 근거로 구성합니다.' },
      { label: '04 Freshness and Use', range: '10-13장', text: '제조일자 표기, 제조 6개월 이내 출고, 사용법, 전성분, 고객센터 정보로 구매 불안을 줄입니다.' },
      { label: '05 Official Seller', range: '14장', text: '무단 리셀러 경고는 신뢰에는 도움이 되지만 구매 흐름을 끊을 수 있어 하단 안내 배너로 축소하는 편이 좋습니다.' },
    ],
    strengths: [
      '미백 기능성화장품 고시와 효능 문구가 이미지 안에 포함되어 상품 포지션이 명확함',
      '저자극 시험, EWG, 무향, 제조일자 공개, 직접 제조 판매까지 신뢰 소재가 풍부함',
      '200ml 대용량과 10,100원 가격이 데일리 톤 케어 제품으로 설득력이 있음',
    ],
    risks: [
      '강한 화이트닝 효과 표현은 원료 특성, 기능성 심사 범위, 시험 조건을 함께 보여줘야 함',
      '추천 대상 문장이 길고 중복되어 모바일 첫 화면에서는 핵심 가치가 늦게 보일 수 있음',
      '리셀러 경고 이미지는 자사몰 상세 최하단으로 보내고 구매 CTA 주변에는 공식 판매자 배지만 남기는 것이 좋음',
    ],
    nextActions: [
      '첫 화면: 자연 톤 케어, 미백 기능성, 200ml, 제조 6개월 이내를 4개 배지로 요약',
      '중간 영역: 미백 기능성, 저자극 0.00, EWG 그린, Fresh Bud No.6을 증거 카드로 재구성',
      '하단 영역: 사용법, 전성분, 고객센터, 공식 판매자 확인을 접히는 정보 블록으로 정리',
    ],
  },
};

const products = coupangData.products.map((product) => ({
  ...product,
  insight: insightByProductId[product.productId] || defaultInsight(product),
}));
const activeProduct = products.find((product) => product.productId === '9264527939') || products[0];
const totalReviews = products.reduce((sum, product) => sum + product.reviewCount, 0);
const averageDiscount = Math.round(products.reduce((sum, product) => sum + product.discountRate, 0) / products.length);
const bestValue = [...products].sort((a, b) => b.discountRate - a.discountRate)[0];
const formatPrice = (value) => `${Number(value).toLocaleString('ko-KR')}원`;
const formatBytes = (value) => Number(value) > 0 ? `${(Number(value) / 1024 / 1024).toFixed(1)}MB` : '미저장';
---

<BaseLayout title="쿠팡 상품 상세 분석 목업" description="쿠팡에서 확인한 유어스킨플러스 상품 8개를 기반으로 만든 상품 상세페이지 분석용 목업">
  <main class="coupang-workbench">
    <aside class="product-rail" aria-label="쿠팡 저장 상품 목록">
      <a class="brand-mark" href="/">
        <img src="/yourskin-logo-header-v18.png" alt="YOURSKIN+" />
      </a>
      <div class="rail-summary">
        <p>Coupang archive</p>
        <strong>{products.length}개 확인 상품</strong>
        <span>{coupangData.source}</span>
      </div>
      <nav class="rail-concept-links" aria-label="쇼핑몰 콘셉트 빠른 링크">
        <a href="/shop-concept">Premium</a>
        <a href="/shop-clinical">Fresh</a>
        <a href="/shop-luxury">Clean</a>
        <a href="/shop-editorial">Life</a>
      </nav>
      <nav class="product-list" aria-label="분석 상품 선택">
        {products.map((product, index) => (
          <button class:list={['product-button', product.slug === activeProduct.slug && 'is-active']} type="button" data-product={product.slug}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{product.name.replace('유어스킨플러스 ', '')}</strong>
            <em>{formatPrice(product.price)} · 리뷰 {product.reviewCount}</em>
          </button>
        ))}
      </nav>
    </aside>

    <section class="workspace">
      <header class="workbench-header">
        <div class="header-copy">
          <p>Product detail mockup</p>
          <h1>쿠팡 상품 상세 분석</h1>
          <span>Chrome에서 확인한 8개 상품을 기준으로 저장 상세 이미지와 구매 지표를 한 화면에서 검토합니다.</span>
        </div>
        <div class="header-metrics" aria-label="전체 상품 요약">
          <span><strong>{totalReviews}</strong> total reviews</span>
          <span><strong>{averageDiscount}%</strong> avg discount</span>
          <span><strong>{bestValue.discountRate}%</strong> top discount</span>
        </div>
      </header>

      <section class="concept-link-board" aria-label="자사몰 쇼핑몰 목업 시안 보기">
        <div>
          <p>Storefront concepts</p>
          <h2>상세 분석에서 바로 보는 자사몰 쇼핑몰 목업 시안</h2>
        </div>
        <div class="concept-links">
          <a href="/shop-concept">
            <span>01</span>
            <strong>Natural Premium</strong>
            <em>고급 천연 화장품 자사몰</em>
          </a>
          <a href="/shop-clinical">
            <span>02</span>
            <strong>Fresh Chain</strong>
            <em>산지에서 피부까지 유통 과정 시각화</em>
          </a>
          <a href="/shop-luxury">
            <span>03</span>
            <strong>Clean Beauty</strong>
            <em>미니멀 성분 투명성 중심 자사몰</em>
          </a>
          <a href="/shop-editorial">
            <span>04</span>
            <strong>Natural Lifestyle</strong>
            <em>따뜻한 자연주의 루틴 랜딩</em>
          </a>
        </div>
      </section>

      <section class="detail-stage">
        <div class="mock-product">
          <div class="image-column">
            <div class="hero-image">
              <img id="hero-image" src={activeProduct.detailImages[0].src} alt={`${activeProduct.name} 상세 이미지`} />
            </div>
            <div class="thumb-strip" id="thumb-strip">
              {activeProduct.detailImages.slice(0, 8).map((image, index) => (
                <button class:list={['thumb-button', index === 0 && 'is-active']} type="button" data-image={image.src}>
                  <img src={image.src} alt={`${activeProduct.name} 상세 이미지 ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} />
                </button>
              ))}
            </div>
          </div>

          <article class="buy-panel">
            <div class="breadcrumb" id="breadcrumb">{activeProduct.categories.join(' / ')}</div>
            <h2 id="product-name">{activeProduct.name}</h2>
            <p id="product-description">{activeProduct.description}</p>
            <div class="rating-row">
              <strong id="rating-value">★ {activeProduct.ratingValue.toFixed(1)}</strong>
              <span id="review-count">상품평 {activeProduct.reviewCount}개</span>
              <span id="stock-status">{activeProduct.availability}</span>
            </div>
            <div class="price-stack">
              <span id="original-price">{formatPrice(activeProduct.originalPrice)}</span>
              <div>
                <strong id="discount-rate">{activeProduct.discountRate}%</strong>
                <em id="sale-price">{formatPrice(activeProduct.price)}</em>
              </div>
            </div>
            <dl class="id-grid">
              <div><dt>Product ID</dt><dd id="product-id">{activeProduct.productId}</dd></div>
              <div><dt>Item ID</dt><dd id="item-id">{activeProduct.itemId}</dd></div>
              <div><dt>Detail images</dt><dd id="image-count">{activeProduct.detailImages.length}장</dd></div>
              <div><dt>HTML size</dt><dd id="file-size">{formatBytes(activeProduct.fileSize)}</dd></div>
            </dl>
            <div class="action-row">
              <a id="source-link" class="primary-action" href={activeProduct.url} target="_blank" rel="noreferrer">쿠팡 원본 URL</a>
              <a class="secondary-action" href="#analysis-board">분석 보드</a>
            </div>
          </article>
        </div>

        <aside id="analysis-board" class="analysis-board" aria-label="상세페이지 분석 보드">
          <div class="analysis-kicker">Conversion notes</div>
          <div class="score-block">
            <span>가격 매력도</span>
            <strong id="price-score">{activeProduct.discountRate >= 46 ? '강함' : '보통'}</strong>
            <meter id="discount-meter" min="0" max="60" value={activeProduct.discountRate}></meter>
          </div>
          <div class="score-block">
            <span>신뢰 지표</span>
            <strong id="trust-score">{activeProduct.reviewCount >= 30 ? '리뷰 우위' : '리뷰 보강 필요'}</strong>
            <meter id="review-meter" min="0" max="40" value={activeProduct.reviewCount}></meter>
          </div>
          <div class="analysis-copy">
            <h3>상세페이지 개선 방향</h3>
            <ol id="strategy-list">
              {activeProduct.insight.strategy.map((item) => <li>{item}</li>)}
            </ol>
          </div>
          <div class="file-note">
            <span>Saved source</span>
            <strong id="file-name">{activeProduct.fileName}</strong>
          </div>
        </aside>
      </section>

      <section class="detail-image-section" aria-label="쿠팡 상세 이미지 분석">
        <div class="section-heading">
          <p>Coupang detail images</p>
          <h2>확인된 상세/대표 이미지 흐름</h2>
        </div>
        <div class="detail-image-layout">
          <aside class="image-analysis">
            <strong id="detail-count">{activeProduct.detailImages.length}장</strong>
            <span>쿠팡 상세 이미지</span>
            <p id="detail-summary">{activeProduct.insight.summary}</p>
          </aside>
          <div class="detail-image-feed" id="detail-image-feed">
            {activeProduct.detailImages.map((image, index) => (
              <figure>
                <img src={image.src} alt={`${activeProduct.name} 상세 이미지 ${index + 1}`} loading={index < 2 ? 'eager' : 'lazy'} />
                <figcaption>
                  <strong>{String(index + 1).padStart(2, '0')}</strong>
                  <span>{image.width}x{image.height}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="content-audit-section" aria-label="상세페이지 구성 분석">
        <div class="section-heading">
          <p>Detail page audit</p>
          <h2 id="audit-title">{activeProduct.insight.auditTitle}</h2>
        </div>
        <p class="audit-lead" id="audit-lead">{activeProduct.insight.auditLead}</p>
        <div class="audit-grid" id="audit-grid">
          {activeProduct.insight.flow.map((item) => (
            <article>
              <span>{item.range}</span>
              <strong>{item.label}</strong>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <div class="audit-note-grid">
          <article>
            <span>Strength</span>
            <ul id="strength-list">
              {activeProduct.insight.strengths.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <span>Risk</span>
            <ul id="risk-list">
              {activeProduct.insight.risks.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <span>Redesign</span>
            <ul id="action-list">
              {activeProduct.insight.nextActions.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="comparison-section" aria-label="8개 상품 비교">
        <div class="section-heading">
          <p>Line-up comparison</p>
          <h2>가격, 리뷰, 이미지 구성 비교</h2>
        </div>
        <div class="comparison-table">
          <div class="table-row table-head">
            <span>상품</span>
            <span>카테고리</span>
            <span>판매가</span>
            <span>할인</span>
            <span>리뷰</span>
            <span>이미지</span>
          </div>
          {products.map((product) => (
            <button class:list={['table-row', product.slug === activeProduct.slug && 'is-active']} type="button" data-product={product.slug}>
              <span>{product.name.replace('유어스킨플러스 ', '')}</span>
              <span>{product.category}</span>
              <span>{formatPrice(product.price)}</span>
              <span>{product.discountRate}%</span>
              <span>{product.reviewCount}</span>
            <span>{product.detailImages.length}</span>
          </button>
        ))}
        </div>
      </section>
    </section>
  </main>

  <script type="application/json" id="coupang-products" set:html={JSON.stringify(products)} />
  <script is:inline>
    const products = JSON.parse(document.getElementById('coupang-products').textContent);
    const bySlug = new Map(products.map((product) => [product.slug, product]));
    const formatPrice = (value) => `${Number(value).toLocaleString('ko-KR')}원`;
    const formatBytes = (value) => Number(value) > 0 ? `${(Number(value) / 1024 / 1024).toFixed(1)}MB` : '미저장';
    const nodes = {
      heroImage: document.getElementById('hero-image'),
      thumbStrip: document.getElementById('thumb-strip'),
      detailCount: document.getElementById('detail-count'),
      detailSummary: document.getElementById('detail-summary'),
      detailFeed: document.getElementById('detail-image-feed'),
      auditTitle: document.getElementById('audit-title'),
      auditLead: document.getElementById('audit-lead'),
      auditGrid: document.getElementById('audit-grid'),
      strengthList: document.getElementById('strength-list'),
      riskList: document.getElementById('risk-list'),
      actionList: document.getElementById('action-list'),
      breadcrumb: document.getElementById('breadcrumb'),
      name: document.getElementById('product-name'),
      description: document.getElementById('product-description'),
      rating: document.getElementById('rating-value'),
      reviews: document.getElementById('review-count'),
      status: document.getElementById('stock-status'),
      originalPrice: document.getElementById('original-price'),
      discount: document.getElementById('discount-rate'),
      salePrice: document.getElementById('sale-price'),
      productId: document.getElementById('product-id'),
      itemId: document.getElementById('item-id'),
      imageCount: document.getElementById('image-count'),
      fileSize: document.getElementById('file-size'),
      sourceLink: document.getElementById('source-link'),
      priceScore: document.getElementById('price-score'),
      discountMeter: document.getElementById('discount-meter'),
      trustScore: document.getElementById('trust-score'),
      reviewMeter: document.getElementById('review-meter'),
      strategy: document.getElementById('strategy-list'),
      fileName: document.getElementById('file-name'),
    };

    const escapeHtml = (value) => String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

    function bindThumbnails() {
      document.querySelectorAll('.thumb-button').forEach((button) => {
        button.addEventListener('click', () => {
          nodes.heroImage.src = button.dataset.image;
          document.querySelectorAll('.thumb-button').forEach((item) => item.classList.toggle('is-active', item === button));
        });
      });
    }

    function render(product) {
      const detailImages = product.detailImages || [];
      nodes.heroImage.src = detailImages[0]?.src || product.images[0];
      nodes.heroImage.alt = `${product.name} 상세 이미지`;
      nodes.thumbStrip.innerHTML = detailImages.slice(0, 8).map((image, index) => `
        <button class="thumb-button ${index === 0 ? 'is-active' : ''}" type="button" data-image="${escapeHtml(image.src)}">
          <img src="${escapeHtml(image.src)}" alt="${escapeHtml(product.name)} 상세 이미지 ${index + 1}" loading="lazy" />
        </button>
      `).join('');
      nodes.breadcrumb.textContent = product.categories.join(' / ');
      nodes.name.textContent = product.name;
      nodes.description.textContent = product.description;
      nodes.rating.textContent = `★ ${Number(product.ratingValue).toFixed(1)}`;
      nodes.reviews.textContent = `상품평 ${Number(product.reviewCount).toLocaleString('ko-KR')}개`;
      nodes.status.textContent = product.availability;
      nodes.originalPrice.textContent = formatPrice(product.originalPrice);
      nodes.discount.textContent = `${product.discountRate}%`;
      nodes.salePrice.textContent = formatPrice(product.price);
      nodes.productId.textContent = product.productId;
      nodes.itemId.textContent = product.itemId;
      nodes.imageCount.textContent = `${detailImages.length}장`;
      nodes.fileSize.textContent = formatBytes(product.fileSize);
      nodes.sourceLink.href = product.url || '#';
      nodes.sourceLink.setAttribute('href', product.url || '#');
      nodes.priceScore.textContent = product.discountRate >= 46 ? '강함' : '보통';
      nodes.discountMeter.value = product.discountRate;
      nodes.trustScore.textContent = product.reviewCount >= 30 ? '리뷰 우위' : '리뷰 보강 필요';
      nodes.reviewMeter.value = product.reviewCount;
      nodes.strategy.innerHTML = product.insight.strategy.map((item) => `<li>${escapeHtml(item)}</li>`).join('');
      nodes.detailCount.textContent = `${detailImages.length}장`;
      nodes.detailSummary.textContent = product.insight.summary;
      nodes.detailFeed.innerHTML = detailImages.map((image, index) => `
        <figure>
          <img src="${escapeHtml(image.src)}" alt="${escapeHtml(product.name)} 상세 이미지 ${index + 1}" loading="lazy" />
          <figcaption>
            <strong>${String(index + 1).padStart(2, '0')}</strong>
            <span>${image.width}x${image.height}</span>
          </figcaption>
        </figure>
      `).join('');
      nodes.auditTitle.textContent = product.insight.auditTitle;
      nodes.auditLead.textContent = product.insight.auditLead;
      nodes.auditGrid.innerHTML = product.insight.flow.map((item) => `
        <article>
          <span>${escapeHtml(item.range)}</span>
          <strong>${escapeHtml(item.label)}</strong>
          <p>${escapeHtml(item.text)}</p>
        </article>
      `).join('');
      nodes.strengthList.innerHTML = product.insight.strengths.map((item) => `<li>${escapeHtml(item)}</li>`).join('');
      nodes.riskList.innerHTML = product.insight.risks.map((item) => `<li>${escapeHtml(item)}</li>`).join('');
      nodes.actionList.innerHTML = product.insight.nextActions.map((item) => `<li>${escapeHtml(item)}</li>`).join('');
      nodes.fileName.textContent = product.fileName;
      document.querySelectorAll('[data-product]').forEach((button) => {
        button.classList.toggle('is-active', button.dataset.product === product.slug);
      });
      bindThumbnails();
    }

    document.querySelectorAll('[data-product]').forEach((button) => {
      button.addEventListener('click', () => {
        const product = bySlug.get(button.dataset.product);
        if (product) render(product);
      });
    });

    bindThumbnails();
  </script>
</BaseLayout>

