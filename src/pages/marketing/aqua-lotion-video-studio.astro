---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { campaignModels, archivedModels, campaignVideos, productionGates, sceneAttempts } from '../../data/aquaLotionVideoStudio';

const statusLabel = {
  concept: '콘티 작성', casting: '캐스팅', producing: '제작 중', review: '검수', approved: '승인', published: '게시', archived: '보관',
} as const;
const attemptStatusLabel = {
  reference: '기준 이미지', pending: '생성 중', review: '검수 대기', selected: '선정', rejected: '탈락',
} as const;
const firstVideo = campaignVideos[0];
const storySketches = [
  { src: '/marketing/aqua-lotion-video-studio/storyboards-30s/01-problem-silent.webp', label: '0–7초 · 말 없는 문제 인식', desc: '모델은 입을 닫고 거울과 토너·크림 사이에서 망설임만 연기' },
  { src: '/marketing/aqua-lotion-video-studio/storyboards-30s/02-solution-product.webp', label: '7–15초 · 제품이 해결책으로 등장', desc: '나레이션 위에 실제 제품과 손의 접근을 분리해 보여줌' },
  { src: '/marketing/aqua-lotion-video-studio/storyboards-30s/03-proof-details.webp', label: '15–23초 · 제품 정보와 근거', desc: '펌프·투명 용기·8종 히알루론산을 제품 중심으로 설명' },
  { src: '/marketing/aqua-lotion-video-studio/storyboards-30s/04-finish-cta.webp', label: '23–30초 · 무언 결과와 CTA', desc: '모델은 조용히 루틴을 마치고 움직이는 제품 컷으로 종료' },
];
---

<BaseLayout title="아쿠아 로션 영상 스튜디오" description="유어스킨플러스 아쿠아 로션 광고 모델, 영상 버전, 콘티와 제작 게이트를 누적 관리하는 마케팅 영상 대시보드">
  <SiteHeader active="/marketing/aqua-lotion-video-studio/" />

  <main class="studio-page">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">Aqua lotion · moving image system</p>
        <h1>한 편을 만드는 페이지가 아니라<br /><em>계속 만드는 시스템</em></h1>
        <p>완성본을 한 번에 만들지 않고, 표정·제품 집기·펌핑·도포·마무리를 각각 생성해 비교합니다. 탈락본과 크레딧까지 남겨 같은 실패를 반복하지 않습니다.</p>
        <div class="hero-actions">
          <a href="#compare">V2 부분 비교 보기</a>
          <a class="ghost" href="#models">모델 프로필 보기</a>
        </div>
      </div>
      <div class="hero-board" aria-label="현재 제작 현황">
        <div class="board-top"><span>PRODUCTION BOARD</span><b>2026.08.01</b></div>
        <div class="board-main">
          <strong>AQUA-UGC-001</strong>
          <h2>가볍게 한 번 더</h2>
          <p>MODEL D · V2 / <b>AI 제품 사용 테스트 중단</b></p>
        </div>
        <dl>
          <div><dt>활성 모델</dt><dd>{campaignModels.length}</dd></div>
          <div><dt>비교 후보</dt><dd>{sceneAttempts.length}</dd></div>
          <div><dt>현재 단계</dt><dd>REAL SHOT</dd></div>
        </dl>
      </div>
    </section>

    <nav class="section-nav container" aria-label="페이지 목차">
      <a href="#compare">V2 부분 비교</a><a href="#models">모델</a><a href="#videos">영상 라이브러리</a><a href="#video-001">첫 콘티</a><a href="#gates">제작 게이트</a>
    </nav>

    <section class="attempt-section container" id="compare">
      <header class="section-head">
        <div><p class="eyebrow">V2 scene lab</p><h2>부분별 생성·탈락·선정 비교</h2></div>
        <p>좋아 보이는 결과만 숨기지 않고 실패본까지 같은 슬롯에 남깁니다. 모델·표정·손·제품·자막 중 하나라도 기준을 벗어나면 마스터에 사용하지 않습니다.</p>
      </header>
      <div class="attempt-summary">
        <div><span>등록 시도</span><b>{sceneAttempts.length}</b></div>
        <div><span>기준 이미지</span><b>{sceneAttempts.filter((item) => item.status === 'reference').length}</b></div>
        <div><span>자동 탈락</span><b>{sceneAttempts.filter((item) => item.status === 'rejected').length}</b></div>
        <div><span>V2 사용</span><b>109</b><small>credits</small></div>
      </div>
      <div class="attempt-grid">
        {sceneAttempts.map((attempt) => (
          <article class:list={['attempt-card', attempt.status]}>
            <div class="attempt-media">
              {attempt.videoSrc
                ? <video controls preload="metadata" poster={attempt.poster}><source src={attempt.videoSrc} type="video/mp4" /></video>
                : attempt.poster && <img src={attempt.poster} alt={`${attempt.title} 비교 이미지`} loading="eager" />}
              <span class="attempt-scene">{attempt.scene}</span>
              <b class="attempt-status">{attemptStatusLabel[attempt.status]}</b>
            </div>
            <div class="attempt-copy">
              <div class="attempt-id"><span>{attempt.id}</span><b>{attempt.creditCost}</b></div>
              <h3>{attempt.title}</h3>
              <p>{attempt.summary}</p>
              <dl><div><dt>생성 방식</dt><dd>{attempt.model}</dd></div>{attempt.duration && <div><dt>길이</dt><dd>{attempt.duration}</dd></div>}</dl>
              <ul>{attempt.issues.map((issue) => <li>{issue}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="models-section container" id="models">
      <header class="section-head">
        <div><p class="eyebrow">Cast registry</p><h2>모델 정체성 보드</h2></div>
        <p>키·몸무게·직업은 실존 인물 추정이 아니라 Soul ID 일관성을 위한 가상 제작 설정입니다.</p>
      </header>

      <div class="model-grid">
        {campaignModels.map((model) => (
          <article class="model-card">
            <div class="model-visual">
              <img src={model.image} alt={`${model.name} 전신 모델 이미지`} />
              <span class="model-code">{model.code}</span>
              <span class:list={['status', model.status]}>{model.status === 'selected' ? 'SELECTED' : 'ACTIVE'}</span>
            </div>
            <div class="model-copy">
              <p class="role">{model.role}</p>
              <h3>{model.name}</h3>
              <div class="measure"><b>{model.age}세</b><span>{model.heightCm}cm</span><span>{model.weightKg}kg</span></div>
              <p class="styling">{model.styling}</p>
              <dl>
                <div><dt>설정 직업</dt><dd>{model.job}</dd></div>
                <div><dt>말투</dt><dd>{model.voice}</dd></div>
                <div><dt>성격</dt><dd>{model.personality}</dd></div>
              </dl>
              <blockquote>“{model.hook}”</blockquote>
              <div class="signal-grid">
                <div><b>강점</b>{model.strengths.map((item) => <span>{item}</span>)}</div>
                <div class="risk"><b>주의</b>{model.risks.map((item) => <span>{item}</span>)}</div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <details class="archive">
        <summary><span>탈락·보관 모델</span><b>{archivedModels.length}명</b></summary>
        {archivedModels.map((model) => (
          <div class="archive-row">
            <img src={model.image} alt="" loading="lazy" />
            <div><small>{model.code} · ARCHIVED</small><h3>{model.name}</h3><p>{model.role}</p></div>
            <strong>사용자 검토에서 탈락 · 이후 Soul ID와 광고에 사용하지 않음</strong>
          </div>
        ))}
      </details>
    </section>

    <section class="library-section" id="videos">
      <div class="container">
        <header class="section-head light">
          <div><p class="eyebrow">Campaign library</p><h2>영상이 늘어나도 같은 구조로 관리</h2></div>
          <p>각 영상은 고유 ID, 모델, 훅, 상태, 콘티, 미리보기와 최종 파일을 가집니다. 새 항목을 추가하면 이 라이브러리에 자동으로 카드가 생성됩니다.</p>
        </header>

        <div class="video-grid">
          {campaignVideos.map((video) => (
            <article class="video-card">
              <div class="video-preview">
                {video.videoSrc ? <video controls preload="metadata" poster={video.poster}><source src={video.videoSrc} type="video/mp4" /></video> : <img src={video.poster} alt={`${video.title} 콘티 미리보기`} />}
                <span class="seq">#{String(video.sequence).padStart(2, '0')}</span>
                <span class:list={['video-status', video.status]}>{statusLabel[video.status]}</span>
              </div>
              <div class="video-body">
                <div class="video-id"><span>{video.id}</span><b>{video.duration} · {video.ratio}</b></div>
                <h3>{video.title}</h3><p>{video.subtitle}</p>
                <dl>
                  <div><dt>모델</dt><dd>{video.modelLabel}</dd></div>
                  <div><dt>목표</dt><dd>{video.objective}</dd></div>
                  <div><dt>훅</dt><dd>“{video.hook}”</dd></div>
                </dl>
                <a href={`#video-${String(video.sequence).padStart(3, '0')}`}>콘티 열기 →</a>
              </div>
            </article>
          ))}
        </div>

        <aside class="library-schema">
          <div><span>필수 등록값</span><strong>ID · 제목 · 상태 · 모델 · 훅 · 비율 · 길이</strong></div>
          <div><span>선택 등록값</span><strong>MP4 · 고화질 마스터 · 포스터 · 성과지표</strong></div>
          <div><span>지원 상태</span><strong>콘티 → 캐스팅 → 제작 → 검수 → 승인 → 게시</strong></div>
        </aside>
      </div>
    </section>

    <section class="concept-section container" id="video-001">
      <header class="concept-title">
        <div class="number">01</div>
        <div><p class="eyebrow">First production · {firstVideo.id}</p><h2>{firstVideo.title}</h2><p>{firstVideo.subtitle}</p></div>
        <span class="concept-status">{statusLabel[firstVideo.status]}</span>
      </header>

      <div class="brief-grid">
        <article><span>목표</span><p>{firstVideo.objective}</p></article>
        <article><span>핵심 상황</span><p>토너만으로는 아쉽고 크림은 무겁다고 느끼는 실제 루틴 순간</p></article>
        <article><span>키 메시지</span><strong>{firstVideo.keyMessage}</strong></article>
        <article><span>CTA</span><strong>{firstVideo.cta}</strong></article>
        {firstVideo.generation && <article><span>생성 경로</span><p>{firstVideo.generation}</p></article>}
        {firstVideo.creditSummary && <article><span>Higgsfield 크레딧</span><strong>{firstVideo.creditSummary}</strong></article>}
      </div>

      <div class="script-strip">
        <span>30초 나레이션</span>
        <div><p>“{firstVideo.narrationScript}”</p><small>{firstVideo.voiceDirection}</small></div>
      </div>

      <section class="sketches" aria-labelledby="sketch-title">
        <div class="subhead"><p class="eyebrow">GPT Images previsualization</p><h3 id="sketch-title">말하는 얼굴 대신 무언 행동으로 설계</h3><p>실제 제품 원본을 레퍼런스로 첨부해 ChatGPT Images 웹에서 다시 만든 30초 기획 스케치입니다. 인물의 입은 닫고, 정보는 모두 나레이션과 후반 자막으로 전달합니다.</p></div>
        <div class="sketch-grid">
          {storySketches.map((sketch) => (
            <figure><img src={sketch.src} alt={sketch.label + ' 스토리보드 스케치'} /><figcaption><b>{sketch.label}</b><span>{sketch.desc}</span></figcaption></figure>
          ))}
        </div>
      </section>

      <section class="timeline" aria-labelledby="timeline-title">
        <div class="subhead"><p class="eyebrow">Shot by shot</p><h3 id="timeline-title">30초 나레이션 콘티</h3></div>
        <div class="timeline-list">
          {firstVideo.storyboard.map((shot, index) => (
            <article>
              <div class="shot-index"><span>{shot.id}</span><b>{shot.time}</b><em>{shot.phase}</em></div>
              <div class="shot-main"><h4>{shot.visual}</h4><p class="dialogue">나레이션 · “{shot.narration}”</p>{shot.subtitle && <p class="subtitle">자막 · {shot.subtitle}</p>}</div>
              <div class="shot-tech"><span>{shot.method}</span><p>{shot.qa}</p></div>
              <i>{String(index + 1).padStart(2, '0')}</i>
            </article>
          ))}
        </div>
      </section>

      <div class="do-dont">
        <article><span>반드시 지킬 것</span><ul><li>모델은 입을 닫고 무언 행동만 연기</li><li>실제 한국인 여성 나레이션 우선</li><li>실제 제품 PNG로 라벨 인증</li><li>한국어 자막은 후반 합성</li></ul></article>
        <article class="dont"><span>사용하지 않을 것</span><ul><li>모델 립싱크와 카메라 대화</li><li>AI가 만든 펌핑·제형 증거</li><li>느린 소프트톤·AI 성우 억양</li><li>검은 자막 박스와 긴 엔드카드</li></ul></article>
      </div>
    </section>

    <section class="gates-section" id="gates">
      <div class="container">
        <header class="section-head"><div><p class="eyebrow">Failure-control gates</p><h2>한 번에 만들지 않는 제작 순서</h2></div><p>앞 단계가 통과되지 않으면 다음 단계 크레딧을 사용하지 않습니다.</p></header>
        <div class="gate-list">
          {productionGates.map(([number, title, body], index) => (
            <article class:list={{ done: index < 4, current: index === 4 }}><span>{number}</span><div><h3>{title}</h3><p>{body}</p></div><b>{index < 4 ? 'CHECKED' : index === 4 ? 'NOW' : 'NEXT'}</b></article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .studio-page { --aqua:#bfe8e9; --aqua-deep:#285e62; --paper:#f4f0e7; --night:#101716; color:var(--ink); overflow:hidden; }
  .studio-page :is(h1,h2,h3,h4,p,dl,blockquote,figure) { margin-top:0; }
  :global(.studio-page img), :global(.studio-page video) { max-width:100%; }
  :global(.attempt-media img), :global(.attempt-media video), :global(.model-visual img), :global(.video-preview img), :global(.video-preview video), :global(.sketch-grid img) { display:block; width:100%; height:100%; object-fit:cover; }
  .studio-page a { color:inherit; text-decoration:none; }
  .eyebrow { margin:0 0 10px; text-transform:uppercase; letter-spacing:.17em; font-size:12px; font-weight:900; color:var(--aqua-deep); }

  .hero { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(340px,.8fr); gap:clamp(28px,6vw,90px); align-items:center; padding-block:clamp(44px,8vw,96px) clamp(32px,6vw,72px); }
  .hero h1 { margin:0; max-width:16ch; font-size:clamp(40px,6.3vw,82px); line-height:.96; letter-spacing:-.055em; font-weight:900; }
  .hero h1 em { color:var(--aqua-deep); font-style:normal; }
  .hero-copy>p:not(.eyebrow) { max-width:60ch; margin:25px 0; color:var(--muted); font-size:clamp(16px,1.5vw,19px); line-height:1.75; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:10px; }
  .hero-actions a { padding:13px 18px; border-radius:999px; background:var(--night); color:white; font-weight:800; }
  .hero-actions .ghost { border:1px solid var(--line-strong); background:transparent; color:var(--ink); }
  .hero-board { position:relative; transform:rotate(1.5deg); border:1px solid #27302e; border-radius:6px; background:var(--night); color:#f4f0e7; box-shadow:18px 22px 0 #cce8e7; }
  .board-top,.board-main,.hero-board dl { padding:18px 22px; }
  .board-top { display:flex; justify-content:space-between; border-bottom:1px dashed #56605e; font:800 12px/1 monospace; letter-spacing:.08em; }
  .board-main { min-height:190px; display:flex; flex-direction:column; justify-content:center; }
  .board-main>strong { color:#93d5d5; font:700 13px monospace; }.board-main h2{margin:9px 0 20px;font-size:clamp(34px,4vw,54px);letter-spacing:-.045em}.board-main p{margin:0;color:#c7cecc}.board-main p b{color:white}
  .hero-board dl { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;border-top:1px dashed #56605e;margin:0 }.hero-board dt{color:#96a09d;font-size:11px}.hero-board dd{margin:5px 0 0;font:900 19px monospace;color:white}

  .section-nav { position:sticky; top:8px; z-index:10; display:flex; justify-content:center; gap:6px; width:max-content; max-width:calc(100vw - 24px); padding:7px; border:1px solid rgba(16,23,22,.16); border-radius:999px; background:rgba(244,240,231,.92); backdrop-filter:blur(14px); box-shadow:0 10px 30px rgba(16,23,22,.08); }
  .section-nav a { padding:9px 14px; border-radius:999px; font-size:13px; font-weight:800; white-space:nowrap; }.section-nav a:hover{background:var(--night);color:white}
  .section-head { display:flex; justify-content:space-between; gap:30px; align-items:end; margin-bottom:28px; }.section-head h2{margin:0;font-size:clamp(32px,4vw,54px);letter-spacing:-.045em}.section-head>p{max-width:54ch;margin:0;color:var(--muted);line-height:1.65}.section-head.light{color:white}.section-head.light .eyebrow{color:#91d7d6}.section-head.light>p{color:#b7c0bd}

  .attempt-section{padding-block:clamp(70px,9vw,115px)}
  .attempt-summary{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:16px;overflow:hidden;background:white;margin-bottom:22px}.attempt-summary div{padding:17px 20px;border-right:1px solid var(--line)}.attempt-summary div:last-child{border:0}.attempt-summary span{display:block;color:var(--muted);font-size:11px;font-weight:800}.attempt-summary b{display:inline-block;margin-top:5px;font:900 25px monospace}.attempt-summary small{margin-left:5px;color:var(--muted);font:800 10px monospace}
  .attempt-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.attempt-card{min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:20px;background:white;box-shadow:var(--shadow-sm)}.attempt-card.rejected{border-color:#e5c2ba;background:#fffaf8}.attempt-card.pending{border-color:#d6be79}.attempt-card.reference{border-color:#8fc4ba}.attempt-media{position:relative;aspect-ratio:9/13;overflow:hidden;background:#dfe8e6}.attempt-media img,.attempt-media video{display:block;width:100%;height:100%;object-fit:cover}.attempt-scene,.attempt-status{position:absolute;top:13px;padding:7px 9px;border-radius:999px;font:900 10px monospace}.attempt-scene{left:13px;background:var(--night);color:white}.attempt-status{right:13px;background:#e9f6f2;color:#23604f}.rejected .attempt-status{background:#ffe5df;color:#983c31}.pending .attempt-status{background:#fff1bd;color:#765a00}.attempt-copy{padding:19px}.attempt-id{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font:800 10px monospace}.attempt-copy h3{margin:17px 0 7px;font-size:23px;letter-spacing:-.03em}.attempt-copy>p{min-height:64px;color:var(--muted);font-size:13px;line-height:1.6}.attempt-copy dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:17px 0}.attempt-copy dl div{padding:9px;border-radius:9px;background:#f1f4f2}.attempt-copy dt{font-size:10px;color:var(--muted)}.attempt-copy dd{margin:4px 0 0;font-size:11px;font-weight:800;line-height:1.45}.attempt-copy ul{margin:0;padding-left:18px;color:#873f36;font-size:12px;line-height:1.65}

  .models-section { padding-block:clamp(70px,10vw,130px); }
  .model-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .model-card { min-width:0; border:1px solid var(--line); border-radius:24px; overflow:hidden; background:white; box-shadow:var(--shadow-sm); }
