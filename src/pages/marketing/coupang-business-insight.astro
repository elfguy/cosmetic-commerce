---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const productPriorities = [
  {
    order: '1',
    label: '잘 팔리는 상품은 더 많이 보여준다',
    products: '아쿠아 로션 · 히알루론산 토너',
    evidence: '로션 조회 20회·주문 2건, 토너 조회 12회·주문 1건',
    action: '이미지와 상세페이지를 당장 바꾸지 않습니다. 검색 노출과 광고 유입을 늘려 지금 보이는 전환 신호가 반복되는지 확인합니다.',
  },
  {
    order: '2',
    label: '사람은 들어오는데 덜 팔리는 상품을 고친다',
    products: '화이트닝 톤 케어 크림',
    evidence: '조회 28회·장바구니 2건·주문 1건, 구매전환율 3.57%',
    action: '대표 이미지 한 장부터 바꾸고 7일과 14일 뒤 클릭·장바구니·구매 변화를 봅니다. 상세페이지는 그 다음입니다.',
  },
  {
    order: '3',
    label: '방문이 적은 상품은 노출부터 만든다',
    products: 'PDRN 수딩크림 · 클렌징오일 · 클렌징젤 · 에센스 · 립밤',
    evidence: '상품별 조회가 1~6회 수준이라 전환을 판단할 표본이 부족함',
    action: '상세페이지를 다시 만들기 전에 검색어, 상품정보, 광고를 점검합니다. 방문자가 생긴 뒤에야 이미지 문제인지 가격 문제인지 판단할 수 있습니다.',
  },
];

const tools = [
  {
    title: '판매분석',
    question: '어느 상품에서 매출이 새고 있습니까?',
    explanation: '방문자가 상품을 보고 장바구니에 담고 주문하는 과정을 상품별로 보여줍니다. 숫자가 끊기는 지점이 고쳐야 할 곳입니다.',
    example: '조회는 많은데 장바구니가 적다면 상세페이지·가격·리뷰를 봅니다. 장바구니는 많은데 주문이 적다면 배송·쿠폰·구성을 봅니다.',
  },
  {
    title: '유입경로 분석',
    question: '고객은 광고로 왔습니까, 검색으로 왔습니까?',
    explanation: '광고, 자연검색, 추천, 마이쿠팡 등 고객이 들어온 길을 나눠 보여줍니다. 광고를 끄면 매출도 멈추는 구조인지 확인할 수 있습니다.',
    example: '현재 자연유입은 약 24%입니다. 장기적으로는 검색과 추천 유입을 키워 광고비가 매출을 과도하게 잡아먹지 않도록 해야 합니다.',
  },
  {
    title: '카테고리 분석',
    question: '잘 팔리는 경쟁상품은 무엇이 다릅니까?',
    explanation: '경쟁상품의 가격, 리뷰, 검색 노출, 클릭률, 인기 검색어와 브랜드 순위를 비교합니다. 신상품 소싱과 대표 이미지 기획에 사용합니다.',
    example: '스탠다드 플랜의 3개 카테고리는 데이크림, 로션/에멀젼, 스킨/토너에 우선 사용합니다.',
  },
];

const keywordSteps = [
  { day: '준비', title: '후보를 모읍니다', body: '카테고리 인기 검색어, 경쟁상품 검색어, 우리 상품의 실제 유입어를 한곳에 모읍니다.' },
  { day: '검토', title: '쓸 수 없는 표현을 뺍니다', body: '경쟁 브랜드명, 제품과 관계없는 인기어, 근거 없는 효능 표현은 제외합니다.' },
  { day: '7일', title: '광고 키워드로 먼저 확인합니다', body: '후보 3~5개를 소액으로 운영해 노출, 클릭, 주문, 광고비를 확인합니다.' },
  { day: '14일', title: '검증된 키워드만 상품에 반영합니다', body: '상품명과 이미지는 그대로 두고 검색 태그·검색옵션 2~3개만 바꿉니다.' },
  { day: '판정', title: '매출보다 공헌이익을 봅니다', body: '노출부터 주문까지 좋아져도 광고비와 원가를 빼고 남지 않으면 확대하지 않습니다.' },
];

const sellerCases = [
  {
    source: '쿠팡 공식 판매자 사례',
    title: '경쟁상품에서 고객이 쓰는 말을 찾았습니다',
    story: '한 판매자는 경쟁상품의 상품명에서 새로운 일반 키워드를 찾아 자기 상품에 반영했습니다. 쿠팡은 이후 유입수와 구매전환율이 늘었다고 소개했습니다.',
    lesson: '경쟁 브랜드명 자체를 쓰는 것이 아닙니다. 고객이 무엇을 찾는지 표현만 가져와야 합니다.',
  },
  {
    source: '쿠팡 공식 제철과일 사례',
    title: '지난해 데이터를 보고 올해 상품을 준비했습니다',
    story: '전년도 제철과일 검색 흐름을 보고 햇사과와 사과 수요에 맞춘 상품 구성을 준비해 짧은 기간 매출 기회를 잡았습니다.',
    lesson: '계절상품은 판매가 시작된 뒤 분석하면 늦습니다. 수요가 오르기 전에 상품과 광고를 준비해야 합니다.',
  },
  {
    source: '월 매출 약 4억 원 판매자 인터뷰',
    title: '장바구니에서 빠져나가는 이유를 가격에서 찾았습니다',
    story: '장바구니 대비 주문이 낮은 상품은 가격과 구성을 다시 보고, 여러 개씩 사는 상품에는 묶음 쿠폰을 적용했습니다. 인기 검색어 누락도 꾸준히 보완했습니다.',
    lesson: '방문자 수만 늘리는 것이 마케팅은 아닙니다. 결제 직전에 나가는 이유까지 찾아야 매출이 남습니다.',
  },
  {
    source: '올라 셀러 프로젝트',
    title: '조회가 있는 상품부터 순서대로 손봤습니다',
    story: '노출 대비 클릭이 낮으면 썸네일을 바꾸고, 조회 대비 구매가 낮으면 상세페이지를 바꿨습니다. 변경 후에는 같은 지표를 다시 확인했습니다.',
    lesson: '한 번에 여러 곳을 바꾸면 무엇이 효과가 있었는지 알 수 없습니다. 한 번에 하나만 바꿔야 합니다.',
  },
];

const actionPlan = [
  { week: '이번 주', title: '데이터를 보관합니다', body: '7월 31일 전에 데이크림·로션·토너의 Top 100 경쟁상품과 검색어를 저장합니다. 모든 상품의 7일·30일 기준값도 내려받습니다.' },
  { week: '다음 7일', title: '아쿠아 로션 키워드를 시험합니다', body: '수분 에멀전, 고보습 로션처럼 제품과 맞는 일반 키워드를 광고로 먼저 검증합니다. 토너는 바꾸지 않고 비교상품으로 둡니다.' },
  { week: '그 다음 14일', title: '화이트닝 크림 이미지를 시험합니다', body: '대표 이미지 한 장만 교체합니다. 클릭률이 오르면 유지하고, 클릭은 오르는데 장바구니가 늘지 않으면 상세페이지를 고칩니다.' },
  { week: '8월 13일 전', title: '구독을 유지할지 결정합니다', body: '추가 매출이 아니라 추가 공헌이익을 계산합니다. 한 달에 99,000원 이상 남기는 데 도움이 되었을 때만 구독을 이어갑니다.' },
];

const sources = [
  { label: '쿠팡 공식 구매·검색 옵션 가이드', href: 'https://marketplace.coupang.com/information-center/blog-news5?rf=MARKETPLACE' },
  { label: '쿠팡 공식 비즈니스 인사이트 판매자 사례', href: 'https://blog.naver.com/coupangsellers/224090010989' },
  { label: '쿠팡 Ads 상품·키워드 수정 가이드', href: 'https://ads.coupang.com/guide/02' },
  { label: '윈들리 판매자 인터뷰', href: 'https://newneek.co/@windly/article/38021' },
  { label: '판매분석 지표 해석 사례', href: 'https://blog.naver.com/addvalue_/223983153114' },
  { label: '올라 셀러 프로젝트 활용 사례', href: 'https://www.openads.co.kr/content/contentDetail?contsId=16208' },
];
---

<BaseLayout title="쿠팡 매출을 늘리는 비즈니스 인사이트 사용법" description="쿠팡 판매를 처음 맡은 사람도 이해할 수 있도록 판매분석, 유입경로, 검색 키워드 실험과 실행 순서를 설명한 유어스킨플러스 마케팅 가이드">
  <SiteHeader active="/sales-analysis/" />

  <main class="guide-page">
    <section class="hero container">
      <div class="hero-copy">
        <p class="section-label">유어스킨플러스 쿠팡 마케팅 가이드</p>
        <h1>매출을 늘리려면<br />먼저 <em>어디에서 고객을 놓치는지</em><br />알아야 합니다.</h1>
        <p class="lead">비즈니스 인사이트는 매출을 자동으로 올려주는 도구가 아닙니다. 고객이 상품을 발견하고 결제하기까지 어느 단계에서 빠져나가는지 보여주는 도구입니다. 이 페이지는 쿠팡 판매를 처음 맡은 분도 바로 판단하고 움직일 수 있도록 작성했습니다.</p>
      </div>
      <aside class="hero-note">
        <span>먼저 이것만 기억하세요</span>
        <strong>사람이 안 오면 노출을 늘리고,<br />사람은 오는데 안 사면 상품을 고칩니다.</strong>
        <p>이 두 문제를 구분하지 않으면 광고비와 이미지 제작비만 늘어납니다.</p>
      </aside>
    </section>

    <nav class="page-nav container" aria-label="문서 목차">
      <a href="#status">현재 상황</a>
      <a href="#reading">숫자 읽는 법</a>
      <a href="#priority">상품 우선순위</a>
      <a href="#tools">도구 사용법</a>
      <a href="#keywords">키워드 실험</a>
      <a href="#cases">판매자 사례</a>
      <a href="#plan">실행 계획</a>
    </nav>

    <section class="section container" id="status">
      <div class="section-intro">
        <p class="section-label">현재 상황</p>
        <h2>매출은 나고 있지만 광고비 부담이 큽니다.</h2>
        <p>2026년 7월 9일부터 15일까지 6개가 팔려 61,700원의 매출이 발생했습니다. 같은 기간 광고비는 약 33,000원입니다. 제품 원가, 쿠팡 수수료, 배송비를 빼기 전인데도 광고비가 매출의 절반을 넘습니다.</p>
      </div>

      <div class="numbers" aria-label="최근 판매 지표">
        <article><span>최근 7일 매출</span><strong>61,700원</strong><small>판매 6개</small></article>
        <article><span>구매전환율</span><strong>5.72%</strong><small>방문자 84명</small></article>
        <article class="warning"><span>광고비 비중</span><strong>53.5%</strong><small>매출 대비</small></article>
        <article><span>자연유입 비중</span><strong>24.2%</strong><small>최근 30일 조회 기준</small></article>
      </div>

      <div class="marketer-view">
        <span>마케터의 판단</span>
        <p>지금은 광고비를 더 쓰기보다, 이미 팔리는 로션과 토너에 예산을 모으고 자연검색 유입을 늘려야 합니다. 팔리지 않는 상품 전체를 한꺼번에 리뉴얼하는 것은 비용만 커질 가능성이 높습니다.</p>
      </div>
    </section>

    <section class="section soft-section" id="reading">
      <div class="container">
        <div class="section-intro compact">
          <p class="section-label">숫자 읽는 법</p>
          <h2>판매 화면의 숫자는 고객의 이동 순서입니다.</h2>
          <p>각 숫자를 따로 보지 말고 앞 단계에서 다음 단계로 얼마나 넘어갔는지 봅니다.</p>
        </div>

        <div class="journey">
          <article>
            <span>01</span>
            <div><h3>고객이 들어왔습니까?</h3><p>방문자와 조회를 봅니다. 숫자가 적다면 상세페이지보다 검색 노출, 광고, 카테고리, 상품정보가 먼저입니다.</p></div>
            <strong>방문자 · 조회</strong>
          </article>
          <article>
            <span>02</span>
            <div><h3>상품에 관심을 보였습니까?</h3><p>조회는 많은데 장바구니가 적다면 가격, 리뷰, 혜택, 상세 첫 화면이 고객 기대에 미치지 못한 것입니다.</p></div>
            <strong>장바구니</strong>
          </article>
          <article>
            <span>03</span>
            <div><h3>실제로 결제했습니까?</h3><p>장바구니 이후 주문이 적다면 배송일, 배송비, 쿠폰, 옵션 구성과 최종 신뢰 요소를 확인합니다.</p></div>
            <strong>주문 · 매출</strong>
          </article>
        </div>
      </div>
    </section>

    <section class="section container" id="priority">
      <div class="section-intro">
        <p class="section-label">상품 우선순위</p>
        <h2>모든 상품을 동시에 고치지 않습니다.</h2>
        <p>상품마다 문제가 다릅니다. 지금 팔리는 상품, 방문은 있는 상품, 방문조차 없는 상품을 같은 방식으로 운영하면 안 됩니다.</p>
      </div>

      <div class="priority-list">
        {productPriorities.map((item) => (
          <article>
            <span class="priority-number">{item.order}</span>
            <div class="priority-title"><small>{item.products}</small><h3>{item.label}</h3><p>{item.evidence}</p></div>
            <div class="priority-action"><span>지금 할 일</span><p>{item.action}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section dark-section" id="tools">
      <div class="container">
        <div class="section-intro compact light">
          <p class="section-label">비즈니스 인사이트 사용법</p>
          <h2>메뉴 이름보다, 답을 얻고 싶은 질문을 먼저 정합니다.</h2>
        </div>
        <div class="tool-list">
          {tools.map((tool) => (
            <article>
              <header><span>{tool.title}</span><h3>{tool.question}</h3></header>
              <p>{tool.explanation}</p>
              <aside><b>유어스킨 적용</b>{tool.example}</aside>
            </article>
          ))}
        </div>
        <div class="wing-actions">
          <a href="https://wing.coupang.com/tenants/business-insight/sales-analysis" target="_blank" rel="noreferrer">판매분석 열기</a>
          <a href="https://wing.coupang.com/tenants/business-insight/traffic-analysis" target="_blank" rel="noreferrer">유입경로 분석 열기</a>
          <a href="https://wing.coupang.com/tenants/business-insight/category-analysis" target="_blank" rel="noreferrer">카테고리 분석 열기</a>
        </div>
      </div>
    </section>

    <section class="section container" id="keywords">
      <div class="section-intro">
        <p class="section-label">검색 키워드 실험</p>
        <h2>키워드를 바꿔 유입이 늘었는지 시험할 수 있습니다.</h2>
        <p>다만 쿠팡은 자연검색 상품정보를 방문자 절반씩 나누는 A/B 테스트를 제공하지 않습니다. 광고로 키워드 수요를 먼저 확인하고, 검증된 키워드만 상품정보에 반영하는 순서가 안전합니다.</p>
      </div>

      <div class="two-stage">
        <article>
          <span>1단계</span>
          <h3>광고에서 키워드 수요를 확인합니다.</h3>
          <p>후보 키워드를 소액으로 7일간 운영합니다. 노출은 되는데 클릭이 없는지, 클릭은 되는데 주문이 없는지 확인합니다.</p>
          <strong>빠르게 확인할 것: 노출 · 클릭 · 주문 · 광고비</strong>
        </article>
        <article>
          <span>2단계</span>
          <h3>성과가 있는 키워드만 자연검색에 반영합니다.</h3>
          <p>상품명, 이미지, 가격을 그대로 두고 검색 태그나 검색옵션 2~3개만 바꿉니다. 변경 전 14일과 변경 후 14일을 같은 요일로 비교합니다.</p>
          <strong>판단할 것: 자연검색 노출 · 클릭 · 장바구니 · 주문</strong>
        </article>
      </div>

      <div class="keyword-process">
        {keywordSteps.map((step) => (
          <article><span>{step.day}</span><h3>{step.title}</h3><p>{step.body}</p></article>
        ))}
      </div>

      <div class="first-test">
        <div class="first-test-copy">
          <p class="section-label">첫 번째 권장 실험</p>
          <h3>아쿠아 로션만 바꾸고 토너는 그대로 둡니다.</h3>
          <p>아쿠아 로션을 실험상품으로, 토너를 비교상품으로 둡니다. 두 상품의 시장 흐름이 함께 올랐는지, 로션만 올랐는지 비교하면 키워드 효과를 더 정확히 읽을 수 있습니다.</p>
        </div>
        <div class="candidate-box">
          <span>검토할 일반 키워드</span>
          <ul><li>수분 에멀전</li><li>고보습 로션</li><li>여성 로션</li><li>300ml 수분 로션</li></ul>
        </div>
        <div class="caution-box">
          <span>사용하지 않을 표현</span>
          <strong>경쟁 브랜드명</strong>
          <p>실제 유입어에 포함된 '마몽드'는 고객 의도만 참고합니다. 상품명이나 태그에는 넣지 않습니다.</p>
        </div>
      </div>

      <p class="approval-note">상품정보를 실제로 변경하기 전에는 현재 정보를 백업하고 별도 승인을 받습니다. D1~D3은 승인과 검색 반영, 데이터 지연이 섞이므로 결과 판정에서 제외합니다.</p>
    </section>

    <section class="section soft-section" id="cases">
      <div class="container">
        <div class="section-intro">
          <p class="section-label">다른 판매자의 활용 방식</p>
          <h2>잘하는 판매자는 데이터를 본 뒤 반드시 한 가지 행동을 정했습니다.</h2>
          <p>아래 매출 수치는 판매자 인터뷰와 쿠팡 소개 사례입니다. 성과를 그대로 약속하는 자료는 아닙니다. 대신 어떤 숫자를 보고 무엇을 바꿨는지 참고합니다.</p>
        </div>
        <div class="case-list">
          {sellerCases.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><small>{item.source}</small><h3>{item.title}</h3><p>{item.story}</p></div>
              <aside><b>우리에게 적용하면</b><p>{item.lesson}</p></aside>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section container" id="plan">
      <div class="section-intro">
        <p class="section-label">앞으로의 실행 계획</p>
        <h2>한 달 동안 네 가지 일만 순서대로 합니다.</h2>
        <p>작업 수를 늘리는 것이 목표가 아닙니다. 하나를 바꾸고 결과를 확인한 뒤 다음 작업으로 넘어갑니다.</p>
      </div>
      <div class="plan-list">
        {actionPlan.map((item, index) => (
          <article><span>{item.week}</span><div><small>{String(index + 1).padStart(2, '0')}</small><h3>{item.title}</h3><p>{item.body}</p></div></article>
        ))}
      </div>

      <div class="subscription-decision">
        <div><span>구독 판단 기준</span><h3>월 99,000원보다 더 많은 이익을 만들었습니까?</h3></div>
        <p>최근 7일 매출을 단순 월 환산하면 약 26.7만 원입니다. 현재 매출 규모에서는 구독료가 작지 않습니다. 추가 매출이 아니라 원가, 수수료, 배송비, 광고비를 뺀 추가 공헌이익이 월 99,000원을 넘을 때만 유지하는 것이 맞습니다.</p>
      </div>
    </section>

    <section class="sources container" aria-label="참고 자료">
      <div><p class="section-label">확인한 자료</p><h2>공식 가이드를 우선하고 판매자 사례는 참고로 사용했습니다.</h2></div>
      <div class="source-links">{sources.map((source) => <a href={source.href} target="_blank" rel="noreferrer"><span>{source.label}</span><b>원문 보기</b></a>)}</div>
      <p class="data-footnote">유어스킨 판매 데이터 기준: 판매 2026.07.09~07.15, 유입 2026.06.16~07.15. 쿠팡의 갱신 시각과 귀속 기준이 다르므로 서로 다른 화면의 숫자를 단순 합산하지 않습니다.</p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

