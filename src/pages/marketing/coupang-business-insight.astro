---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const wingLinks = [
  { label: '판매분석 열기', href: 'https://wing.coupang.com/tenants/business-insight/sales-analysis' },
  { label: '유입경로 분석 열기', href: 'https://wing.coupang.com/tenants/business-insight/traffic-analysis' },
  { label: '카테고리 분석 열기', href: 'https://wing.coupang.com/tenants/business-insight/category-analysis' },
];

const featureRows = [
  { area: '판매분석', data: '방문자 · 조회 · 장바구니 · 주문 · 판매량 · 매출 · 구매전환율', use: '상품별 병목 진단과 이미지 변경 전후 판정' },
  { area: '광고 성과', data: '광고 매출 · 집행 광고비 · ROAS · 판매량/매출 기여도', use: '매출이 아닌 공헌이익 기준으로 확대·축소' },
  { area: '검색어 분석', data: '검색량 · 노출 · 클릭 · 장바구니 · 판매 · 매출 · 트렌드', use: '상품명, 광고 키워드, 상세 첫 화면 문구 개선' },
  { area: '유입경로', data: '광고 · 검색 · 추천 · 프로모션 · 마이쿠팡 · 마이샵 · 라이브', use: '광고 의존도와 자연유입 성장 여부 추적' },
  { area: '카테고리 분석', data: 'Top 경쟁상품 · 검색어 · 브랜드 · 가격 · 리뷰 · CTR', use: '카테고리 문법을 반영한 대표 이미지·오퍼 설계' },
  { area: '파트너 캠페인', data: '외부 채널별 고유 추적 링크', use: '인스타그램·유튜브·블로그 콘텐츠의 실제 주문 기여 확인' },
];

const products = [
  { group: '확대', tone: 'good', name: '히알루론산 아쿠아 로션', signal: '조회 20 · 주문 2 · CVR 10.0%', issue: '전환 신호 있음, 유입량 부족', action: '상세는 유지하고 고전환 검색어·광고 유입 확대' },
  { group: '확대', tone: 'good', name: '히알루론산 토너', signal: '조회 12 · 주문 1 · CVR 8.33%', issue: '전환 신호 있음, 표본 작음', action: '검색 노출 확대 후 ROAS와 자연유입 동시 관찰' },
  { group: '개선', tone: 'warn', name: '화이트닝 톤 케어 크림', signal: '조회 28 · 장바구니 2 · 주문 1 · CVR 3.57%', issue: '유입 대비 전환 약함', action: '대표 이미지 1장만 먼저 변경 → D7/D14 비교' },
  { group: '노출', tone: 'info', name: 'PDRN 히알루론산 수딩 크림', signal: '조회 6 · 주문 0', issue: '전환 판단 전 트래픽 부족', action: '검색어·상품명·소액 광고로 측정 가능한 조회 확보' },
  { group: '보류', tone: 'muted', name: '클렌징오일 · 젤 · 에센스 · 립밤', signal: '옵션별 조회 1~3 수준 · 주문 0', issue: '표본 부족', action: '상세 재작업보다 카테고리 수요·노출 가능성 먼저 검증' },
];

const diagnosis = [
  { when: '검색 노출은 높은데 클릭이 낮음', read: '대표 이미지 · 상품명 · 가격 경쟁력 문제', do: 'Top 경쟁상품 CTR/썸네일 비교 후 대표 이미지 한 장 실험' },
  { when: '조회는 쌓이는데 장바구니가 없음', read: '상세 첫 화면 · 가격 · 혜택 · 리뷰 신뢰 문제', do: '핵심 효능, 대상 고객, 용량 대비 가치, 배송 혜택 재구성' },
  { when: '장바구니는 있는데 주문이 없음', read: '배송일 · 배송비 · 쿠폰 · 옵션 · 최종 신뢰 문제', do: '판매자배송/로켓그로스와 쿠폰 조건을 옵션별 비교' },
  { when: '광고 매출은 있는데 이익이 없음', read: 'ROAS가 손익분기점보다 낮음', do: 'SKU별 공헌이익률로 손익분기 ROAS 계산 후 예산 이동' },
];

const planRows = [
  { label: '상품별 트래픽·전환·매출', standard: '제공', premium: '제공' },
  { label: '검색어/유입경로/파트너 캠페인', standard: '제공', premium: '제공' },
  { label: 'Top 경쟁상품·검색어', standard: '20개 / 하위 10개', premium: '20개 / 하위 10개' },
  { label: '카테고리 분석 기간', standard: '최대 30일', premium: '최대 360일' },
  { label: '카테고리 분석 개수', standard: '내 카테고리 최대 3개', premium: '내 모든 카테고리' },
  { label: '브랜드별 상품 랭킹·노출 세분화', standard: '제한', premium: '제공' },
  { label: '날짜별 랭킹 트렌드', standard: '제한', premium: '제공' },
];

const schedule = [
  { date: '7월 31일까지', title: 'Top 100 베타 데이터 확보', body: '데이크림·로션·토너 경쟁상품, 검색어, 브랜드 데이터를 저장한다. 베타 종료 후 기본 Top 20 제한에 대비한다.' },
  { date: '8월 1일–7일', title: '첫 번째 매출 실험', body: '화이트닝 크림 대표 이미지 한 장만 교체하고, 아쿠아 로션·토너로 광고 예산을 집중한다.' },
  { date: '8월 8일–13일', title: 'D7 판정과 구독 결정', body: 'CTR·장바구니율·CVR·광고비 절감·추가 공헌이익을 비교해 월 99,000원 이상의 가치가 있었는지 판단한다.' },
  { date: '매주 월요일', title: '7일/30일 스냅샷', body: '엑셀을 저장하고 확대·개선·노출·보류 상품을 다시 분류한다. 변경일에는 D0, 이후 D7/D14를 별도 기록한다.' },
];

const keywordSteps = [
  { step: '01', title: '후보 수집', body: '카테고리 Top 검색어, 경쟁상품 검색어, 우리 상품 실제 유입어, 쿠팡 자동완성을 한 목록으로 모읍니다.' },
  { step: '02', title: '안전 필터', body: '경쟁 브랜드명, 무관 키워드, 근거 없는 효능, 의약품 오인 표현을 제거합니다.' },
  { step: '03', title: '광고로 수요 검증', body: '후보 3~5개를 7일간 소액 테스트해 노출·클릭·주문·ROAS를 먼저 확인합니다.' },
  { step: '04', title: '오가닉 반영', body: '검증된 일반 키워드 2~3개만 검색 태그·검색옵션에 반영하고 상품명·이미지·가격은 유지합니다.' },
  { step: '05', title: 'D0·D7·D14 판정', body: '검색 노출 → 클릭 → 장바구니 → 주문 → 공헌이익 순서로 보고 확대·유지·제거·재시험을 결정합니다.' },
];

const sellerCases = [
  { who: '쿠팡 공식 판매자 사례', title: '경쟁상품에서 일반 키워드를 발견', body: '경쟁 아이템의 상품명을 분석해 새 키워드를 자기 상품에 반영하고 유입과 구매전환율이 크게 늘었다고 소개했습니다.', tag: '키워드 발굴' },
  { who: '쿠팡 공식 제철과일 사례', title: '전년도 데이터로 시즌 상품 구성', body: '전년도 제철과일 흐름에서 햇사과·사과 수요를 읽고 상품 구성을 새로 만들어 단기간 매출 기회를 잡았습니다.', tag: '시즌 수요' },
  { who: '월 매출 약 4억 판매자', title: 'Top 20 태그와 장바구니 이탈을 함께 관리', body: '인기 검색어 누락을 계속 보완하고, 장바구니 대비 주문이 낮으면 가격·구성을 점검하며 묶음 쿠폰으로 객단가를 높였습니다.', tag: '퍼널 운영' },
  { who: '월 매출 2억대 판매자', title: '행동마다 판정 지표를 하나만 지정', body: 'SNS 광고는 주간 매출, 동영상 상세는 전환율, 썸네일은 조회·클릭처럼 액션과 결과 지표를 1:1로 연결했습니다.', tag: '실험 설계' },
  { who: '올라 셀러 프로젝트', title: '고조회 옵션부터 썸네일·상세를 순차 개선', body: '검색 노출 대비 클릭이 낮으면 썸네일, 조회 대비 구매가 낮으면 상세페이지를 고치고 다시 같은 지표를 확인했습니다.', tag: '개선 우선순위' },
];

const researchSources = [
  { label: '쿠팡 공식 · 구매/검색 옵션 가이드', href: 'https://marketplace.coupang.com/information-center/blog-news5?rf=MARKETPLACE' },
  { label: '쿠팡 공식 · 비즈니스 인사이트 판매자 사례', href: 'https://blog.naver.com/coupangsellers/224090010989' },
  { label: '쿠팡 Ads · 상품/키워드 수정 가이드', href: 'https://ads.coupang.com/guide/02' },
  { label: '월 매출 4억 판매자 인터뷰 · 윈들리', href: 'https://newneek.co/@windly/article/38021' },
  { label: '판매분석 액션-지표 해석 사례', href: 'https://blog.naver.com/addvalue_/223983153114' },
  { label: '올라 셀러 프로젝트 활용 사례', href: 'https://www.openads.co.kr/content/contentDetail?contsId=16208' },
];
---

<BaseLayout title="쿠팡 비즈니스 인사이트 운영 전략" description="쿠팡 Wing 비즈니스 인사이트 기능, 현재 판매 퍼널, 상품별 액션과 무료체험 실행 계획을 정리한 마케팅 대시보드">
  <SiteHeader active="/sales-analysis/" />

  <main class="bi-page">
    <section class="hero container">
      <div class="hero__copy">
        <div class="status-line"><span class="live-dot"></span> WING LIVE DATA REVIEW · 2026.07.15</div>
        <p class="eyebrow">Business Insight → Growth Operating System</p>
        <h1>데이터를 보는 데서 끝내지 않고,<br /><em>다음 판매 행동</em>으로 연결한다.</h1>
        <p class="lead">유어스킨플러스의 쿠팡 판매분석·유입경로·카테고리 분석을 실제로 확인한 결과와, 무료체험 기간 안에 매출 개선 효과를 검증하는 실행안입니다.</p>
        <div class="hero__actions">
          <a class="primary-action" href="#action-plan">실행 계획 바로 보기</a>
          <a class="secondary-action" href="/sales-analysis/">기존 매출 분석 보드</a>
        </div>
      </div>
      <aside class="subscription-card">
        <span class="card-kicker">STANDARD · FREE TRIAL</span>
        <strong>₩99,000<small>/월</small></strong>
        <dl>
          <div><dt>무료체험 종료</dt><dd>2026.08.13</dd></div>
          <div><dt>과금 시작</dt><dd>2026.08.14</dd></div>
          <div><dt>8월 예정</dt><dd>58,586원</dd></div>
          <div><dt>결제</dt><dd>다음 정산금 차감</dd></div>
        </dl>
        <p>유지 기준은 “재미있는 데이터”가 아니라 <b>월 추가 공헌이익 99,000원 이상</b>입니다.</p>
      </aside>
    </section>

    <nav class="jump-nav container" aria-label="페이지 바로가기">
      <a href="#current">현재 진단</a><a href="#features">기능 분석</a><a href="#products">상품 전략</a><a href="#category">카테고리</a><a href="#keyword-test">키워드 실험</a><a href="#seller-cases">판매자 사례</a><a href="#action-plan">실행 일정</a><a href="#decision">구독 판정</a>
    </nav>

    <section class="deadline container" aria-label="긴급 일정">
      <span>DEADLINE</span>
      <strong>7월 31일</strong>
      <p>Top 경쟁상품·검색어 최대 100개 베타 무료 제공 종료 예정. 데이크림·로션·토너 데이터부터 보관해야 합니다.</p>
    </section>

    <section class="section container" id="current">
      <header class="section-head">
        <div><p class="eyebrow">01 · Current signal</p><h2>현재 판매 퍼널 진단</h2></div>
        <p>판매는 발생하지만 광고 의존도가 높습니다. 매출 확대보다 먼저 SKU별 손익분기 ROAS를 정해야 합니다.</p>
      </header>

      <div class="kpi-grid">
        <article><span>최근 7일 매출</span><strong>61,700<small>원</small></strong><em>판매 6개</em></article>
        <article><span>구매전환율</span><strong>5.72<small>%</small></strong><em>84명 방문 · 조회 105</em></article>
        <article class="is-alert"><span>광고비 / 전체 매출</span><strong>53.5<small>%</small></strong><em>33,000원 집행</em></article>
        <article><span>자연유입 비중</span><strong>24.2<small>%</small></strong><em>최근 30일 조회 기준</em></article>
      </div>

      <div class="funnel-panel">
        <div class="funnel-copy">
          <p class="mini-label">RECENT 30 DAYS · TRAFFIC MIX</p>
          <h3>유입 4건 중 3건이 광고</h3>
          <p>광고 조회 491건, 자연유입 157건입니다. 광고 매출은 최근 7일 전체 매출의 약 84.3%지만 표시 ROAS는 157.58%에 그쳤습니다.</p>
          <div class="traffic-bar" aria-label="광고 75.8%, 자연유입 24.2%"><span style="width:75.8%">광고 75.8%</span><i>자연 24.2%</i></div>
        </div>
        <div class="route-grid">
          <div><span>광고</span><b>491</b><small>조회 · 주문 13 · CVR 2.65%</small></div>
          <div><span>검색</span><b>56</b><small>조회 · 주문 1 · CVR 1.79%</small></div>
          <div><span>추천</span><b>33</b><small>조회 · 주문 0</small></div>
          <div><span>마이쿠팡</span><b>10</b><small>조회 · 주문 1 · CVR 10%</small></div>
        </div>
      </div>
      <p class="data-note">데이터 범위: 판매 2026.07.09–07.15, 유입 2026.06.16–07.15. 쿠팡의 집계 갱신시각과 귀속 기준이 서로 달라 지표 간 단순 합산은 금지합니다.</p>
    </section>

    <section class="section section--ink" id="features">
      <div class="container">
        <header class="section-head section-head--light">
          <div><p class="eyebrow">02 · Feature map</p><h2>기능은 여섯 가지 질문에 답한다</h2></div>
          <p>분석 화면마다 담당 질문을 하나씩 지정하면 데이터가 실행으로 연결됩니다.</p>
        </header>
        <div class="feature-list">
          {featureRows.map((row, index) => (
            <article>
              <span class="feature-index">0{index + 1}</span>
              <div><small>{row.area}</small><strong>{row.data}</strong></div>
              <p>{row.use}</p>
            </article>
          ))}
        </div>
        <div class="wing-links">
          {wingLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
        </div>
      </div>
    </section>

    <section class="section container" id="products">
      <header class="section-head">
        <div><p class="eyebrow">03 · Product portfolio</p><h2>전 상품을 같은 방식으로 고치지 않는다</h2></div>
        <p>팔리는 상품은 유입을 확대하고, 전환이 낮은 상품만 이미지·상세를 개선합니다. 표본이 없는 상품은 노출부터 만듭니다.</p>
      </header>
      <div class="product-table" role="table" aria-label="상품별 실행 전략">
        <div class="product-row product-row--head" role="row"><span>분류</span><span>상품·현재 신호</span><span>진단</span><span>다음 행동</span></div>
        {products.map((product) => (
          <article class="product-row" role="row">
            <span><em class={`pill pill--${product.tone}`}>{product.group}</em></span>
            <span><b>{product.name}</b><small>{product.signal}</small></span>
            <span>{product.issue}</span>
            <span>{product.action}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section container diagnosis-section">
      <header class="section-head">
        <div><p class="eyebrow">04 · Diagnosis rules</p><h2>숫자가 이렇게 나오면 이렇게 움직인다</h2></div>
      </header>
      <div class="diagnosis-grid">
        {diagnosis.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.when}</h3>
            <p><b>해석</b>{item.read}</p>
            <p><b>실행</b>{item.do}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--sand" id="category">
      <div class="container category-layout">
        <div class="category-copy">
          <p class="eyebrow">05 · Category intelligence</p>
          <h2>스탠다드의 3개 슬롯은<br />주력 SKU에만 쓴다.</h2>
          <p>현재 매출 가능성과 개선 실험 범위를 고려하면 데이크림, 로션/에멀젼, 스킨/토너/화장수가 우선입니다.</p>
          <ol>
            <li><span>1</span><div><b>데이크림</b><small>화이트닝 크림 전환 개선 + PDRN 노출 확보</small></div></li>
            <li><span>2</span><div><b>로션/에멀젼</b><small>현재 최고 전환 상품의 자연검색 확장</small></div></li>
            <li><span>3</span><div><b>스킨/토너/화장수</b><small>실제 판매 신호를 키워 두 번째 주력으로 육성</small></div></li>
          </ol>
        </div>
        <div class="plan-card">
          <div class="plan-card__head"><span>PLAN COMPARISON</span><b>Standard vs Premium</b></div>
          {planRows.map((row) => (
            <div class="plan-row"><span>{row.label}</span><b>{row.standard}</b><em>{row.premium}</em></div>
          ))}
          <div class="plan-legend"><span>스탠다드</span><em>프리미엄</em></div>
        </div>
      </div>
    </section>

    <section class="section keyword-lab" id="keyword-test">
      <div class="container">
        <header class="section-head section-head--light">
          <div><p class="eyebrow">06 · Keyword experiment lab</p><h2>키워드는 감으로 바꾸지 않고<br />두 단계로 검증한다.</h2></div>
          <p>쿠팡에는 오가닉 상품정보의 자동 A/B 분할 기능이 없습니다. 광고 키워드로 수요를 먼저 검증한 뒤, 성과가 확인된 일반 키워드만 검색 태그·검색옵션에 반영합니다.</p>
        </header>

        <div class="test-mode-grid">
          <article>
            <span>STEP A · PAID SIGNAL</span>
            <h3>광고 키워드 테스트</h3>
            <p>후보 키워드별 노출·클릭·주문·ROAS를 빠르게 확인합니다. 여기서 살아남은 키워드만 자연검색 실험으로 넘깁니다.</p>
            <small>목적: 검색 수요와 구매 의도 확인</small>
          </article>
          <article class="is-organic">
            <span>STEP B · ORGANIC LIFT</span>
            <h3>검색 태그·옵션 전후 비교</h3>
            <p>상품명·이미지·가격을 고정하고 태그 2~3개만 반영합니다. 변경 전 14일과 D4~D17을 같은 요일 구성으로 비교합니다.</p>
            <small>목적: 자연검색 노출과 이익률 개선</small>
          </article>
        </div>

        <div class="keyword-flow">
          {keywordSteps.map((item) => (
            <article><span>{item.step}</span><h3>{item.title}</h3><p>{item.body}</p></article>
          ))}
        </div>

        <div class="first-keyword-test">
          <div>
            <p class="mini-label">FIRST CONTROLLED TEST</p>
            <h3>아쿠아 로션을 실험군, 토너를 비교군으로</h3>
            <p>아쿠아 로션의 상품명은 유지하고 검색 태그·검색옵션만 변경합니다. 토너는 아무것도 바꾸지 않아 시장 전체 변화를 분리합니다.</p>
          </div>
          <div class="keyword-candidates">
            <span>안전 후보</span>
            <b>수분 에멀전</b><b>고보습 로션</b><b>여성 로션</b><b>300ml 수분 로션</b>
          </div>
          <div class="keyword-ban">
            <span>제외</span>
            <b>경쟁 브랜드명</b>
            <small>실제 유입어의 ‘마몽드’는 고객 의도만 추출하고 상품명·태그에는 사용하지 않습니다.</small>
          </div>
        </div>

        <div class="measurement-strip">
          <span>검색량</span><i>→</i><span>노출</span><i>→</i><span>클릭</span><i>→</i><span>장바구니</span><i>→</i><span>주문</span><i>→</i><strong>공헌이익</strong>
        </div>
        <p class="keyword-note">실제 상품정보 변경은 별도 승인 후 진행합니다. 변경 전 원본 상품정보를 백업하고, D1~D3은 승인·검색 반영 및 데이터 지연 구간으로 판정에서 제외합니다.</p>
      </div>
    </section>

    <section class="section container" id="seller-cases">
      <header class="section-head">
        <div><p class="eyebrow">07 · Seller playbooks</p><h2>다른 판매자는 데이터를 이렇게 돈으로 바꾼다</h2></div>
        <p>사례의 매출 수치는 통제실험 결과가 아닌 판매자 후기입니다. 숫자를 그대로 믿기보다 반복되는 운영 패턴을 가져옵니다.</p>
      </header>
      <div class="case-grid">
        {sellerCases.map((item, index) => (
          <article>
            <div><span>{String(index + 1).padStart(2, '0')}</span><em>{item.tag}</em></div>
            <small>{item.who}</small>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <aside class="shared-rule">
        <span>COMMON RULE</span>
        <strong>고조회 상품부터 보고 → 한 변수만 바꾸고 → 같은 지표로 다시 판정한다.</strong>
      </aside>
      <div class="source-panel">
        <div><p class="eyebrow">Research sources</p><h3>확인한 공식·판매자 자료</h3><p>공식 가이드를 우선하고 판매자 사례는 운영 아이디어로만 사용했습니다.</p></div>
        <div class="source-links">{researchSources.map((source) => <a href={source.href} target="_blank" rel="noreferrer">{source.label}<span>↗</span></a>)}</div>
      </div>
    </section>

    <section class="section container" id="action-plan">
      <header class="section-head">
        <div><p class="eyebrow">08 · Execution calendar</p><h2>무료체험을 4주짜리 매출 실험으로 사용</h2></div>
        <p>한 번에 한 변수만 변경하고 D0·D7·D14 스냅샷을 남겨 무엇이 매출을 바꿨는지 분리합니다.</p>
      </header>
      <div class="timeline">
        {schedule.map((item, index) => (
          <article>
            <div class="timeline-no">{String(index + 1).padStart(2, '0')}</div>
            <div><span>{item.date}</span><h3>{item.title}</h3><p>{item.body}</p></div>
          </article>
        ))}
      </div>
      <div class="experiment-card">
        <div><span>FIRST EXPERIMENT</span><h3>화이트닝 크림 대표 이미지 1장</h3><p>28회 조회에서 CVR 3.57%. 현재 가장 빠르게 대표 이미지 개선 효과를 읽을 수 있는 상품입니다.</p></div>
        <div class="experiment-metrics"><span>교체 전 D0</span><i>→</i><span>7일 후 D7</span><i>→</i><span>14일 후 D14</span></div>
        <ul><li>검색 노출·클릭률</li><li>조회·장바구니율</li><li>구매전환율·공헌이익</li></ul>
      </div>
    </section>

    <section class="section container" id="decision">
      <div class="decision-card">
        <div class="decision-card__copy">
          <p class="eyebrow">09 · Subscription verdict</p>
          <h2>99,000원을 회수할 수 있을 때만 유지</h2>
          <p>최근 7일 매출을 단순 월 환산하면 약 26.7만 원으로, 구독료가 약 37%에 해당합니다. 지금은 상시 구독을 전제할 단계가 아니라 무료체험으로 효과를 증명할 단계입니다.</p>
        </div>
        <div class="break-even">
          <span>공헌이익률별 필요한 월 추가 매출</span>
          <div><b>30%</b><strong>330,000원</strong></div>
          <div><b>40%</b><strong>247,500원</strong></div>
          <div><b>50%</b><strong>198,000원</strong></div>
        </div>
        <div class="verdict">유지 조건 <b>월 추가 공헌이익 ≥ 99,000원</b></div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

