---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import versionsManifest from '../../../public/coupang/images/whitening-cream/versions/manifest.json';

const publicPathFromSource = (source) => `/${source.replace(/^public\//, '')}`;
const imageEntry = (entry, fallbackLabel) => {
  if (typeof entry === 'string') {
    return { src: publicPathFromSource(entry), label: fallbackLabel };
  }

  return {
    src: publicPathFromSource(entry.src),
    label: entry.label ?? fallbackLabel,
  };
};

const generatedImages = (version, type) => {
  const count = type === 'representative' ? version.representativeCount : version.detailCount;
  const dir = type === 'representative' ? version.representativeDir ?? 'representative' : version.detailDir ?? 'detail';
  const basePath = publicPathFromSource(version.source ?? `public/coupang/images/whitening-cream/versions/${version.id}`);

  if (!count) return [];

  return Array.from({ length: count }, (_, index) => {
    const number = String(index + 1).padStart(2, '0');
    return {
      src: `${basePath}/${dir}/${number}.png`,
      label: `${type === 'representative' ? '대표' : '상세'} ${number}`,
    };
  });
};

const versions = versionsManifest.versions.map((version) => {
  const representativeImages = version.representativeImages
    ? version.representativeImages.map((entry, index) => imageEntry(entry, `대표 ${String(index + 1).padStart(2, '0')}`))
    : generatedImages(version, 'representative');
  const detailImages = version.detailImages
    ? version.detailImages.map((entry, index) => imageEntry(entry, `상세 ${String(index + 1).padStart(2, '0')}`))
    : generatedImages(version, 'detail');

  return {
    ...version,
    representativeImages,
    detailImages,
    representativeCount: representativeImages.length,
    detailCount: detailImages.length,
  };
});

const activeVersion = versions.find((version) => version.id === versionsManifest.activeVersion) ?? versions[0];
const maxDetailCount = Math.max(...versions.map((version) => version.detailCount));
const initialSelected = new Set(['original', activeVersion.id]);
const summaryImage = (version) => version.representativeImages[0]?.src ?? version.detailImages[0]?.src;
const cacheBust = 'whitening-v1-compare-20260607';
const withCacheBust = (src) => `${src}${src.includes('?') ? '&' : '?'}v=${cacheBust}`;
---

<BaseLayout title="화이트닝 톤 케어 크림 이미지 버전 비교" description="화이트닝 톤 케어 크림 원본과 V1 후보 대표·상세 이미지를 비교하는 마케팅 검토 페이지">
  <SiteHeader active="" />

  <main class="version-compare">
    <header class="compare-hero container">
      <nav class="breadcrumb" aria-label="상위 이동">
        <a href="/">대시보드</a>
        <span>/</span>
        <a href="/products/">상품상세</a>
        <span>/</span>
        <a href="/products/whitening-cream/">화이트닝 상세</a>
      </nav>
      <div class="hero-layout">
        <div>
          <p class="eyebrow">Whitening cream version compare</p>
          <h1>화이트닝 톤 케어 크림 원본 / V1 비교</h1>
          <p>
            원본 등록본과 방금 만든 V1 후보 전체 상세 컷을 같은 화면에서 비교합니다.
            01~15번 흐름이 아쿠아/토너처럼 자연스럽게 이어지는지 바로 확인합니다.
          </p>
        </div>
        <aside>
          <span>Current candidate</span>
          <strong>{activeVersion.label}</strong>
          <p>대표 {activeVersion.representativeCount}장 · 상세 {activeVersion.detailCount}장</p>
        </aside>
      </div>
    </header>

    <section class="compare-controls container" aria-label="비교 버전 선택">
      <div class="control-copy">
        <p class="eyebrow">Version library</p>
        <h2>비교할 버전 선택</h2>
        <p>원본 등록본과 V1 후보를 나란히 비교합니다. 필요하면 체크박스로 한쪽만 볼 수 있습니다.</p>
      </div>
      <div class="preset-row" aria-label="추천 비교 조합">
        <button type="button" data-preset={`original,${activeVersion.id}`}>원본 / {activeVersion.label}</button>
        <button type="button" data-preset={`${activeVersion.id}`}>{activeVersion.label}만 보기</button>
        <button type="button" data-preset="original">원본만 보기</button>
      </div>
      <div class="version-picker">
        {versions.map((version) => (
          <label class:list={['version-choice', initialSelected.has(version.id) && 'is-selected']}>
            <input type="checkbox" value={version.id} checked={initialSelected.has(version.id)} />
            <span>{version.label}</span>
            <strong>대표 {version.representativeCount} · 상세 {version.detailCount}</strong>
          </label>
        ))}
      </div>
      <p id="selection-note" class="selection-note">현재 3개 버전을 비교 중입니다.</p>
    </section>

    <section class="summary-grid container" aria-label="버전 요약">
      {versions.map((version) => (
        <article id={version.id} data-version-card={version.id}>
          <div class="summary-image">
            {summaryImage(version) && <img src={withCacheBust(summaryImage(version))} alt={`${version.label} 요약 이미지`} loading="lazy" />}
          </div>
          <div>
            <span>{version.id === activeVersion.id ? '현재 적용' : '비교 대상'}</span>
            <h2>{version.label}</h2>
            <p>
              대표 이미지 {version.representativeCount}장, 상세 이미지 {version.detailCount}장으로 구성된 화이트닝 톤 케어 크림 {version.label} 산출물입니다.
            </p>
            {version.detailImages[0] && <a href={withCacheBust(version.detailImages[0].src)} target="_blank" rel="noreferrer">첫 상세 이미지 열기</a>}
          </div>
        </article>
      ))}
    </section>

    <section class="compare-section container">
      <div class="section-heading">
        <p class="eyebrow">Representative images</p>
        <h2>대표 이미지 비교</h2>
      </div>
      <div class="version-columns">
        {versions.map((version) => (
          <article class="image-column" data-version-column={version.id}>
            <h3>{version.label}</h3>
            <div class="image-stack representative-stack">
              {version.representativeImages.map((image, index) => (
                <a href={withCacheBust(image.src)} target="_blank" rel="noreferrer">
                  <span>{image.label}</span>
                  <img src={withCacheBust(image.src)} alt={`${version.label} ${image.label}`} loading="lazy" />
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="compare-section container">
      <div class="section-heading">
        <p class="eyebrow">Detail flow</p>
        <h2>상세 이미지 흐름 비교</h2>
      </div>
      <div class="flow-table" style={`--rows: ${maxDetailCount};`}>
        {versions.map((version) => (
          <article class="flow-column" data-version-column={version.id}>
            <h3>{version.label}</h3>
            {version.detailImages.length === 0 && <p class="empty-note">상세 이미지 없음</p>}
            {version.detailImages.map((image) => (
              <a class="flow-card" href={withCacheBust(image.src)} target="_blank" rel="noreferrer" aria-label={`${version.label} ${image.label} 열기`}>
                <span aria-hidden="true">{image.label}</span>
                <img src={withCacheBust(image.src)} alt={`${version.label} ${image.label}`} loading="lazy" />
              </a>
            ))}
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const maxSelection = 3;
  const choices = Array.from(document.querySelectorAll('.version-choice'));
  const inputs = Array.from(document.querySelectorAll('.version-choice input'));
  const presetButtons = Array.from(document.querySelectorAll('[data-preset]'));
  const note = document.getElementById('selection-note');
  const versionCards = Array.from(document.querySelectorAll('[data-version-card]'));
  const versionColumns = Array.from(document.querySelectorAll('[data-version-column]'));

  const selectedValues = () => inputs.filter((input) => input.checked).map((input) => input.value);

  const syncSelection = () => {
    let selected = selectedValues();

    if (selected.length > maxSelection) {
      const lastChecked = document.activeElement;
      inputs.forEach((input) => {
        if (input !== lastChecked && selectedValues().length > maxSelection) {
          input.checked = false;
        }
      });
      selected = selectedValues();
    }

    if (selected.length === 0 && inputs[0]) {
      inputs[0].checked = true;
      selected = selectedValues();
    }

    choices.forEach((choice) => {
      const input = choice.querySelector('input');
      choice.classList.toggle('is-selected', Boolean(input?.checked));
    });

    const selectedSet = new Set(selected);
    versionCards.forEach((card) => {
      card.classList.toggle('is-hidden', !selectedSet.has(card.dataset.versionCard || ''));
    });
    versionColumns.forEach((column) => {
      column.classList.toggle('is-hidden', !selectedSet.has(column.dataset.versionColumn || ''));
    });

    if (note) {
      note.textContent = `현재 ${selected.length}개 버전을 비교 중입니다.`;
    }
  };

  inputs.forEach((input) => {
    input.addEventListener('change', syncSelection);
  });

  presetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const preset = new Set((button.dataset.preset || '').split(',').filter(Boolean).slice(0, maxSelection));
      inputs.forEach((input) => {
        input.checked = preset.has(input.value);
      });
      syncSelection();
    });
  });

  syncSelection();
</script>

<style>
  :global(body) {
    background: var(--bg);
  }

  .version-compare {
    color: var(--ink);
    padding-bottom: 8px;
  }

  .version-compare a {
    color: inherit;
    text-decoration: none;
  }

  .compare-hero {
    padding-block: clamp(20px, 4vw, 36px) 0;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .breadcrumb a:hover {
    color: var(--forest);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: stretch;
  }

  .hero-layout > div,
  .hero-layout aside,
  .summary-grid article,
  .compare-section {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow-sm);
  }

  .hero-layout > div {
    display: grid;
    gap: 12px;
    padding: 30px;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-latin);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    word-break: keep-all;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero-layout p {
    max-width: 820px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .hero-layout aside {
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 24px;
    border-left: 5px solid var(--forest);
  }

  .hero-layout aside span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
  }

  .hero-layout aside strong {
    color: var(--forest);
    font-family: var(--font-latin);
    font-size: 42px;
  }

  .compare-controls {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 14px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow-sm);
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .control-copy {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .control-copy h2 {
    margin: 0;
    font-size: 21px;
    line-height: 1.2;
  }

  .control-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .preset-row,
  .version-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .preset-row {
    align-self: start;
  }

  .preset-row button {
    min-height: 38px;
    padding: 0 12px;
    color: var(--forest);
    background: var(--forest-soft);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
  }

  .version-picker {
    grid-column: 2;
  }

  .version-choice {
    display: grid;
    gap: 4px;
    min-width: 170px;
    padding: 12px 13px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .version-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .version-choice.is-selected {
    color: #fff;
    background: var(--forest);
    border-color: var(--forest);
  }

  .version-choice span {
    font-size: 15px;
    font-weight: 900;
  }

  .version-choice strong {
    color: inherit;
    font-size: 12px;
    opacity: 0.78;
  }

  .selection-note {
    grid-column: 2;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .summary-grid article {
    min-width: 0;
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
  }

  .summary-image {
    height: 160px;
    overflow: hidden;
    background: var(--surface-3);
    border-radius: var(--r-sm);
  }

  .summary-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .summary-grid article > div:last-child {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .summary-grid span {
    color: var(--accent);
    font-size: 11px;
    font-weight: 900;
  }

  .summary-grid h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
  }

  .summary-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .summary-grid a {
    justify-self: start;
    padding: 8px 10px;
    color: var(--forest);
    background: var(--forest-soft);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    font-size: 12px;
    font-weight: 900;
  }

  .compare-section {
    padding: 20px;
    margin-bottom: 16px;
  }

  .section-heading {
    display: grid;
    gap: 5px;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 24px;
  }

  .version-columns,
  .flow-table {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .summary-grid article.is-hidden,
  .version-columns [data-version-column].is-hidden,
  .flow-table [data-version-column].is-hidden {
    display: none;
  }

  .image-column,
  .flow-column {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .image-column h3,
  .flow-column h3 {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0;
    padding: 11px 12px;
    color: #fff;
    background: var(--forest);
    border-radius: var(--r-sm);
    font-size: 15px;
  }

  .image-stack,
  .flow-column {
    display: grid;
    gap: 10px;
  }

  .image-stack a,
  .flow-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .image-stack span,
  .flow-card span {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 1;
    padding: 4px 7px;
    color: #fff;
    background: var(--forest);
    border-radius: var(--r-pill);
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
  }

  .image-stack img {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  .flow-card img {
    width: 100%;
    display: block;
  }

  @media (max-width: 1180px) {
    .hero-layout,
    .compare-controls,
    .summary-grid,
    .version-columns,
    .flow-table {
      grid-template-columns: 1fr;
    }

    .version-picker,
    .selection-note {
      grid-column: auto;
    }
  }

  @media (max-width: 720px) {
    .hero-layout > div {
      padding: 22px;
    }

    h1 {
      font-size: 32px;
    }

    .compare-controls,
    .summary-grid article {
      grid-template-columns: 1fr;
    }

    .version-choice {
      min-width: 0;
    }

    .summary-image {
      height: 220px;
    }
  }
</style>
