---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const scenes = [
  {
    no: '01', time: '0–3초', act: 'hook', phase: 'DRY SIGNAL', title: '수분 팀 호출 신호',
    visual: '화이트·민트 공간의 투명 젤 표면이 광택을 잃고 작은 물방울들이 멈춘다. 피부 단면 대신 추상적인 수분 세계로 표현한다.',
    action: '피디의 DNA 리본 실루엣이 멀리서 빠르게 접근한다.',
    camera: '매크로 푸시인 → 9:16 중앙 축',
    copy: '오늘, 수분이 조금 아쉬운가요?',
    narration: '피부가 유난히 메마르게 느껴지는 날,',
    motif: 'signal', tone: '#eef8f3', accent: '#c9eee0'
  },
  {
    no: '02', time: '3–6초', act: 'hook', phase: 'PD ARRIVES', title: 'PDRN 메신저 피디 등장',
    visual: '코랄빛 투명 DNA 리본을 두른 피디가 맑은 수구 위에 가볍게 착지한다. 유리 입자가 퍼지며 실루엣을 소개한다.',
    action: '한 손으로 수분 오브를 들어 올리고 카메라를 향해 짧게 고개를 끄덕인다.',
    camera: '로우앵글 3/4 → 빠른 아크 이동',
    copy: '수분 팀, 출동!',
    narration: '수분 팀을 불러볼까요?',
    motif: 'dna', tone: '#fff2ef', accent: '#ff9b8c'
  },
  {
    no: '03', time: '6–9초', act: 'team', phase: 'CICA JOINS', title: '초록 시카 가디언 합류',
    visual: '물방울을 머금은 둥근 병풀잎 사이에서 작은 시카 가디언이 뛰어나온다. 실제 원료 상세의 밝은 잎색을 유지한다.',
    action: '잎 방패를 펼쳐 피디의 수분 오브 옆에 선다.',
    camera: '잎 사이 트래킹 → 투샷',
    copy: 'CICA · 편안한 진정 케어',
    narration: '투명한 DNA 리본을 두른 피디와, 초록 시카,',
    motif: 'leaf', tone: '#eff9e9', accent: '#8ad56d'
  },
  {
    no: '04', time: '9–12초', act: 'team', phase: 'HYALURONIC DROP', title: '히알루론산 물방울 합류',
    visual: '맑은 아쿠아 구가 통통 튀며 투명 물방울 캐릭터로 변한다. 크기가 다른 작은 수구가 주변을 위성처럼 돈다.',
    action: '수분 구슬을 모아 하나의 투명 링을 만든다.',
    camera: '수구 매크로 → 3인 와이드',
    copy: 'HYALURONIC ACID · 촉촉한 수분감',
    narration: '맑은 히알루론산이 만났어요.',
    motif: 'drop', tone: '#edfaff', accent: '#79d8f4'
  },
  {
    no: '05', time: '12–15초', act: 'team', phase: 'FORMULA LINK', title: '세 성분의 수분 포뮬러',
    visual: '피디의 DNA 리본, 시카 잎, 아쿠아 링이 하나의 커다란 투명 수분 오브를 중심으로 연결된다.',
    action: '세 캐릭터가 서로 다른 방향에서 오브를 밀어 빛을 켠다.',
    camera: '탑숏 회전 → 정면 팀 포즈',
    copy: 'CICA × PDRN × HYALURONIC ACID',
    narration: '세 성분의 수분 진정 포뮬러를 한 통에.',
    motif: 'trinity', tone: '#f5f8f4', accent: '#b6dcca'
  },
  {
    no: '06', time: '15–18초', act: 'solution', phase: 'WATER VEIL', title: '투명 수분 베일 펼치기',
    visual: '커다란 수분 오브가 얇고 투명한 민트 베일로 펼쳐져 추상 표면을 부드럽게 감싼다. 피부층·세포·치료 그래픽은 사용하지 않는다.',
    action: '피디가 망토를 한 번 회전시켜 베일의 흐름을 정리한다.',
    camera: '슬로 모션 측면 → 표면 스윕',
    copy: '산뜻하게 더하는 수분막',
    narration: '가볍고 산뜻한 수분막으로 마무리하고,',
    motif: 'veil', tone: '#e9f8f5', accent: '#92d9c8'
  },
  {
    no: '07', time: '18–21초', act: 'solution', phase: 'PRODUCT REVEAL', title: '실제 200ml 제품 등장',
    visual: '캐릭터 세계의 물빛이 실제 YOURSKIN+ 수딩 크림 팩샷으로 매치컷된다. 흰 용기·은색 리브 캡·실제 라벨 비율을 잠근다.',
    action: '피디와 성분 팀은 제품 뒤가 아니라 하단 작은 반사면에만 등장해 팩샷을 가리지 않는다.',
    camera: '오브 매치컷 → 제품 돌리인',
    copy: 'PDRN HYALURONIC ACID SOOTHING CREAM · 200ml',
    narration: '매일 산뜻하게 바르는 수딩 크림.',
    motif: 'jar', tone: '#f7f7f4', accent: '#d8ddd9'
  },
  {
    no: '08', time: '21–24초', act: 'proof', phase: 'DAILY USE', title: '필요한 만큼 덜어 펴 바르기',
    visual: '깨끗한 성인 손이 실제 크림 제형을 필요한 만큼 덜어 손등에 부드럽게 펴 바른다. 생성 제품 대신 실제 제품·제형 자료를 기준으로 후반 합성한다.',
    action: '피디가 프레임 구석에서 한 번 고개를 끄덕이며 사용 장면을 안내한다.',
    camera: '손·제형 매크로, 느린 슬라이드',
    copy: '매일 바르기 좋은 산뜻한 데일리 수딩 크림',
    narration: '필요한 만큼 덜어 부드럽게 펴 발라 주세요.',
    motif: 'texture', tone: '#fff9f4', accent: '#e7d8c8'
  },
  {
    no: '09', time: '24–27초', act: 'proof', phase: 'INGREDIENT LOCKUP', title: '성분과 제품을 한 프레임에',
    visual: '실제 제품을 중앙에 두고 좌측 시카 잎, 우측 투명 DNA, 하단 수구를 독립 영역으로 배치한다. 캐릭터는 작은 팀 포즈로만 등장한다.',
    action: '세 캐릭터가 제품을 가리지 않는 위치에서 오브를 연결한다.',
    camera: '정면 고정 + 미세한 패럴랙스',
    copy: 'CICA · PDRN · HYALURONIC ACID',
    narration: '피디와 수분 팀이 만드는 매일의 편안한 루틴.',
    motif: 'facts', tone: '#f2f8f3', accent: '#a9cbb5'
  },
  {
    no: '10', time: '27–30초', act: 'close', phase: 'END FRAME', title: '제품 중심 엔드 프레임',
    visual: '화이트·민트 물빛 무대 위 실제 제품이 크게 남는다. 피디는 우측 하단에서 수분 오브를 들고 작은 인사만 한다.',
    action: 'DNA 리본과 수구의 움직임을 멈추고 제품 라벨을 2초 이상 안정적으로 보여준다.',
    camera: '정면 히어로 · 마지막 2초 홀드',
    copy: '오늘도 편안한 수분 루틴 · 제품 정보 확인',
    narration: '오늘도 편안한 수분 루틴을 시작해 보세요.',
    motif: 'end', tone: '#edf8f2', accent: '#6ebf9a'
  },
];

const acts = [
  { id: 'all', label: '전체 30초', count: scenes.length },
  { id: 'hook', label: '훅', count: scenes.filter((s) => s.act === 'hook').length },
  { id: 'team', label: '팀 결성', count: scenes.filter((s) => s.act === 'team').length },
  { id: 'solution', label: '솔루션', count: scenes.filter((s) => s.act === 'solution').length },
  { id: 'proof', label: '제품·근거', count: scenes.filter((s) => s.act === 'proof').length },
  { id: 'close', label: '엔드', count: scenes.filter((s) => s.act === 'close').length },
];

const narration = scenes.map((scene) => scene.narration).join(' ');
---

<BaseLayout title="PDRN 성분 캐릭터 30초 광고 콘티" description="PDRN·CICA·히알루론산 성분 캐릭터를 활용한 유어스킨플러스 수딩 크림 30초 세로 광고 제작 콘티">
  <SiteHeader active="" />

  <main class="character-page">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">PDRN CHARACTER FILM · 30 SEC</p>
        <div class="hero-status"><span>CONCEPT 01</span><b>STORYBOARD READY</b></div>
        <h1>성분이 설명하는 대신,<br /><em>직접 움직이게.</em></h1>
        <p class="lead">PDRN 메신저 <strong>피디</strong>, 초록 시카, 맑은 히알루론산이 한 팀이 되는 30초 성분 캐릭터 광고입니다. 제품보다 캐릭터가 앞서지 않도록 18초부터 실제 제품이 중심을 가져옵니다.</p>
        <div class="hero-actions">
          <a href="#storyboard">10컷 콘티 보기</a>
          <a class="ghost" href="#production">제작 설계 보기</a>
        </div>
        <dl class="hero-metrics">
          <div><dt>FORMAT</dt><dd>9:16</dd></div>
          <div><dt>LENGTH</dt><dd>30s</dd></div>
          <div><dt>SCENES</dt><dd>10</dd></div>
          <div><dt>STATUS</dt><dd>CONCEPT</dd></div>
        </dl>
      </div>

      <div class="character-stage" aria-label="PDRN 캐릭터 피디 키아트">
        <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div>
        <span class="stage-label">CHARACTER 01 · PD</span>
        <img src="/marketing/pdrn-character-video/character-pd-v1.png" alt="PDRN 성분 캐릭터 피디" />
        <div class="stage-caption"><b>PDRN messenger</b><span>DNA ribbon · CICA leaf · aqua orb</span></div>
      </div>
    </section>

    <section class="campaign-strip">
      <div class="container">
        <span>PRODUCT</span><strong>PDRN HYALURONIC ACID SOOTHING CREAM 200ml</strong>
        <i></i><span>CORE</span><strong>CICA · PDRN · HYALURONIC ACID</strong>
        <i></i><span>CLAIM LINE</span><strong>수분 · 수딩 · 산뜻한 보습막</strong>
      </div>
    </section>

    <section class="storyboard container" id="storyboard">
      <header class="section-head">
        <div><p class="eyebrow">10 frames · 3 seconds each</p><h2>30초 광고 콘티</h2></div>
        <p>각 카드는 실제 생성 전에 고정할 장면 계약입니다. 화면·행동·자막·나레이션·카메라를 분리해 캐릭터와 제품이 서로 가려지지 않게 설계했습니다.</p>
      </header>

      <div class="act-filter" role="group" aria-label="콘티 구간 필터">
        {acts.map((act) => <button class:list={[act.id === 'all' && 'active']} type="button" data-act={act.id}>{act.label}<b>{act.count}</b></button>)}
      </div>

      <div class="timeline" aria-label="30초 타임라인">
        {scenes.map((scene, index) => <a href={`#scene-${scene.no}`} style={`--tone:${scene.accent}`}><span>{index * 3}</span><i></i><b>{scene.no}</b></a>)}
        <span class="timeline-end">30s</span>
      </div>

      <div class="scene-grid">
        {scenes.map((scene) => (
          <article id={`scene-${scene.no}`} class="scene-card" data-scene-act={scene.act} style={`--scene-tone:${scene.tone};--scene-accent:${scene.accent}`}>
            <div class="scene-visual">
              <div class:list={['motif', `motif-${scene.motif}`]} aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <div class="scene-index"><b>{scene.no}</b><span>{scene.time}</span></div>
              <p>{scene.phase}</p>
            </div>
            <div class="scene-copy">
              <h3>{scene.title}</h3>
              <p>{scene.visual}</p>
              <dl>
                <div><dt>ACTION</dt><dd>{scene.action}</dd></div>
                <div><dt>CAMERA</dt><dd>{scene.camera}</dd></div>
                <div><dt>ON SCREEN</dt><dd>“{scene.copy}”</dd></div>
                <div class="voice"><dt>VOICE</dt><dd>“{scene.narration}”</dd></div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="script-section" id="script">
      <div class="container script-layout">
        <div class="script-copy">
          <p class="eyebrow">Narration draft</p>
          <h2>30초 나레이션</h2>
          <blockquote>“{narration}”</blockquote>
          <p>제품명·200ml·성분명은 화면에서 정확히 보여주고, 음성은 친구가 소개하듯 자연스럽게 읽습니다. 최종 음성은 별도 오디션 승인 후에만 믹스합니다.</p>
        </div>
        <div class="script-meter">
          <span>READING MAP</span>
          <div class="meter-track"><i style="width:90%"></i></div>
          <dl>
            <div><dt>권장 발화</dt><dd>약 27초</dd></div>
            <div><dt>엔드 홀드</dt><dd>2초 이상</dd></div>
            <div><dt>말투</dt><dd>한국어 대화체</dd></div>
            <div><dt>제품명</dt><dd>화면 중심</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="production container" id="production">
      <header class="section-head">
        <div><p class="eyebrow">Production blueprint</p><h2>캐릭터를 흔들리지 않게 만드는 법</h2></div>
        <p>첫 키아트는 성분 가디언 방향을 보여주는 후보입니다. 영상 투입 전 단순화 모델 시트와 실제 제품 잠금 프레임을 별도로 준비합니다.</p>
      </header>

      <div class="production-grid">
        <article class="character-bible">
          <span class="card-no">01</span><h3>캐릭터 바이블</h3>
          <img src="/marketing/pdrn-character-video/character-pd-v1.png" alt="피디 캐릭터 키아트" loading="lazy" />
          <ul><li>코랄 투명 DNA 리본 1개</li><li>민트 반투명 망토 1장</li><li>시카 잎 문장 1개</li><li>아쿠아 오브 1개</li><li>성인형 얼굴·전신 비율 잠금</li></ul>
        </article>
        <article>
          <span class="card-no">02</span><h3>캐릭터 단순화</h3>
          <p>현재 키아트의 복잡한 DNA 루프와 망토 주름을 줄입니다. 정면·3/4·측면·뒷면, 기본 표정 4개, 손동작 4개를 한 모델 시트로 고정합니다.</p>
          <div class="mini-tags"><span>TURNAROUND</span><span>EXPRESSIONS</span><span>HAND POSES</span></div>
        </article>
        <article>
          <span class="card-no">03</span><h3>실제 제품 잠금</h3>
          <p>18초 이후에는 생성 모델이 제품을 다시 그리지 않게 실제 흰색 용기·은색 리브 캡·라벨·200ml 비율을 후반 합성하거나 제품 원본 기준으로 잠급니다.</p>
          <div class="product-lock"><img src="/naver/banners/kie-20260716/cutouts/soothing-cream.png" alt="실제 수딩 크림 제품 기준" loading="eager" /><b>IMMUTABLE SKU</b></div>
        </article>
        <article>
          <span class="card-no">04</span><h3>생성 단위</h3>
          <p>30초를 한 번에 만들지 않습니다. 3초 장면 10개를 독립 생성하고 얼굴·손·DNA·시카·수구·제품을 프레임별 검수한 뒤 편집합니다.</p>
          <div class="mini-tags"><span>10 × 3 SEC</span><span>FRAME QA</span><span>FINAL EDIT</span></div>
        </article>
      </div>
    </section>

    <section class="safety-section">
      <div class="container safety-layout">
        <div><p class="eyebrow">Claim safety</p><h2>캐릭터의 능력은<br />시각적 은유까지만.</h2></div>
        <div class="safety-columns">
          <article><b>사용 가능</b><ul><li>수분 오브를 모은다</li><li>투명 수분 베일을 펼친다</li><li>시카·PDRN·히알루론산 팀을 소개한다</li><li>산뜻한 데일리 수딩 루틴을 안내한다</li></ul></article>
          <article class="blocked"><b>사용 금지</b><ul><li>세포를 치료하거나 재생한다</li><li>피부 속으로 침투한다</li><li>상처·염증을 즉시 회복한다</li><li>의료 장비·주사·피부 절개도를 사용한다</li></ul></article>
        </div>
      </div>
    </section>

    <section class="source-section container">
      <header><p class="eyebrow">Source authority</p><h2>실제 제품·성분 근거</h2></header>
      <div class="source-grid">
        <figure><img src="/coupang/images/soothing-cream/versions/v2/detail/04.png" alt="CICA PDRN 히알루론산 원료 조합 상세" loading="eager" /><figcaption><b>성분 시각 기준</b><span>CICA · PDRN · HYALURONIC ACID</span></figcaption></figure>
        <figure><img src="/naver/banners/kie-20260716/cutouts/soothing-cream.png" alt="PDRN 히알루론산 수딩 크림 실제 제품" loading="eager" /><figcaption><b>제품 형상 기준</b><span>화이트 용기 · 은색 캡 · 200ml</span></figcaption></figure>
