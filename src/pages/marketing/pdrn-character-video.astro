  <script>
    const buttons = Array.from(document.querySelectorAll('[data-act]'));
    const cards = Array.from(document.querySelectorAll('[data-scene-act]'));
    buttons.forEach((button) => button.addEventListener('click', () => {
      const act = button.getAttribute('data-act');
      buttons.forEach((item) => item.classList.toggle('active', item === button));
      cards.forEach((card) => {
        const visible = act === 'all' || card.getAttribute('data-scene-act') === act;
        card.toggleAttribute('hidden', !visible);
      });
    }));
