---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { marketingWorkspaces } from '../../data/marketingWorkspaces';

const workspace = marketingWorkspaces.find((item) => item.slug === 'aqua-lotion');

if (!workspace) {
  throw new Error('Aqua lotion marketing workspace is missing.');
}

const statusLabel = {
  draft: '초안',
  review: '검토',
  candidate: '후보',
  archive: '보관',
};

const statusClass = {
  draft: 'is-draft',
  review: 'is-review',
  candidate: 'is-candidate',
  archive: 'is-archive',
};

const activeVersion = workspace.versions[0];
---

<BaseLayout title="아쿠아로션 상세 버전" description="아쿠아로션 상세 이미지 개선 버전과 산출물을 비교하고 바로 열어보는 상세 버전 화면">
  <SiteHeader active="" />

  <main class="asset-workbench">
    <section class="asset-stage container">
      <header class="asset-hero">
        <div class="hero-copy">
          <p class="eyebrow">Product asset workspace</p>
          <h1>{workspace.title}</h1>
          <p>{workspace.objective}</p>
          <div class="hero-actions">
            <a class="primary-link" href={activeVersion.primaryUrl} target="_blank" rel="noreferrer">최신 후보 열기</a>
            <a class="ghost-link" href="/coupang/images/aqua-lotion/renewal-2026-05-25-v8-fresh-set/preview/v8-fresh-contact-sheet.jpg" target="_blank" rel="noreferrer">컨택시트 보기</a>
          </div>
        </div>

        <figure class="hero-preview">
          <img src={workspace.thumbnail} alt={`${workspace.productName} 제품 이미지`} />
          <figcaption>
            <span>Next action</span>
            <strong>{workspace.nextAction}</strong>
          </figcaption>
        </figure>
      </header>

      <section class="version-spotlight" aria-label="선택 버전 미리보기">
        <div class="spotlight-copy">
          <p class="eyebrow">Selected preview</p>
          <h2 id="spotlight-title">{activeVersion.label}</h2>
          <p id="spotlight-summary">{activeVersion.summary}</p>
          <div class="spotlight-metrics" id="spotlight-metrics">
            {activeVersion.metrics.map((metric) => (
              <span><strong>{metric.value}</strong>{metric.label}</span>
            ))}
          </div>
          <div class="spotlight-links" id="spotlight-links">
            {activeVersion.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </div>
        </div>
        <a id="spotlight-image-link" class="spotlight-image" href={activeVersion.primaryUrl} target="_blank" rel="noreferrer">
          <img id="spotlight-image" src={activeVersion.preview} alt={`${activeVersion.label} 미리보기`} />
        </a>
      </section>

      <section class="version-grid" aria-label="아쿠아로션 상세 이미지 버전 목록">
        {workspace.versions.map((version) => (
          <article id={version.id} class:list={['version-card', statusClass[version.status]]}>
            <button
              type="button"
              class="version-preview"
              data-version={version.id}
              data-label={version.label}
              data-summary={version.summary}
              data-preview={version.preview}
              data-primary={version.primaryUrl}
              data-links={JSON.stringify(version.links)}
              data-metrics={JSON.stringify(version.metrics)}
            >
              <img src={version.preview} alt={`${version.label} 미리보기`} loading="lazy" />
            </button>

            <div class="version-body">
              <div class="version-head">
                <span>{statusLabel[version.status]}</span>
                <small>{version.date}</small>
              </div>
              <h2>{version.label}</h2>
              <p>{version.summary}</p>

              <dl class="version-metrics">
                {version.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>

              <div class="version-links">
                {version.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </section>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const title = document.getElementById('spotlight-title');
  const summary = document.getElementById('spotlight-summary');
  const image = document.getElementById('spotlight-image');
  const imageLink = document.getElementById('spotlight-image-link');
  const metrics = document.getElementById('spotlight-metrics');
  const links = document.getElementById('spotlight-links');

  const parseDataset = (value) => {
    try {
      return JSON.parse(value || '[]');
    } catch {
      return [];
    }
  };

  const escapeHtml = (value) => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

  document.querySelectorAll('.version-preview').forEach((button) => {
    button.addEventListener('click', () => {
      if (!title || !summary || !image || !imageLink || !metrics || !links) return;

      title.textContent = button.dataset.label || '';
      summary.textContent = button.dataset.summary || '';
      image.setAttribute('src', button.dataset.preview || '');
      image.setAttribute('alt', `${button.dataset.label || '버전'} 미리보기`);
      imageLink.setAttribute('href', button.dataset.primary || button.dataset.preview || '#');

      metrics.innerHTML = parseDataset(button.dataset.metrics)
        .map((metric) => `<span><strong>${escapeHtml(metric.value)}</strong>${escapeHtml(metric.label)}</span>`)
        .join('');

      links.innerHTML = parseDataset(button.dataset.links)
        .map((link) => `<a href="${escapeHtml(link.href)}" target="_blank" rel="noreferrer">${escapeHtml(link.label)}</a>`)
        .join('');
    });
  });
</script>

<style>
  :global(body) { background: var(--bg); }
  :global(body.noise::before) { opacity: 0.05; }
  .asset-workbench { color: var(--ink); padding-bottom: 8px; }
  .asset-workbench a { color: inherit; text-decoration: none; }
  .asset-stage { padding-block: clamp(24px, 4vw, 40px); }
  .asset-hero { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; align-items: stretch; margin-bottom: 18px; }
  .hero-copy, .hero-preview, .version-spotlight, .version-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow-sm); }
  .hero-copy { display: grid; align-content: center; gap: 14px; padding: 28px; }
  .hero-copy h1 { max-width: 780px; margin: 0; font-size: clamp(31px, 4vw, 56px); line-height: 1.08; letter-spacing: -0.02em; word-break: keep-all; }
  .hero-copy p { max-width: 760px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.75; word-break: keep-all; }
  .eyebrow { color: var(--accent); font-family: var(--font-latin); font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .hero-actions, .spotlight-links, .version-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .primary-link, .ghost-link, .spotlight-links a, .version-links a { display: inline-flex; align-items: center; min-height: 38px; padding: 0 13px; border-radius: var(--r-pill); font-size: 13px; font-weight: 900; }
  .primary-link { color: #f7f3e9; background: var(--forest); }
  .ghost-link, .spotlight-links a, .version-links a { color: var(--forest); background: var(--surface-3); border: 1px solid var(--line); }
  .hero-preview { margin: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; overflow: hidden; }
  .hero-preview img { width: 100%; max-width: 100%; height: 280px; object-fit: contain; padding: 24px; background: var(--surface-2); }
  .hero-preview figcaption { display: grid; gap: 5px; padding: 18px; border-top: 1px solid var(--line); }
  .hero-preview span { color: var(--accent); font-size: 11px; font-weight: 900; text-transform: uppercase; }
  .hero-preview strong { font-size: 15px; line-height: 1.55; word-break: keep-all; }
  .version-spotlight { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 18px; padding: 18px; margin-bottom: 18px; }
  .spotlight-copy { display: grid; align-content: start; gap: 13px; padding: 12px; }
  .spotlight-copy h2 { margin: 0; font-size: 28px; line-height: 1.18; }
  .spotlight-copy p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; word-break: keep-all; }
  .spotlight-metrics, .version-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .spotlight-metrics span, .version-metrics div { padding: 10px; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--muted); font-size: 11px; }
  .spotlight-metrics strong, .version-metrics dd { display: block; margin: 0 0 3px; color: var(--ink); font-family: var(--font-latin); font-size: 18px; font-weight: 900; }
  .version-metrics { margin: 0; }
  .version-metrics dt { color: var(--muted); font-size: 10px; font-weight: 800; }
  .spotlight-image { max-height: 620px; overflow: auto; background: var(--surface-3); border: 1px solid var(--line); border-radius: var(--r-sm); }
  .spotlight-image img { width: 100%; max-width: 100%; display: block; }
  .version-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .version-card { min-width: 0; overflow: hidden; }
  .version-preview { width: 100%; height: 230px; display: block; padding: 0; background: var(--surface-3); border: 0; border-bottom: 1px solid var(--line); cursor: pointer; overflow: hidden; }
  .version-preview img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 180ms ease; }
  .version-preview:hover img { transform: scale(1.025); }
  .version-body { display: grid; gap: 11px; padding: 15px; }
  .version-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .version-head span { padding: 4px 8px; color: var(--forest); background: var(--surface-3); border-radius: var(--r-pill); font-size: 11px; font-weight: 900; }
  .is-candidate .version-head span { color: #f7f3e9; background: var(--forest); }
  .is-review .version-head span { color: var(--accent-ink); background: var(--accent-soft); }
  .is-archive .version-head span { color: var(--muted); background: var(--surface-3); }
  .version-head small { color: var(--muted); font-size: 11px; font-weight: 800; }
  .version-body h2 { margin: 0; font-size: 19px; line-height: 1.25; }
  .version-body p { min-height: 84px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; word-break: keep-all; }
  @media (max-width: 1180px) { .asset-hero, .version-spotlight { grid-template-columns: 1fr; } .version-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .hero-copy { padding: 22px; } .hero-copy h1 { font-size: 31px; } .version-grid, .spotlight-metrics, .version-metrics { grid-template-columns: 1fr; } .spotlight-image { max-height: 520px; } }
</style>
