---
import BaseLayout from '../../layouts/BaseLayout.astro';
import versionsManifest from '../../../public/coupang/images/aqua-lotion/versions/manifest.json';

const versions = versionsManifest.versions.map((version) => ({
  ...version,
  basePath: `/coupang/images/aqua-lotion/versions/${version.id}`,
  representativeImages: Array.from({ length: version.representativeCount }, (_, index) =>
    `/coupang/images/aqua-lotion/versions/${version.id}/representative/${String(index + 1).padStart(2, '0')}.png`
  ),
  detailImages: Array.from({ length: version.detailCount }, (_, index) =>
    `/coupang/images/aqua-lotion/versions/${version.id}/detail/${String(index + 1).padStart(2, '0')}.png`
  ),
}));

const activeVersion = versions.find((version) => version.id === versionsManifest.activeVersion) ?? versions[0];
const maxDetailCount = Math.max(...versions.map((version) => version.detailCount));
---

<BaseLayout title="아쿠아로션 원본·V1·V2 비교" description="아쿠아로션 원본, V1, V2 대표 이미지와 상세 이미지를 비교하는 마케팅 검토 페이지">
  <main class="version-compare">
    <header class="compare-hero">
      <nav class="breadcrumb" aria-label="상위 이동">
        <a href="/">대시보드</a>
        <span>/</span>
        <a href="/marketing/aqua-lotion-detail-images/">아쿠아로션 작업공간</a>
      </nav>
      <div class="hero-layout">
        <div>
          <p class="eyebrow">Aqua lotion version compare</p>
          <h1>원본, V1, V2 상세 이미지 비교</h1>
          <p>
            기존 쿠팡 원본 상세와 개선안 V1, 현재 활성 버전 V2를 한 화면에서 비교합니다.
            대표 이미지 구성과 상세 이미지 흐름을 분리해서 보고, 어느 버전을 판매 페이지 기준안으로 삼을지 판단합니다.
          </p>
        </div>
        <aside>
          <span>Active version</span>
          <strong>{activeVersion.label}</strong>
          <p>대표 {activeVersion.representativeCount}장 · 상세 {activeVersion.detailCount}장</p>
        </aside>
      </div>
    </header>

    <section class="version-tabs" aria-label="버전 빠른 이동">
      {versions.map((version) => (
        <a class:list={[version.id === activeVersion.id && 'is-active']} href={`#${version.id}`}>
          <span>{version.label}</span>
          <strong>대표 {version.representativeCount} · 상세 {version.detailCount}</strong>
        </a>
      ))}
    </section>

    <section class="summary-grid" aria-label="버전 요약">
      {versions.map((version) => (
        <article id={version.id}>
          <div class="summary-image">
            <img src={version.representativeImages[0]} alt={`${version.label} 대표 이미지 1`} loading="lazy" />
          </div>
          <div>
            <span>{version.id === activeVersion.id ? '현재 활성' : '비교 대상'}</span>
            <h2>{version.label}</h2>
            <p>
              대표 이미지 {version.representativeCount}장, 상세 이미지 {version.detailCount}장으로 구성된 아쿠아 로션 {version.label} 산출물입니다.
            </p>
            <a href={version.detailImages[0]} target="_blank" rel="noreferrer">첫 상세 이미지 열기</a>
          </div>
        </article>
      ))}
    </section>

    <section class="compare-section">
      <div class="section-heading">
        <p class="eyebrow">Representative images</p>
        <h2>대표 이미지 비교</h2>
      </div>
      <div class="version-columns">
        {versions.map((version) => (
          <article class="image-column">
            <h3>{version.label}</h3>
            <div class="image-stack representative-stack">
              {version.representativeImages.map((src, index) => (
                <a href={src} target="_blank" rel="noreferrer">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <img src={src} alt={`${version.label} 대표 이미지 ${index + 1}`} loading="lazy" />
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="compare-section">
      <div class="section-heading">
        <p class="eyebrow">Detail flow</p>
        <h2>상세 이미지 흐름 비교</h2>
      </div>
      <div class="flow-table" style={`--rows: ${maxDetailCount};`}>
        {versions.map((version) => (
          <article class="flow-column">
            <h3>{version.label}</h3>
            {version.detailImages.map((src, index) => (
              <a class="flow-card" href={src} target="_blank" rel="noreferrer">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <img src={src} alt={`${version.label} 상세 이미지 ${index + 1}`} loading="lazy" />
              </a>
            ))}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #f5f7f2;
  }

  :global(body.noise::before) {
    opacity: 0.05;
  }

  .version-compare {
    --ink: #1d2924;
    --muted: #647169;
    --line: #dde5dc;
    --panel: #ffffff;
    --green: #254d3e;
    --soft: #edf5ee;
    --coral: #ba6048;
    min-height: 100vh;
    padding: 28px;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(37, 77, 62, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(37, 77, 62, 0.035) 1px, transparent 1px),
      #f5f7f2;
    background-size: 34px 34px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .compare-hero,
  .version-tabs,
  .summary-grid article,
  .compare-section {
    width: min(100%, 1480px);
    margin-inline: auto;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .breadcrumb a:hover {
    color: var(--green);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: stretch;
  }

  .hero-layout > div,
  .hero-layout aside,
  .summary-grid article,
  .compare-section {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(29, 41, 36, 0.055);
  }

  .hero-layout > div {
    display: grid;
    gap: 12px;
    padding: 30px;
  }

  .eyebrow {
    margin: 0;
    color: var(--coral);
    font-family: var(--font-latin);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    word-break: keep-all;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero-layout p {
    max-width: 820px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .hero-layout aside {
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 24px;
    border-left: 5px solid var(--green);
  }

  .hero-layout aside span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
  }

  .hero-layout aside strong {
    color: var(--green);
    font-family: var(--font-latin);
    font-size: 42px;
  }

  .version-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .version-tabs a {
    display: grid;
    gap: 4px;
    padding: 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .version-tabs a.is-active {
    color: #fff;
    background: var(--green);
    border-color: var(--green);
  }

  .version-tabs span {
    font-size: 16px;
    font-weight: 900;
  }

  .version-tabs strong {
    color: inherit;
    font-size: 12px;
    opacity: 0.78;
  }

  .summary-grid {
    width: min(100%, 1480px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0 auto 16px;
  }

  .summary-grid article {
    min-width: 0;
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
  }

  .summary-image {
    height: 160px;
    overflow: hidden;
    background: var(--soft);
    border-radius: 7px;
  }

  .summary-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .summary-grid article > div:last-child {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .summary-grid span {
    color: var(--coral);
    font-size: 11px;
    font-weight: 900;
  }

  .summary-grid h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
  }

  .summary-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .summary-grid a {
    justify-self: start;
    padding: 8px 10px;
    color: var(--green);
    background: var(--soft);
    border: 1px solid #d4e2d6;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
  }

  .compare-section {
    padding: 20px;
    margin-bottom: 16px;
  }

  .section-heading {
    display: grid;
    gap: 5px;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 24px;
  }

  .version-columns,
  .flow-table {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .image-column,
  .flow-column {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .image-column h3,
  .flow-column h3 {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0;
    padding: 11px 12px;
    color: #fff;
    background: var(--green);
    border-radius: 7px;
    font-size: 15px;
  }

  .image-stack,
  .flow-column {
    display: grid;
    gap: 10px;
  }

  .image-stack a,
  .flow-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: #eff5f0;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .image-stack span,
  .flow-card span {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 1;
    padding: 4px 7px;
    color: #fff;
    background: rgba(37, 77, 62, 0.9);
    border-radius: 999px;
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
  }

  .image-stack img {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  .flow-card img {
    width: 100%;
    display: block;
  }

  @media (max-width: 1180px) {
    .hero-layout,
    .summary-grid,
    .version-columns,
    .flow-table {
      grid-template-columns: 1fr;
    }

    .version-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .version-compare {
      padding: 18px 12px;
    }

    .hero-layout > div {
      padding: 22px;
    }

    h1 {
      font-size: 32px;
    }

    .version-tabs,
    .summary-grid article {
      grid-template-columns: 1fr;
    }

    .summary-image {
      height: 220px;
    }
  }
</style>
