---
import BaseLayout from '../../layouts/BaseLayout.astro';
import versionsManifest from '../../../public/coupang/images/aqua-lotion/versions/manifest.json';

const versions = versionsManifest.versions.map((version) => ({
  ...version,
  basePath: `/coupang/images/aqua-lotion/versions/${version.id}`,
  representativeImages: Array.from({ length: version.representativeCount }, (_, index) =>
    `/coupang/images/aqua-lotion/versions/${version.id}/representative/${String(index + 1).padStart(2, '0')}.png`
  ),
  detailImages: Array.from({ length: version.detailCount }, (_, index) =>
    `/coupang/images/aqua-lotion/versions/${version.id}/detail/${String(index + 1).padStart(2, '0')}.png`
  ),
}));

const activeVersion = versions.find((version) => version.id === versionsManifest.activeVersion) ?? versions[0];
const maxDetailCount = Math.max(...versions.map((version) => version.detailCount));
const initialSelected = new Set(['original', 'v1', activeVersion.id]);
---

<BaseLayout title="아쿠아로션 원본·V1·V2 비교" description="아쿠아로션 원본, V1, V2 대표 이미지와 상세 이미지를 비교하는 마케팅 검토 페이지">
  <main class="version-compare">
    <header class="compare-hero">
      <nav class="breadcrumb" aria-label="상위 이동">
        <a href="/">대시보드</a>
        <span>/</span>
        <a href="/products/">상품상세</a>
      </nav>
      <div class="hero-layout">
        <div>
          <p class="eyebrow">Aqua lotion version compare</p>
          <h1>선택 버전 상세 이미지 비교</h1>
          <p>
            버전이 늘어나도 전체를 한꺼번에 펼치지 않고, 비교할 2~3개만 선택해서 봅니다.
            PC에서는 선택 버전을 나란히 비교하고, 모바일에서는 선택 버전 중심으로 세로 확인합니다.
          </p>
        </div>
        <aside>
          <span>Active version</span>
          <strong>{activeVersion.label}</strong>
          <p>대표 {activeVersion.representativeCount}장 · 상세 {activeVersion.detailCount}장</p>
        </aside>
      </div>
    </header>

    <section class="compare-controls" aria-label="비교 버전 선택">
      <div class="control-copy">
        <p class="eyebrow">Version library</p>
        <h2>비교할 버전 선택</h2>
        <p>최대 3개까지 선택됩니다. 원본, 현재 후보, 직전 후보처럼 필요한 조합만 남겨서 비교합니다.</p>
      </div>
      <div class="preset-row" aria-label="추천 비교 조합">
        <button type="button" data-preset="original,v1,v2">원본 / V1 / V2</button>
        <button type="button" data-preset={`original,${activeVersion.id}`}>원본 / 현재</button>
        <button type="button" data-preset={`v1,${activeVersion.id}`}>V1 / 현재</button>
      </div>
      <div class="version-picker">
        {versions.map((version) => (
          <label class:list={['version-choice', initialSelected.has(version.id) && 'is-selected']}>
            <input type="checkbox" value={version.id} checked={initialSelected.has(version.id)} />
            <span>{version.label}</span>
            <strong>대표 {version.representativeCount} · 상세 {version.detailCount}</strong>
          </label>
        ))}
      </div>
      <p id="selection-note" class="selection-note">현재 3개 버전을 비교 중입니다.</p>
    </section>

    <section class="summary-grid" aria-label="버전 요약">
      {versions.map((version) => (
        <article id={version.id} data-version-card={version.id}>
          <div class="summary-image">
            <img src={version.representativeImages[0]} alt={`${version.label} 대표 이미지 1`} loading="lazy" />
          </div>
          <div>
            <span>{version.id === activeVersion.id ? '현재 활성' : '비교 대상'}</span>
            <h2>{version.label}</h2>
            <p>
              대표 이미지 {version.representativeCount}장, 상세 이미지 {version.detailCount}장으로 구성된 아쿠아 로션 {version.label} 산출물입니다.
            </p>
            <a href={version.detailImages[0]} target="_blank" rel="noreferrer">첫 상세 이미지 열기</a>
          </div>
        </article>
      ))}
    </section>

    <section class="compare-section">
      <div class="section-heading">
        <p class="eyebrow">Representative images</p>
        <h2>대표 이미지 비교</h2>
      </div>
      <div class="version-columns">
        {versions.map((version) => (
          <article class="image-column" data-version-column={version.id}>
            <h3>{version.label}</h3>
            <div class="image-stack representative-stack">
              {version.representativeImages.map((src, index) => (
                <a href={src} target="_blank" rel="noreferrer">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <img src={src} alt={`${version.label} 대표 이미지 ${index + 1}`} loading="lazy" />
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="compare-section">
      <div class="section-heading">
        <p class="eyebrow">Detail flow</p>
        <h2>상세 이미지 흐름 비교</h2>
      </div>
      <div class="flow-table" style={`--rows: ${maxDetailCount};`}>
        {versions.map((version) => (
          <article class="flow-column" data-version-column={version.id}>
            <h3>{version.label}</h3>
            {version.detailImages.map((src, index) => (
              <a class="flow-card" href={src} target="_blank" rel="noreferrer">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <img src={src} alt={`${version.label} 상세 이미지 ${index + 1}`} loading="lazy" />
              </a>
            ))}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const maxSelection = 3;
  const choices = Array.from(document.querySelectorAll('.version-choice'));
  const inputs = Array.from(document.querySelectorAll('.version-choice input'));
  const presetButtons = Array.from(document.querySelectorAll('[data-preset]'));
  const note = document.getElementById('selection-note');
  const versionCards = Array.from(document.querySelectorAll('[data-version-card]'));
  const versionColumns = Array.from(document.querySelectorAll('[data-version-column]'));

  const selectedValues = () => inputs.filter((input) => input.checked).map((input) => input.value);

  const syncSelection = () => {
    let selected = selectedValues();

    if (selected.length > maxSelection) {
      const lastChecked = document.activeElement;
      inputs.forEach((input) => {
        if (input !== lastChecked && selectedValues().length > maxSelection) {
          input.checked = false;
        }
      });
      selected = selectedValues();
    }

    if (selected.length === 0 && inputs[0]) {
      inputs[0].checked = true;
      selected = selectedValues();
    }

    choices.forEach((choice) => {
      const input = choice.querySelector('input');
      choice.classList.toggle('is-selected', Boolean(input?.checked));
    });

    const selectedSet = new Set(selected);
    versionCards.forEach((card) => {
      card.classList.toggle('is-hidden', !selectedSet.has(card.dataset.versionCard || ''));
    });
    versionColumns.forEach((column) => {
      column.classList.toggle('is-hidden', !selectedSet.has(column.dataset.versionColumn || ''));
    });

    if (note) {
      note.textContent = `현재 ${selected.length}개 버전을 비교 중입니다.`;
    }
  };

  inputs.forEach((input) => {
    input.addEventListener('change', syncSelection);
  });

  presetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const preset = new Set((button.dataset.preset || '').split(',').filter(Boolean).slice(0, maxSelection));
      inputs.forEach((input) => {
        input.checked = preset.has(input.value);
      });
      syncSelection();
    });
  });

  syncSelection();
</script>

<style>
  :global(body) {
    background: #f5f7f2;
  }

  :global(body.noise::before) {
    opacity: 0.05;
  }

  .version-compare {
    --ink: #1d2924;
    --muted: #647169;
    --line: #dde5dc;
    --panel: #ffffff;
    --green: #254d3e;
    --soft: #edf5ee;
    --coral: #ba6048;
    min-height: 100vh;
    padding: 28px;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(37, 77, 62, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(37, 77, 62, 0.035) 1px, transparent 1px),
      #f5f7f2;
    background-size: 34px 34px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .compare-hero,
  .compare-controls,
  .summary-grid article,
  .compare-section {
    width: min(100%, 1480px);
    margin-inline: auto;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .breadcrumb a:hover {
    color: var(--green);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: stretch;
  }

  .hero-layout > div,
  .hero-layout aside,
  .summary-grid article,
  .compare-section {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(29, 41, 36, 0.055);
  }

  .hero-layout > div {
    display: grid;
    gap: 12px;
    padding: 30px;
  }

  .eyebrow {
    margin: 0;
    color: var(--coral);
    font-family: var(--font-latin);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    word-break: keep-all;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero-layout p {
    max-width: 820px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .hero-layout aside {
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 24px;
    border-left: 5px solid var(--green);
  }

  .hero-layout aside span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
  }

  .hero-layout aside strong {
    color: var(--green);
    font-family: var(--font-latin);
    font-size: 42px;
  }

  .compare-controls {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 14px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(29, 41, 36, 0.055);
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .control-copy {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .control-copy h2 {
    margin: 0;
    font-size: 21px;
    line-height: 1.2;
  }

  .control-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .preset-row,
  .version-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .preset-row {
    align-self: start;
  }

  .preset-row button {
    min-height: 38px;
    padding: 0 12px;
    color: var(--green);
    background: var(--soft);
    border: 1px solid #d4e2d6;
    border-radius: 7px;
    font: inherit;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
  }

  .version-picker {
    grid-column: 2;
  }

  .version-choice {
    display: grid;
    gap: 4px;
    min-width: 170px;
    padding: 12px 13px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }

  .version-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .version-choice.is-selected {
    color: #fff;
    background: var(--green);
    border-color: var(--green);
  }

  .version-choice span {
    font-size: 15px;
    font-weight: 900;
  }

  .version-choice strong {
    color: inherit;
    font-size: 12px;
    opacity: 0.78;
  }

  .selection-note {
    grid-column: 2;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .summary-grid {
    width: min(100%, 1480px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0 auto 16px;
  }

  .summary-grid article {
    min-width: 0;
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 14px;
    padding: 14px;
  }

  .summary-image {
    height: 160px;
    overflow: hidden;
    background: var(--soft);
    border-radius: 7px;
  }

  .summary-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .summary-grid article > div:last-child {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .summary-grid span {
    color: var(--coral);
    font-size: 11px;
    font-weight: 900;
  }

  .summary-grid h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
  }

  .summary-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .summary-grid a {
    justify-self: start;
    padding: 8px 10px;
    color: var(--green);
    background: var(--soft);
    border: 1px solid #d4e2d6;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
  }

  .compare-section {
    padding: 20px;
    margin-bottom: 16px;
  }

  .section-heading {
    display: grid;
    gap: 5px;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 24px;
  }

  .version-columns,
  .flow-table {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .summary-grid article.is-hidden,
  .version-columns [data-version-column].is-hidden,
  .flow-table [data-version-column].is-hidden {
    display: none;
  }

  .image-column,
  .flow-column {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .image-column h3,
  .flow-column h3 {
    position: sticky;
    top: 0;
    z-index: 2;
    margin: 0;
    padding: 11px 12px;
    color: #fff;
    background: var(--green);
    border-radius: 7px;
    font-size: 15px;
  }

  .image-stack,
  .flow-column {
    display: grid;
    gap: 10px;
  }

  .image-stack a,
  .flow-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: #eff5f0;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .image-stack span,
  .flow-card span {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 1;
    padding: 4px 7px;
    color: #fff;
    background: rgba(37, 77, 62, 0.9);
    border-radius: 999px;
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
  }

  .image-stack img {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  .flow-card img {
    width: 100%;
    display: block;
  }

  @media (max-width: 1180px) {
    .hero-layout,
    .compare-controls,
    .summary-grid,
    .version-columns,
    .flow-table {
      grid-template-columns: 1fr;
    }

    .version-picker,
    .selection-note {
      grid-column: auto;
    }
  }

  @media (max-width: 720px) {
    .version-compare {
      padding: 18px 12px;
    }

    .hero-layout > div {
      padding: 22px;
    }

    h1 {
      font-size: 32px;
    }

    .compare-controls,
    .summary-grid article {
      grid-template-columns: 1fr;
    }

    .summary-image {
      height: 220px;
    }
  }
</style>
