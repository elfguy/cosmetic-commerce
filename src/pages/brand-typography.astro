---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackToHub from '../components/BackToHub.astro';

const typeDirections = [
  {
    id: '01',
    name: 'Editorial Serif',
    note: '가장 럭셔리하고 백화점 스킨케어에 가까운 기준안',
    className: 'editorial-serif',
    lockup: 'stacked',
  },
  {
    id: '02',
    name: 'Quiet Sans',
    note: 'Aesop 계열의 차분한 클린 뷰티 무드',
    className: 'quiet-sans',
    lockup: 'stacked',
  },
  {
    id: '03',
    name: 'Compact Maison',
    note: '패키지 전면에 강한 짧은 고급 브랜드명 느낌',
    className: 'compact-maison',
    lockup: 'compact',
  },
  {
    id: '04',
    name: 'Fine Editorial',
    note: '상세페이지 헤더와 매거진형 콘텐츠에 어울리는 얇은 타입',
    className: 'fine-editorial',
    lockup: 'horizontal',
  },
  {
    id: '05',
    name: 'Soft Heritage',
    note: '한국적 프리미엄을 살짝 넣은 부드러운 세리프',
    className: 'soft-heritage',
    lockup: 'stacked',
  },
  {
    id: '06',
    name: 'Clinical Luxe',
    note: '기능성/피부 장벽 제품군에 맞는 정밀한 산세리프',
    className: 'clinical-luxe',
    lockup: 'horizontal',
  },
  {
    id: '07',
    name: 'Masthead',
    note: '브랜드를 크게 각인시키는 에디토리얼 마스트헤드',
    className: 'masthead',
    lockup: 'hero',
  },
  {
    id: '08',
    name: 'Plus Accent',
    note: 'PLUS를 작은 금색 포인트로 처리한 판매용 헤더 후보',
    className: 'plus-accent',
    lockup: 'accent',
  },
];
---

<BaseLayout title="YOURSKIN PLUS 타이포 로고 고도화" description="YOURSKIN PLUS 프리미엄 스킨케어 타이포그래피 로고 시안">
  <BackToHub label="타이포 로고 고도화" kind="브랜드" />
  <main class="type-page">
    <section class="type-hero">
      <nav class="type-nav" aria-label="페이지 이동">
        <a href="/brand-logo/">Brand Logo</a>
        <a href="/shop-concept/">Storefront</a>
        <a href="/product-comparison/">Product Analysis</a>
      </nav>
      <div>
        <p>Typography refinement</p>
        <h1>YOURSKIN PLUS</h1>
        <span>Wordmark-first luxury skincare direction</span>
      </div>
    </section>

    <section class="recommendation">
      <article>
        <span>추천 1순위</span>
        <strong>01 Editorial Serif</strong>
        <p>가장 안정적인 럭셔리 스킨케어 톤. 제품 패키지, 자사몰 헤더, 상세페이지 모두 대응하기 좋습니다.</p>
      </article>
      <article>
        <span>추천 2순위</span>
        <strong>08 Plus Accent</strong>
        <p>심볼 없이도 PLUS를 브랜드 포인트로 만들 수 있어 실제 판매 화면에서 기억성이 좋습니다.</p>
      </article>
      <article>
        <span>서브 방향</span>
        <strong>06 Clinical Luxe</strong>
        <p>피부 장벽, 저자극, 기능성 라인에는 차분한 산세리프 방향이 더 신뢰감 있게 보입니다.</p>
      </article>
    </section>

    <section class="type-grid" aria-label="YOURSKIN PLUS 타이포 로고 시안">
      {typeDirections.map((item) => (
        <article class:list={['type-card', item.className]}>
          <div class="card-meta">
            <span>{item.id}</span>
            <strong>{item.name}</strong>
          </div>
          <div class:list={['wordmark', item.lockup]}>
            {item.lockup === 'horizontal' && (
              <p><span>YOURSKIN</span><span>PLUS</span></p>
            )}
            {item.lockup === 'stacked' && (
              <p><span>YOURSKIN</span><span>PLUS</span></p>
            )}
            {item.lockup === 'compact' && (
              <p><span>YOUR</span><span>SKIN</span><span>PLUS</span></p>
            )}
            {item.lockup === 'hero' && (
              <p><span>YOURSKIN</span><span>PLUS</span></p>
            )}
            {item.lockup === 'accent' && (
              <p><span>YOURSKIN</span><span>PLUS</span><i aria-hidden="true">+</i></p>
            )}
          </div>
          <p class="note">{item.note}</p>
        </article>
      ))}
    </section>

    <section class="usage-band">
      <div>
        <span>Primary lockup</span>
        <strong>YOURSKIN<br />PLUS</strong>
      </div>
      <div>
        <span>Horizontal lockup</span>
        <strong>YOURSKIN PLUS</strong>
      </div>
      <div>
        <span>Small mark</span>
        <strong>YS+</strong>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&family=Libre+Baskerville:wght@400;700&family=Marcellus&family=Playfair+Display:wght@500;600&family=Tenor+Sans&display=swap');

  :global(body) {
    margin: 0;
    background: #f8f1e7;
    color: #162019;
  }

  .type-page {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(20, 61, 46, 0.06), rgba(248, 241, 231, 0) 26rem),
      #f8f1e7;
    font-family: Inter, system-ui, sans-serif;
  }

  .type-hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 54px;
  }

  .type-nav {
    display: flex;
    gap: 18px;
    margin-bottom: 78px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .type-nav a {
    color: #31493c;
    text-decoration: none;
    border-bottom: 1px solid rgba(20, 61, 46, 0.22);
    padding-bottom: 4px;
  }

  .type-hero p,
  .recommendation span,
  .card-meta span,
  .usage-band span {
    margin: 0;
    color: #8b7957;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .type-hero h1 {
    margin: 12px 0 8px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(54px, 9vw, 126px);
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 0.92;
    color: #143d2e;
  }

  .type-hero span {
    display: block;
    color: #55665a;
    font-size: 17px;
  }

  .recommendation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 1180px;
    margin: 0 auto;
    border-top: 1px solid rgba(20, 61, 46, 0.18);
    border-bottom: 1px solid rgba(20, 61, 46, 0.18);
  }

  .recommendation article {
    padding: 26px 24px;
    border-right: 1px solid rgba(20, 61, 46, 0.14);
  }

  .recommendation article:last-child {
    border-right: 0;
  }

  .recommendation strong {
    display: block;
    margin-top: 10px;
    color: #143d2e;
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 20px;
  }

  .recommendation p,
  .note {
    margin: 10px 0 0;
    color: #5f675f;
    font-size: 14px;
    line-height: 1.65;
  }

  .type-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    max-width: 1180px;
    margin: 54px auto 0;
    background: rgba(20, 61, 46, 0.14);
    border: 1px solid rgba(20, 61, 46, 0.14);
  }

  .type-card {
    min-height: 330px;
    background: #fbf7ef;
    padding: 26px;
    display: flex;
    flex-direction: column;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .card-meta strong {
    color: #2c362f;
    font-size: 13px;
    font-weight: 600;
  }

  .wordmark {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 210px;
    color: #143d2e;
  }

  .wordmark p {
    margin: 0;
  }

  .wordmark span {
    display: block;
  }

  .editorial-serif .wordmark p {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(42px, 5.6vw, 82px);
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 0.92;
    text-align: center;
  }

  .editorial-serif .wordmark span:last-child {
    margin-top: 18px;
    font-size: 0.43em;
    letter-spacing: 0.34em;
  }

  .quiet-sans .wordmark p {
    font-family: 'Tenor Sans', Inter, sans-serif;
    font-size: clamp(34px, 4.8vw, 66px);
    letter-spacing: 0.17em;
    line-height: 1.04;
    text-align: center;
  }

  .quiet-sans .wordmark span:last-child {
    margin-top: 20px;
    font-size: 0.46em;
    letter-spacing: 0.42em;
  }

  .compact-maison .wordmark p {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: clamp(36px, 5vw, 70px);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 0.88;
    text-align: center;
  }

  .compact-maison .wordmark span:nth-child(3) {
    margin-top: 16px;
    font-size: 0.36em;
    font-weight: 400;
    letter-spacing: 0.44em;
    color: #9b8554;
  }

  .fine-editorial .wordmark p {
    display: flex;
    align-items: baseline;
    gap: 22px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 5vw, 78px);
    font-weight: 500;
    letter-spacing: 0.11em;
  }

  .fine-editorial .wordmark span:last-child {
    font-size: 0.42em;
    letter-spacing: 0.32em;
    color: #9b8554;
  }

  .soft-heritage .wordmark p {
    font-family: Marcellus, Georgia, serif;
    font-size: clamp(38px, 5.1vw, 76px);
    letter-spacing: 0.105em;
    line-height: 0.96;
    text-align: center;
  }

  .soft-heritage .wordmark span:last-child {
    margin-top: 18px;
    font-family: 'Tenor Sans', Inter, sans-serif;
    font-size: 0.38em;
    letter-spacing: 0.46em;
  }

  .clinical-luxe .wordmark p {
    display: flex;
    align-items: center;
    gap: 18px;
    font-family: Inter, system-ui, sans-serif;
    font-size: clamp(30px, 4vw, 58px);
    font-weight: 500;
    letter-spacing: 0.19em;
  }

  .clinical-luxe .wordmark span:last-child {
    padding-left: 18px;
    border-left: 1px solid rgba(155, 133, 84, 0.72);
    font-size: 0.48em;
    letter-spacing: 0.34em;
    color: #9b8554;
  }

  .masthead .wordmark p {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(54px, 7.8vw, 112px);
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 0.88;
    text-align: center;
  }

  .masthead .wordmark span:last-child {
    margin-top: 12px;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.18em;
    font-weight: 600;
    letter-spacing: 0.72em;
    color: #9b8554;
  }

  .plus-accent .wordmark p {
    position: relative;
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: clamp(42px, 5.5vw, 82px);
    letter-spacing: 0.065em;
    line-height: 0.94;
    text-align: center;
  }

  .plus-accent .wordmark span:nth-child(2) {
    margin-top: 18px;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.28em;
    font-weight: 600;
    letter-spacing: 0.5em;
    color: #9b8554;
  }

  .plus-accent .wordmark i {
    position: absolute;
    top: -20px;
    right: -42px;
    color: #9b8554;
    font-family: Inter, system-ui, sans-serif;
    font-size: 28px;
    font-style: normal;
    font-weight: 300;
  }

  .usage-band {
    display: grid;
    grid-template-columns: 1.1fr 1.6fr 0.7fr;
    max-width: 1180px;
    margin: 54px auto 0;
    padding: 0 0 70px;
  }

  .usage-band div {
    min-height: 180px;
    border-top: 1px solid rgba(20, 61, 46, 0.18);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .usage-band strong {
    color: #143d2e;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(34px, 5vw, 68px);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 0.96;
  }

  .usage-band div:nth-child(2) strong {
    font-size: clamp(28px, 4.5vw, 56px);
  }

  .usage-band div:nth-child(3) strong {
    color: #9b8554;
  }

  @media (max-width: 820px) {
    .type-nav,
    .recommendation,
    .type-grid,
    .usage-band {
      grid-template-columns: 1fr;
    }

    .type-nav {
      display: grid;
      margin-bottom: 56px;
    }

    .recommendation article,
    .usage-band div {
      border-right: 0;
      border-bottom: 1px solid rgba(20, 61, 46, 0.14);
    }

    .type-grid {
      margin-top: 34px;
    }

    .type-card {
      min-height: 300px;
      padding: 22px;
    }

    .fine-editorial .wordmark p,
    .clinical-luxe .wordmark p {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }

    .clinical-luxe .wordmark span:last-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 480px) {
    .type-page {
      overflow-x: hidden;
    }

    /* 절대배치 + 포인트가 카드 밖으로 삐져나가 가로 오버플로를 만드는 것 방지 */
    .plus-accent .wordmark p {
      display: inline-block;
      max-width: 100%;
    }

    .plus-accent .wordmark i {
      right: -28px;
      top: -16px;
    }

    /* 마스트헤드 큰 자간이 좁은 화면에서 한 줄을 밀어내지 않도록 안전 처리 */
    .masthead .wordmark span:last-child {
      letter-spacing: 0.4em;
    }

    .wordmark p {
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .wordmark img {
      max-width: 100%;
      height: auto;
    }

    .type-hero h1 {
      overflow-wrap: anywhere;
    }
  }
</style>
