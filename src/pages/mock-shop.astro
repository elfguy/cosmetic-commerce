---
import BaseLayout from '../layouts/BaseLayout.astro';
import naverData from '../../data/naver/products.json';

const products = naverData.smartstoreProducts;
const priceCompareProducts = naverData.priceCompareProducts;
const activeProduct = products[0];
---

<BaseLayout title="유어스킨플러스 네이버 쇼핑 목업" description="네이버 스마트스토어 수집 데이터 기반 상세페이지 고도화 목업">
  <main class="naver-shop-mock">
    <aside class="source-panel">
      <a class="brand" href="/">
        <span>YOURS</span>
        <strong>KIN+</strong>
      </a>
      <div class="source-card">
        <p>Source</p>
        <h2>네이버 검색/스마트스토어 수집 기준</h2>
        <span>Cafe24 리셀러 페이지 데이터는 이 목업에서 제외</span>
      </div>
      <a class="store-link" href={naverData.store.url} target="_blank" rel="noreferrer">
        스마트스토어 열기
      </a>
      <nav class="product-tabs" aria-label="네이버 노출 상품 선택">
        {products.map((product, index) => (
          <button class:list={['product-tab', index === 0 && 'is-active']} type="button" data-product={product.slug}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{product.shortName}</strong>
            <em>{product.price.toLocaleString('ko-KR')}원 · ★ {product.rating}</em>
          </button>
        ))}
      </nav>
    </aside>

    <section class="workspace">
      <header class="topline">
        <div>
          <p>Mock storefront</p>
          <h1>네이버 노출 상품 기준 상세페이지 고도화 시안</h1>
        </div>
        <a href={naverData.store.searchUrl} target="_blank" rel="noreferrer">네이버 검색 결과</a>
      </header>

      <section class="hero-card">
        <div class="product-visual">
          <div class="verified">Naver Smartstore indexed</div>
          <img id="product-image" src={activeProduct.image} alt={activeProduct.name} />
        </div>
        <div class="hero-copy">
          <p id="product-source">{activeProduct.source}</p>
          <h2 id="product-name">{activeProduct.shortName}</h2>
          <p id="product-full-name" class="search-title">검색 노출명: {activeProduct.name}</p>
          <p id="product-positioning" class="positioning">{activeProduct.positioning}</p>
          <div class="metric-grid">
            <div>
              <span>판매가</span>
              <strong id="product-price">{activeProduct.price.toLocaleString('ko-KR')}원</strong>
            </div>
            <div>
              <span>할인</span>
              <strong id="discount-rate">{activeProduct.discountRate}</strong>
            </div>
            <div>
              <span>리뷰/평점</span>
              <strong id="review-rating">{activeProduct.rating} · {activeProduct.reviewCount}</strong>
            </div>
            <div>
              <span>배송</span>
              <strong id="shipping">{activeProduct.shipping}</strong>
            </div>
          </div>
          <div class="keyword-row" id="keyword-row">
            {activeProduct.keywords.map((keyword) => <span>{keyword}</span>)}
          </div>
          <div class="cta-row">
            <a id="product-link" class="primary-cta" href={activeProduct.url} target="_blank" rel="noreferrer">스마트스토어 상품 보기</a>
            <button type="button" class="secondary-cta">상세 구성 검토</button>
          </div>
        </div>
      </section>

      <section class="detail-strategy" aria-label="상세페이지 구성">
        <div class="section-title">
          <p>Detail page blueprint</p>
          <h2>검색 노출 문구를 전환 구조로 재배치</h2>
        </div>
        <div class="blueprint-grid">
          <article>
            <span>01</span>
            <h3>첫 화면</h3>
            <p id="first-direction">{activeProduct.detailDirection[0]}</p>
          </article>
          <article>
            <span>02</span>
            <h3>문제 제기</h3>
            <p id="second-direction">{activeProduct.detailDirection[1]}</p>
          </article>
          <article>
            <span>03</span>
            <h3>구매 설득</h3>
            <p id="third-direction">{activeProduct.detailDirection[2]}</p>
          </article>
        </div>
      </section>

      <section class="commerce-board">
        <div class="funnel-card">
          <p>Recommended detail flow</p>
          <ol>
            <li><strong>검색 키워드형 상품명</strong><span>네이버에 실제 노출된 긴 상품명을 첫 줄에 흡수</span></li>
            <li><strong>가격/리뷰 신뢰</strong><span>할인율, 무료배송, 평점/리뷰를 구매 버튼 옆에 고정</span></li>
            <li><strong>고민별 섹션</strong><span>보습, 모공, 블랙헤드, 약산성처럼 검색 의도를 섹션 제목으로 사용</span></li>
            <li><strong>상세 이미지 교체 예정</strong><span>현재는 네이버 썸네일만 수집됨. 원본 상세 이미지는 스마트스토어센터/HAR 필요</span></li>
          </ol>
        </div>

        <div class="compare-card">
          <div class="section-title compact">
            <p>Naver price compare</p>
            <h2>가격비교 노출 상품</h2>
          </div>
          <div class="compare-list">
            {priceCompareProducts.map((item) => (
              <div>
                <strong>{item.name}</strong>
                <span>{item.price.toLocaleString('ko-KR')}원 · {item.seller}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="status-note">
        <h2>수집 상태</h2>
        <p>
          현재 목업은 네이버 통합검색에서 확인한 스마트스토어 상품명, 가격, 할인율, 평점, 리뷰 수, 상품 URL, 썸네일을 사용합니다.
          스마트스토어 상세 본문/상세 이미지는 네이버 직접 접근이 불안정해 아직 미수집 상태입니다.
        </p>
      </section>
    </section>
  </main>

  <script type="application/json" id="naver-products" set:html={JSON.stringify(products)} />
  <script is:inline>
    const products = JSON.parse(document.getElementById('naver-products').textContent);
    const bySlug = new Map(products.map((product) => [product.slug, product]));
    const nodes = {
      image: document.getElementById('product-image'),
      source: document.getElementById('product-source'),
      name: document.getElementById('product-name'),
      fullName: document.getElementById('product-full-name'),
      positioning: document.getElementById('product-positioning'),
      price: document.getElementById('product-price'),
      discount: document.getElementById('discount-rate'),
      review: document.getElementById('review-rating'),
      shipping: document.getElementById('shipping'),
      keywords: document.getElementById('keyword-row'),
      link: document.getElementById('product-link'),
      first: document.getElementById('first-direction'),
      second: document.getElementById('second-direction'),
      third: document.getElementById('third-direction'),
    };

    function render(product) {
      nodes.image.src = product.image;
      nodes.image.alt = product.name;
      nodes.source.textContent = product.source;
      nodes.name.textContent = product.shortName;
      nodes.fullName.textContent = `검색 노출명: ${product.name}`;
      nodes.positioning.textContent = product.positioning;
      nodes.price.textContent = `${Number(product.price).toLocaleString('ko-KR')}원`;
      nodes.discount.textContent = product.discountRate;
      nodes.review.textContent = `${product.rating} · ${product.reviewCount}`;
      nodes.shipping.textContent = product.shipping;
      nodes.keywords.innerHTML = product.keywords.map((keyword) => `<span>${keyword}</span>`).join('');
      nodes.link.href = product.url;
      nodes.first.textContent = product.detailDirection[0];
      nodes.second.textContent = product.detailDirection[1];
      nodes.third.textContent = product.detailDirection[2];
      document.querySelectorAll('.product-tab').forEach((button) => {
        button.classList.toggle('is-active', button.dataset.product === product.slug);
      });
    }

    document.querySelectorAll('.product-tab').forEach((button) => {
      button.addEventListener('click', () => {
        const product = bySlug.get(button.dataset.product);
        if (product) render(product);
      });
    });
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #f6f8f2;
  }

  .naver-shop-mock {
    --ink: #182019;
    --muted: rgba(24, 32, 25, 0.62);
    --line: rgba(24, 32, 25, 0.14);
    --green: #00c73c;
    --deep: #0b3d20;
    --paper: #fbfff8;
    display: grid;
    min-height: 100vh;
    grid-template-columns: 330px minmax(0, 1fr);
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(0, 199, 60, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(0, 199, 60, 0.055) 1px, transparent 1px),
      #f6f8f2;
    background-size: 42px 42px;
  }

  .source-panel {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--line);
    background: rgba(251, 255, 248, 0.92);
    padding: 24px;
  }

  .brand {
    display: inline-grid;
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 44px;
    font-weight: 900;
    line-height: 0.9;
    text-decoration: none;
  }

  .brand strong {
    color: var(--green);
  }

  .source-card,
  .hero-card,
  .blueprint-grid article,
  .funnel-card,
  .compare-card,
  .status-note {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.72);
  }

  .source-card {
    margin-top: 28px;
    padding: 18px;
  }

  .source-card p,
  .topline p,
  .section-title p,
  .hero-copy > p,
  .funnel-card > p {
    margin: 0;
    color: var(--green);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .source-card h2 {
    margin: 8px 0 10px;
    font-size: 22px;
    line-height: 1.18;
  }

  .source-card span {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .store-link {
    display: block;
    margin-top: 12px;
    border-radius: 10px;
    background: var(--green);
    padding: 14px 16px;
    color: #fff;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
  }

  .product-tabs {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .product-tab {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 6px 12px;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 14px;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }

  .product-tab span {
    grid-row: span 2;
    color: var(--green);
    font-weight: 950;
  }

  .product-tab strong {
    overflow-wrap: anywhere;
    font-size: 15px;
    line-height: 1.35;
  }

  .product-tab em {
    color: var(--muted);
    font-size: 12px;
    font-style: normal;
  }

  .product-tab.is-active {
    border-color: var(--deep);
    background: var(--deep);
    color: #fff;
  }

  .product-tab.is-active span,
  .product-tab.is-active em {
    color: rgba(255, 255, 255, 0.76);
  }

  .workspace {
    min-width: 0;
    padding: 24px;
  }

  .topline {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
  }

  .topline h1,
  .section-title h2,
  .status-note h2 {
    margin: 6px 0 0;
    font-size: clamp(30px, 4vw, 58px);
    font-weight: 950;
    line-height: 1.05;
    letter-spacing: 0;
    word-break: keep-all;
  }

  .topline a {
    flex: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    padding: 11px 15px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 900;
    text-decoration: none;
  }

  .hero-card {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(400px, 1fr);
    gap: 24px;
    margin-top: 22px;
    padding: 22px;
  }

  .product-visual {
    position: relative;
    display: grid;
    min-height: 580px;
    place-items: center;
    border-radius: 10px;
    background:
      radial-gradient(circle at 48% 42%, rgba(0, 199, 60, 0.16), transparent 260px),
      linear-gradient(135deg, #ffffff, #f2f9ee);
  }

  .verified {
    position: absolute;
    left: 16px;
    top: 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 950;
  }

  .product-visual img {
    width: min(78%, 430px);
    max-height: 430px;
    object-fit: contain;
    filter: drop-shadow(0 24px 30px rgba(24, 32, 25, 0.16));
  }

  .hero-copy {
    padding: clamp(18px, 3vw, 36px);
  }

  .hero-copy h2 {
    margin: 14px 0 0;
    font-size: clamp(34px, 4.3vw, 68px);
    font-weight: 950;
    line-height: 1.04;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .positioning {
    margin: 22px 0 0;
    font-size: clamp(18px, 2.2vw, 28px);
    font-weight: 900;
    line-height: 1.45;
  }

  .search-title {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.55;
    word-break: keep-all;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--line);
  }

  .metric-grid div {
    min-width: 0;
    background: var(--paper);
    padding: 16px;
  }

  .metric-grid span {
    display: block;
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
  }

  .metric-grid strong {
    display: block;
    margin-top: 6px;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .keyword-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .keyword-row span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 900;
  }

  .cta-row {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .primary-cta,
  .secondary-cta {
    border: 1px solid var(--deep);
    border-radius: 10px;
    padding: 16px 18px;
    font-weight: 950;
  }

  .primary-cta {
    flex: 1;
    background: var(--deep);
    color: #fff;
    text-align: center;
    text-decoration: none;
  }

  .secondary-cta {
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }

  .detail-strategy,
  .commerce-board,
  .status-note {
    margin-top: 28px;
  }

  .section-title {
    max-width: 760px;
  }

  .blueprint-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  .blueprint-grid article {
    padding: 22px;
  }

  .blueprint-grid span {
    color: var(--green);
    font-weight: 950;
  }

  .blueprint-grid h3 {
    margin: 8px 0 10px;
    font-size: 28px;
    line-height: 1.1;
  }

  .blueprint-grid p,
  .funnel-card li span,
  .status-note p {
    color: rgba(24, 32, 25, 0.72);
    line-height: 1.75;
  }

  .commerce-board {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(380px, 1.1fr);
    gap: 16px;
  }

  .funnel-card,
  .compare-card,
  .status-note {
    padding: 24px;
  }

  .funnel-card ol {
    display: grid;
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .funnel-card li {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }

  .funnel-card li strong,
  .funnel-card li span {
    display: block;
  }

  .funnel-card li strong {
    font-size: 18px;
  }

  .compact h2 {
    font-size: clamp(28px, 3vw, 42px);
  }

  .compare-list {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }

  .compare-list div {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 13px;
  }

  .compare-list strong {
    display: block;
    line-height: 1.45;
    word-break: keep-all;
  }

  .compare-list span {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .status-note p {
    max-width: 980px;
    margin: 12px 0 0;
  }

  @media (max-width: 1120px) {
    .naver-shop-mock {
      grid-template-columns: 1fr;
    }

    .source-panel {
      position: relative;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .product-tabs {
      display: flex;
      overflow-x: auto;
      padding-bottom: 4px;
      scroll-snap-type: x mandatory;
    }

    .product-tab {
      min-width: 260px;
      scroll-snap-align: start;
    }

    .hero-card,
    .commerce-board {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .source-panel,
    .workspace {
      padding: 14px;
    }

    .brand {
      font-size: 38px;
    }

    .topline {
      display: grid;
      align-items: start;
    }

    .hero-card {
      padding: 14px;
    }

    .product-visual {
      min-height: 390px;
    }

    .product-visual img {
      max-height: 280px;
    }

    .metric-grid,
    .blueprint-grid {
      grid-template-columns: 1fr;
    }

    .cta-row {
      display: grid;
    }
  }
</style>
