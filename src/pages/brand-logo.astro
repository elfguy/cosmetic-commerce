---
import BaseLayout from '../layouts/BaseLayout.astro';

const brandPillars = [
  {
    title: 'Natural Ingredients',
    text: '신선한 허브, 식물 추출, 자연 유래 원료 이미지를 심볼의 잎맥으로 압축합니다.',
  },
  {
    title: 'Clean Extraction',
    text: '투명하고 깨끗한 추출 공정을 이슬방울과 넓은 여백으로 표현합니다.',
  },
  {
    title: 'Skin Barrier',
    text: '피부 장벽과 수분 밸런스를 보호감 있는 드롭 실루엣과 안정적인 비례로 암시합니다.',
  },
  {
    title: 'Seoul Premium',
    text: '과한 장식 없이 정확한 자간, 얇은 라인, 낮은 채도의 그린 팔레트로 고급감을 만듭니다.',
  },
];

const colors = [
  { name: 'Deep Forest', hex: '#143D2E' },
  { name: 'Sage Vein', hex: '#8AA38F' },
  { name: 'Warm Ivory', hex: '#F8F1E7' },
  { name: 'Soft Beige', hex: '#D9D1BE' },
  { name: 'Champagne', hex: '#C7A670' },
  { name: 'Charcoal', hex: '#171B18' },
];

const rules = [
  '워드마크는 넓은 자간과 얇은 두께를 유지한다.',
  '잎사귀를 장식으로 늘리지 않고 심볼 안에 한 번만 사용한다.',
  '골드는 얇은 라인, 작은 점, 플러스 포인트로만 제한한다.',
  '흑백 버전에서도 드롭, 잎, 작은 플러스가 식별되어야 한다.',
  '자사몰 헤더에는 워드마크, 상세 이미지에는 심볼 배지를 우선 사용한다.',
];

const simplifiedDirection = [
  {
    title: 'Drop Outline',
    text: '이슬방울 외곽선 하나로 수분감과 순한 사용감을 전달합니다.',
  },
  {
    title: 'Single Leaf',
    text: '잎은 한 장만 사용해 자연 성분 이미지를 남기되 장식성을 줄입니다.',
  },
  {
    title: 'Small Plus',
    text: '플러스는 기능성이나 의료 느낌이 강해지지 않도록 작은 골드 포인트로만 둡니다.',
  },
  {
    title: 'Wide Wordmark',
    text: '얇은 산세리프와 넓은 자간으로 프리미엄 패키지 인상을 만듭니다.',
  },
];

const logoConcepts = [
  {
    title: 'Botanical Dew Seal',
    file: '/brand/logo-concepts/01-botanical-dew-seal.png',
    note: '프리미엄감은 좋지만 심볼 요소가 많아 작은 크기에서 복잡합니다.',
    status: '보조 참고',
  },
  {
    title: 'Calm Leaf Drop',
    file: '/brand/logo-concepts/02-calm-leaf-drop.png',
    note: '현재 벡터 초안의 기준 시안입니다. 열린 드롭, 넓은 잎, 물결 잎맥, 작은 플러스를 반영합니다.',
    status: '기준 시안',
  },
  {
    title: 'Seoul Barrier Flow',
    file: '/brand/logo-concepts/03-seoul-barrier-flow.png',
    note: '피부 장벽 감성은 좋지만 심볼이 브랜드 마크로는 다소 설명적입니다.',
    status: '보조 후보',
  },
  {
    title: 'Minimal Circulation',
    file: '/brand/logo-concepts/04-minimal-circulation.png',
    note: '가장 절제된 방향이지만 유어스킨플러스만의 차별 신호가 약합니다.',
    status: '보조 후보',
  },
];
---

<BaseLayout title="YOURSKIN PLUS 브랜드 로고 방향" description="유어스킨플러스 프리미엄 자연주의 스킨케어 로고 콘셉트 보드">
  <main class="brand-page">
    <section class="brand-hero">
      <nav class="top-nav" aria-label="페이지 이동">
        <a href="/">Marketing Dashboard</a>
        <a href="/shop-concept/">Storefront Mockup</a>
        <a href="/product-comparison/">Product Analysis</a>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Brand identity direction</p>
          <h1><span>YOURSKIN PLUS</span> 자연 성분 기반 프리미엄 클린 뷰티 로고 방향</h1>
          <p>
            로고 시안 보드를 다시 포함하고, Calm Leaf Drop 시안의 열린 드롭 라인, 넓은 잎, 물결 잎맥, 작은 플러스에 맞춰 벡터 초안을 다시 조정했습니다.
          </p>
        </div>
        <div class="hero-logo" aria-label="추천 벡터 로고 초안">
          <img src="/brand/yourskin-plus-logo-primary.svg" alt="YOURSKIN PLUS 컬러 로고 벡터 초안" />
          <span>Recommended vector draft</span>
        </div>
      </div>
    </section>

    <section class="summary-band">
      <article>
        <span>추천 콘셉트</span>
        <strong>Calm Leaf Drop</strong>
        <p>드롭, 잎, 작은 플러스만 남긴 가장 단순한 프리미엄 방향입니다.</p>
      </article>
      <article>
        <span>브랜드 무드</span>
        <strong>Calm Seoul Luxury</strong>
        <p>한국 화장품의 깨끗함과 절제된 프리미엄 패키지 감성을 맞춥니다.</p>
      </article>
      <article>
        <span>문서 위치</span>
        <strong>docs/19</strong>
        <p>로고 방향, 팔레트, 사용 가이드는 문서로 함께 정리했습니다.</p>
      </article>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Brand pillars</p>
        <h2>로고가 전달해야 할 네 가지 인상</h2>
      </div>
      <div class="pillar-grid">
        {brandPillars.map((pillar) => (
          <article>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Logo concept boards</p>
          <h2>로고 시안 4종</h2>
        </div>
        <p class="section-note">현재 벡터는 02번 시안을 기준으로 정리했습니다.</p>
      </div>
      <div class="concept-grid">
        {logoConcepts.map((concept, index) => (
          <article class:list={['concept-card', index === 1 && 'selected']}>
            <img src={concept.file} alt={`YOURSKIN PLUS ${concept.title} 로고 시안`} />
            <div class="concept-copy">
              <span>{concept.status}</span>
              <h3>{concept.title}</h3>
              <p>{concept.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block logo-system">
      <div class="section-heading">
        <p class="eyebrow">Logo system</p>
        <h2>웹과 패키지에서 바로 검토할 벡터 초안</h2>
      </div>
      <div class="system-grid">
        <article class="system-card wide">
          <span>Primary</span>
          <img src="/brand/yourskin-plus-logo-primary.svg" alt="YOURSKIN PLUS 컬러 로고" />
        </article>
        <article class="system-card dark">
          <span>Monochrome</span>
          <img src="/brand/yourskin-plus-logo-mono.svg" alt="YOURSKIN PLUS 흑백 로고" />
        </article>
        <article class="system-card symbol-card">
          <span>Symbol</span>
          <img src="/brand/yourskin-plus-symbol.svg" alt="YOURSKIN PLUS 심볼" />
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Simplified direction</p>
        <h2>단순화 기준</h2>
      </div>
      <div class="concept-grid text-only">
        {simplifiedDirection.map((item) => (
          <article class="concept-card simple-card">
            <span>{item.title}</span>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="reference-note">
        로고 형태는 후보 시안으로 비교하되, 패키지 목업의 문자와 제품 이미지는 왜곡될 수 있어 실제 상품 이미지나 최종 원본으로 사용하지 않습니다.
      </p>
    </section>

    <section class="section-block guide-grid">
      <article class="palette-panel">
        <div class="section-heading compact">
          <p class="eyebrow">Palette</p>
          <h2>권장 컬러</h2>
        </div>
        <div class="color-list">
          {colors.map((color) => (
            <div>
              <span style={`background:${color.hex}`}></span>
              <strong>{color.name}</strong>
              <small>{color.hex}</small>
            </div>
          ))}
        </div>
      </article>

      <article class="rules-panel">
        <div class="section-heading compact">
          <p class="eyebrow">Usage rules</p>
          <h2>운영 원칙</h2>
        </div>
        <ol>
          {rules.map((rule) => (
            <li>{rule}</li>
          ))}
        </ol>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #f8f1e7;
  }

  :global(body.noise::before) {
    opacity: 0.04;
  }

  .brand-page {
    --ink: #171b18;
    --forest: #143d2e;
    --sage: #8aa38f;
    --ivory: #f8f1e7;
    --paper: #fffdf8;
    --beige: #d9d1be;
    --gold: #c7a670;
    --muted: #68746b;
    --line: rgba(20, 61, 46, 0.16);
    min-height: 100vh;
    padding: 28px;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(20, 61, 46, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(20, 61, 46, 0.04) 1px, transparent 1px),
      var(--ivory);
    background-size: 42px 42px;
    font-family: var(--font-body);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .brand-hero,
  .summary-band,
  .section-block {
    width: min(100%, 1440px);
    margin: 0 auto;
  }

  .brand-hero {
    padding: 10px 0 24px;
  }

  .top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 34px;
  }

  .top-nav a {
    padding: 9px 12px;
    color: var(--forest);
    background: rgba(255, 253, 248, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-latin);
    font-size: 12px;
    font-weight: 800;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.72fr);
    gap: 28px;
    align-items: stretch;
  }

  .hero-copy,
  .hero-logo,
  .summary-band article,
  .pillar-grid article,
  .system-card,
  .concept-card,
  .palette-panel,
  .rules-panel {
    background: rgba(255, 253, 248, 0.93);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 22px 60px rgba(20, 61, 46, 0.08);
  }

  .hero-copy {
    display: grid;
    align-content: end;
    min-height: 520px;
    padding: clamp(28px, 4.2vw, 62px);
    background: var(--paper);
  }

  .eyebrow {
    margin: 0;
    color: var(--gold);
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 860px;
    margin: 12px 0 18px;
    color: var(--forest);
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: 0;
    word-break: keep-all;
  }

  .hero-copy h1 span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-latin);
    font-size: 0.86em;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero-copy p {
    max-width: 760px;
    margin: 0;
    color: #4f5c54;
    font-size: 17px;
    line-height: 1.78;
    word-break: keep-all;
  }

  .hero-logo {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 20px;
    min-height: 520px;
    padding: 36px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(248, 241, 231, 0.9)),
      var(--paper);
  }

  .hero-logo img {
    width: min(100%, 520px);
    height: auto;
  }

  .hero-logo span {
    color: var(--muted);
    font-family: var(--font-latin);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .summary-band {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 36px;
  }

  .summary-band article {
    min-height: 150px;
    display: grid;
    align-content: space-between;
    gap: 12px;
    padding: 22px;
  }

  .summary-band span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .summary-band strong {
    color: var(--forest);
    font-family: var(--font-latin);
    font-size: 26px;
    line-height: 1.08;
  }

  .summary-band p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
    word-break: keep-all;
  }

  .section-block {
    margin-bottom: 42px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    margin-bottom: 16px;
  }

  .section-heading h2 {
    margin: 5px 0 0;
    color: var(--forest);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.14;
    letter-spacing: 0;
    word-break: keep-all;
  }

  .section-note {
    max-width: 380px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    text-align: right;
    word-break: keep-all;
  }

  .section-heading.compact {
    display: block;
    margin-bottom: 20px;
  }

  .pillar-grid,
  .concept-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .pillar-grid article {
    min-height: 220px;
    display: grid;
    align-content: space-between;
    gap: 18px;
    padding: 24px;
  }

  .pillar-grid h3 {
    margin: 0;
    color: var(--forest);
    font-family: var(--font-latin);
    font-size: 22px;
    line-height: 1.12;
  }

  .pillar-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    word-break: keep-all;
  }

  .system-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) 260px;
    gap: 14px;
  }

  .system-card {
    min-height: 270px;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    padding: 24px;
  }

  .system-card span {
    color: var(--muted);
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .system-card img {
    width: 100%;
    max-width: 620px;
    height: auto;
  }

  .system-card.dark {
    background: #101511;
  }

  .system-card.dark span {
    color: #d9d1be;
  }

  .system-card.dark img {
    filter: invert(1);
  }

  .symbol-card img {
    max-width: 160px;
  }

  .concept-card {
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }

  .concept-card.selected {
    border-color: rgba(199, 166, 112, 0.72);
    box-shadow: 0 24px 70px rgba(20, 61, 46, 0.13);
  }

  .concept-card.selected::before {
    content: 'Selected direction';
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 7px 9px;
    color: #fffdf8;
    background: rgba(20, 61, 46, 0.92);
    border: 1px solid rgba(255, 253, 248, 0.28);
    border-radius: 999px;
    font-family: var(--font-latin);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .concept-card img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #ede5d8;
  }

  .text-only {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .simple-card {
    min-height: 180px;
    display: grid;
    align-content: space-between;
    gap: 20px;
    padding: 22px;
  }

  .simple-card span {
    color: var(--forest);
    font-family: var(--font-latin);
    font-size: 21px;
    font-weight: 800;
    line-height: 1.15;
  }

  .simple-card p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.68;
    word-break: keep-all;
  }

  .reference-note {
    max-width: 940px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    word-break: keep-all;
  }

  .concept-copy {
    display: grid;
    gap: 9px;
    padding: 18px;
  }

  .concept-copy span {
    color: var(--gold);
    font-size: 12px;
    font-weight: 900;
  }

  .concept-copy h3 {
    margin: 0;
    color: var(--forest);
    font-family: var(--font-latin);
    font-size: 20px;
    line-height: 1.15;
  }

  .concept-copy p,
  .concept-copy small {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.58;
    word-break: keep-all;
  }

  .concept-copy small {
    color: #385646;
    font-weight: 800;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 14px;
  }

  .palette-panel,
  .rules-panel {
    padding: 24px;
  }

  .color-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .color-list div {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .color-list span {
    width: 100%;
    height: 58px;
    border: 1px solid rgba(20, 61, 46, 0.14);
    border-radius: 8px;
  }

  .color-list strong {
    color: var(--forest);
    font-size: 13px;
    line-height: 1.2;
  }

  .color-list small {
    color: var(--muted);
    font-family: var(--font-latin);
    font-size: 12px;
  }

  .rules-panel ol {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: rules;
  }

  .rules-panel li {
    counter-increment: rules;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    color: #35433a;
    font-size: 14px;
    line-height: 1.65;
    word-break: keep-all;
  }

  .rules-panel li::before {
    content: counter(rules, decimal-leading-zero);
    color: var(--gold);
    font-family: var(--font-latin);
    font-size: 12px;
    font-weight: 900;
  }

  @media (max-width: 1180px) {
    .hero-grid,
    .system-grid,
    .guide-grid {
      grid-template-columns: 1fr;
    }

    .pillar-grid,
    .concept-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-copy,
    .hero-logo {
      min-height: 420px;
    }
  }

  @media (max-width: 760px) {
    .brand-page {
      padding: 16px;
    }

    .hero-copy,
    .hero-logo,
    .summary-band article,
    .pillar-grid article,
    .palette-panel,
    .rules-panel {
      padding: 18px;
    }

    .summary-band,
    .pillar-grid,
    .concept-grid,
    .color-list {
