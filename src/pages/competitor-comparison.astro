---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import competitorData from '../../data/coupang-competitor-products.json';
import { products } from '../data/marketingOps';

const productBySlug = new Map(products.map((product) => [product.slug, product]));
const categories = competitorData.categories.map((category) => {
  const ours = category.yoursProducts.map((slug) => productBySlug.get(slug)).filter(Boolean);
  const top = category.competitors.reduce((best, item) => item.reviewCount > best.reviewCount ? item : best, category.competitors[0]);
  const reviewGap = top.reviewCount - ours.reduce((sum, product) => sum + product.rating.coupangReviews, 0);
  const monthlyTop = category.competitors.reduce((best, item) => (item.monthlyPurchaseMin || 0) > (best.monthlyPurchaseMin || 0) ? item : best, category.competitors[0]);
  return { ...category, ours, top, reviewGap, monthlyTop };
});

const highThreats = categories.flatMap((category) => category.competitors.filter((item) => item.threatLevel === 'high').map((item) => ({ ...item, categoryLabel: category.label })));
---

<BaseLayout title="유어스킨플러스 경쟁상품" description="유어스킨플러스 상품별 경쟁군, 리뷰 격차, 월 구매 신호, 대응 메시지를 정리">
  <SiteHeader active="/competitor-comparison/" />

  <main class="competitor-tool">
    <section class="hero container">
      <div>
        <p class="eyebrow">Competitor products</p>
        <h1>경쟁상품을 보고 우리 상세에서<br />무엇을 강조할지 정리</h1>
        <p class="lead">리뷰 수, 월 구매 신호, 대응 메시지만 간결하게 봅니다.</p>
      </div>
      <div class="hero-card">
        <span>고위험 경쟁 상품</span>
        <strong>{highThreats.length}개</strong>
        <small>리뷰·월구매 신호가 큰 상품군</small>
      </div>
    </section>

    <section class="category-grid container" aria-label="카테고리별 경쟁상품">
      {categories.map((category) => (
        <article class="category-card">
          <div class="head">
            <span>{category.label}</span>
            <em>{category.competitors.length}개 경쟁군</em>
          </div>
          <h2>{category.ours.map((product) => product.shortName).join(' + ')}</h2>
          <p>{category.marketRead}</p>
          <dl>
            <div><dt>최대 경쟁 리뷰</dt><dd>{category.top.reviewCount.toLocaleString('ko-KR')}개</dd></div>
            <div><dt>리뷰 격차</dt><dd>{Math.max(category.reviewGap, 0).toLocaleString('ko-KR')}개</dd></div>
            <div><dt>월 구매 신호</dt><dd>{category.monthlyTop.monthlyPurchaseSignal || '확인 필요'}</dd></div>
          </dl>
          <div class="response">
            <strong>대응 방향</strong>
            <p>{category.top.takeaway}</p>
          </div>
          <div class="links">
            {category.ours.map((product) => <a href={'/products/' + product.slug + '/'}>{product.shortName} 작업실</a>)}
            <a class="ext" href={category.top.url} target="_blank" rel="noreferrer">대표 경쟁 상품 ↗</a>
          </div>
        </article>
      ))}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .competitor-tool { color: var(--ink); }
  .competitor-tool a { color: inherit; text-decoration: none; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: end;
    padding-block: clamp(28px, 5vw, 56px) clamp(18px, 3vw, 28px);
  }
  .hero h1 { margin: 10px 0; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.06; letter-spacing: -0.02em; }
  .hero .lead { margin: 0; max-width: 60ch; color: var(--muted); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.65; }
  .hero-card {
    display: grid; align-content: end; gap: 6px;
    padding: 22px; border-radius: var(--r);
    background: var(--forest); color: #f4efe4; box-shadow: var(--shadow);
  }
  .hero-card span, .hero-card small { color: var(--forest-soft); font-size: 13px; }
  .hero-card strong { font-size: 40px; line-height: 1; }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding-bottom: clamp(28px, 5vw, 52px);
  }
  .category-card {
    display: grid; gap: 14px; padding: 22px;
    border-radius: var(--r); background: var(--surface);
    border: 1px solid var(--line); box-shadow: var(--shadow-sm);
  }
  .head { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .head span, .head em { color: var(--muted); font-size: 13px; font-weight: 700; font-style: normal; }
  .head em { padding: 4px 10px; border-radius: var(--r-pill); background: var(--surface-3); }
  .category-card h2 { margin: 0; font-size: clamp(20px, 2.4vw, 26px); letter-spacing: -0.01em; }
  .category-card > p { margin: 0; color: var(--muted); line-height: 1.6; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  dl div { padding: 12px; border-radius: var(--r-sm); background: var(--surface-3); }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 4px 0 0; font-weight: 800; }
  .response { padding: 14px; border-radius: var(--r-sm); background: var(--accent-soft); border: 1px solid #ecccbe; }
  .response strong { display: block; margin-bottom: 6px; color: var(--accent-ink); }
  .response p { margin: 0; line-height: 1.55; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    padding: 9px 13px; border-radius: var(--r-pill);
    background: var(--forest); color: #f7f3e9; font-size: 13px; font-weight: 700;
  }
  .links a.ext { background: var(--accent); }

  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; gap: 14px; }
    .category-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    dl { grid-template-columns: 1fr; }
    .links a { flex: 1 1 auto; text-align: center; }
  }
</style>
