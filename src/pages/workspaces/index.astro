---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { marketingWorkspaces } from '../../data/marketingWorkspaces';
import { products } from '../../data/marketingOps';

const workspaceProducts = new Map(products.map((product) => [product.slug, product]));
---

<BaseLayout title="유어스킨플러스 상세 버전" description="상세페이지 개선, 이미지 버전, 광고 소재 후보를 제품별로 관리하는 상세 버전 화면">
  <SiteHeader active="/workspaces/" />

  <main class="workspace-hub">
    <header class="hero container">
      <p class="eyebrow">Detail and asset lab</p>
      <h1>상세페이지 버전을 제품별로 정리</h1>
      <p class="lead">제품별로 현재 적용 상세, 후보 버전, 최종 업로드 자료를 한 흐름에서 봅니다.</p>
    </header>

    <section class="workspace-grid container">
      {marketingWorkspaces.map((workspace) => {
        const product = workspaceProducts.get(workspace.slug);
        return (
          <article class="workspace-card">
            <a class="preview" href={workspace.pageUrl}>
              <img src={workspace.thumbnail} alt={workspace.productName + ' 대표 이미지'} loading="lazy" />
            </a>
            <div class="content">
              <div class="head">
                <span>{workspace.category}</span>
                <em>{workspace.status}</em>
              </div>
              <h2>{workspace.title}</h2>
              <p>{workspace.objective}</p>
              <dl>
                <div><dt>버전</dt><dd>{workspace.versions.length}개</dd></div>
                <div><dt>가격</dt><dd>{product ? product.price.sale.toLocaleString('ko-KR') + '원' : '-'}</dd></div>
                <div><dt>리스크</dt><dd>{product?.ops.claimRisk ?? '-'}</dd></div>
              </dl>
              <div class="next">
                <strong>다음 작업</strong>
                <p>{workspace.nextAction}</p>
              </div>
              <div class="links">
                <a href={workspace.pageUrl}>버전 보기</a>
                {product ? <a class="ghost" href={'/products/' + product.slug + '/'}>상품상세</a> : null}
              </div>
            </div>
          </article>
        );
      })}

      <article class="workspace-card planned">
        <div class="content">
          <div class="head">
            <span>다음 확장</span>
            <em>planned</em>
          </div>
          <h2>히알루론산 토너 상세 첫 화면</h2>
          <p>최근 판매량이 가장 좋은 토너를 다음 상세페이지 개선 대상으로 올립니다.</p>
          <div class="next">
            <strong>필요 작업</strong>
            <p>500ml 대용량, 스킨팩, 닦토 메시지를 모바일 첫 3컷 기준으로 재구성.</p>
          </div>
          <div class="links">
            <a href="/products/hyaluronic-toner/">상품상세</a>
            <a class="ghost" href="/toner-detail-renewal/">기존 시안</a>
          </div>
        </div>
      </article>

      <article class="workspace-card planned">
        <div class="content">
          <div class="head">
            <span>다음 확장</span>
            <em>planned</em>
          </div>
          <h2>클렌징 듀오 상세/광고 소재</h2>
          <p>클렌징 오일과 클렌징 젤을 문제 인식형 검색 소재와 세트 구성으로 묶습니다.</p>
          <div class="next">
            <strong>필요 작업</strong>
            <p>블랙헤드 제거 단정 없이 세정 관리 메시지와 유화 장면 중심 컷 제작.</p>
          </div>
          <div class="links">
            <a href="/products/cleansing-oil/">오일 작업실</a>
            <a class="ghost" href="/products/cleansing-gel/">젤 작업실</a>
          </div>
        </div>
      </article>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .workspace-hub { color: var(--ink); padding-bottom: 8px; }
  .workspace-hub a { color: inherit; text-decoration: none; }

  .hero { padding-block: clamp(28px, 5vw, 52px) clamp(14px, 2vw, 22px); }
  .hero h1 { max-width: 20ch; margin: 10px 0 12px; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.06; letter-spacing: -0.02em; }
  .hero .lead { max-width: 64ch; margin: 0; color: var(--muted); font-size: clamp(15px, 1.4vw, 17px); line-height: 1.7; }

  .workspace-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-bottom: clamp(28px, 5vw, 52px); }
  .workspace-card {
    overflow: hidden; display: grid; grid-template-rows: 240px 1fr;
    border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); box-shadow: var(--shadow-sm);
  }
  .workspace-card.planned { grid-template-rows: 1fr; border-style: dashed; background: var(--surface-2); }
  .preview img { width: 100%; height: 100%; object-fit: cover; background: var(--surface-3); }
  .content { display: grid; gap: 13px; padding: 20px; align-content: start; }
  .head { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .head span, .head em { color: var(--muted); font-size: 13px; font-weight: 700; font-style: normal; }
  .head em { padding: 4px 10px; border-radius: var(--r-pill); background: var(--surface-3); color: var(--forest); }
  .workspace-card h2 { margin: 0; font-size: clamp(20px, 2.2vw, 25px); letter-spacing: -0.01em; }
  .content > p, .next p { margin: 0; color: var(--muted); line-height: 1.58; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  dl div { padding-top: 8px; border-top: 1px solid var(--line); }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 3px 0 0; font-weight: 800; }
  .next { padding: 13px; border-radius: var(--r-sm); background: var(--surface-2); }
  .next strong { display: block; margin-bottom: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a { padding: 9px 12px; border-radius: var(--r-pill); background: var(--forest); color: #f7f3e9; font-size: 13px; font-weight: 700; }
  .links a.ghost { background: var(--surface); color: var(--ink); border: 1px solid var(--line-strong); }

  @media (max-width: 1040px) { .workspace-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .workspace-grid { grid-template-columns: 1fr; }
    .workspace-card { grid-template-rows: 200px 1fr; }
    .links a { flex: 1 1 auto; text-align: center; }
  }
</style>
