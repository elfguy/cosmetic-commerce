---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marketingWorkspaces } from '../../data/marketingWorkspaces';
import { navGroups, products } from '../../data/marketingOps';

const workspaceProducts = new Map(products.map((product) => [product.slug, product]));
---

<BaseLayout title="유어스킨플러스 상세 버전" description="상세페이지 개선, 이미지 버전, 광고 소재 후보를 제품별로 관리하는 상세 버전 화면">
  <main class="workspace-hub">
    <aside class="side">
      <a class="brand" href="/">
        <img src="/yourskin-logo-header-v15.svg" alt="YOURSKIN+" />
        <span>Detail versions</span>
      </a>
      {navGroups.map((group) => (
        <section>
          <p>{group.label}</p>
          {group.links.map((link) => (
            <a href={link.href}><span>{link.label}</span><small>{link.note}</small></a>
          ))}
        </section>
      ))}
    </aside>

    <section class="main">
      <header class="hero">
        <p class="eyebrow">Detail and asset lab</p>
        <h1>상세페이지 버전을 제품별로 정리</h1>
        <p>
          제품별로 현재 적용 상세, 후보 버전, 최종 업로드 자료를 한 흐름에서 봅니다.
        </p>
      </header>

      <section class="workspace-grid">
        {marketingWorkspaces.map((workspace) => {
          const product = workspaceProducts.get(workspace.slug);
          return (
            <article class="workspace-card">
              <a class="preview" href={workspace.pageUrl}>
                <img src={workspace.thumbnail} alt={workspace.productName + ' 대표 이미지'} loading="lazy" />
              </a>
              <div class="content">
                <div class="head">
                  <span>{workspace.category}</span>
                  <em>{workspace.status}</em>
                </div>
                <h2>{workspace.title}</h2>
                <p>{workspace.objective}</p>
                <dl>
                  <div><dt>버전</dt><dd>{workspace.versions.length}개</dd></div>
                  <div><dt>가격</dt><dd>{product ? product.price.sale.toLocaleString('ko-KR') + '원' : '-'}</dd></div>
                  <div><dt>리스크</dt><dd>{product?.ops.claimRisk ?? '-'}</dd></div>
                </dl>
                <div class="next">
                  <strong>다음 작업</strong>
                  <p>{workspace.nextAction}</p>
                </div>
                <div class="links">
                  <a href={workspace.pageUrl}>버전 보기</a>
                  {product ? <a href={'/products/' + product.slug + '/'}>상품상세</a> : null}
                </div>
              </div>
            </article>
          );
        })}

        <article class="workspace-card planned">
          <div class="content">
            <div class="head">
              <span>다음 확장</span>
              <em>planned</em>
            </div>
            <h2>히알루론산 토너 상세 첫 화면</h2>
            <p>최근 판매량이 가장 좋은 토너를 다음 상세페이지 개선 대상으로 올립니다.</p>
            <div class="next">
              <strong>필요 작업</strong>
              <p>500ml 대용량, 스킨팩, 닦토 메시지를 모바일 첫 3컷 기준으로 재구성.</p>
            </div>
            <div class="links">
              <a href="/products/hyaluronic-toner/">상품상세</a>
              <a href="/toner-detail-renewal/">기존 시안</a>
            </div>
          </div>
        </article>

        <article class="workspace-card planned">
          <div class="content">
            <div class="head">
              <span>다음 확장</span>
              <em>planned</em>
            </div>
            <h2>클렌징 듀오 상세/광고 소재</h2>
            <p>클렌징 오일과 클렌징 젤을 문제 인식형 검색 소재와 세트 구성으로 묶습니다.</p>
            <div class="next">
              <strong>필요 작업</strong>
              <p>블랙헤드 제거 단정 없이 세정 관리 메시지와 유화 장면 중심 컷 제작.</p>
            </div>
            <div class="links">
              <a href="/products/cleansing-oil/">오일 작업실</a>
              <a href="/products/cleansing-gel/">젤 작업실</a>
            </div>
          </div>
        </article>
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #eef2ed; }
  .workspace-hub {
    --ink: #17211d;
    --muted: #6a766f;
    --line: #d9e1d7;
    --dark: #11241f;
    --accent: #c56a4e;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    color: var(--ink);
    background: #eef2ed;
  }
  a { color: inherit; text-decoration: none; }
  .side {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 26px 20px;
    background: var(--dark);
    color: #f8f2e8;
  }
  .brand { display: grid; gap: 12px; margin-bottom: 26px; }
  .brand img { width: 168px; padding: 10px 12px; border-radius: 6px; background: #f8f4ea; }
  .brand span, .side p, .eyebrow {
    margin: 0;
    font-family: var(--font-latin);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .side p, .brand span { color: #aab8af; }
  .side section { display: grid; gap: 8px; margin-bottom: 24px; }
  .side section a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 13px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px;
    background: rgba(255,255,255,.045);
  }
  .side small { color: #b4c3ba; }
  .main { padding: 34px; display: grid; gap: 22px; }
  .hero h1 { max-width: 940px; margin: 8px 0 12px; font-size: clamp(38px, 5vw, 68px); line-height: 1; letter-spacing: 0; }
  .hero p:not(.eyebrow) { max-width: 760px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .eyebrow { color: var(--accent); }
  .workspace-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .workspace-card {
    overflow: hidden;
    display: grid;
    grid-template-rows: 260px 1fr;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(251,252,248,.94);
    box-shadow: 0 16px 46px rgba(21,34,28,.08);
  }
  .workspace-card.planned { grid-template-rows: 1fr; border-style: dashed; background: #f8faf5; }
  .preview img { width: 100%; height: 100%; object-fit: cover; background: #eef1ec; }
  .content { display: grid; gap: 13px; padding: 20px; }
  .head { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
  .head span, .head em {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
    font-style: normal;
  }
  .head em {
    padding: 5px 8px;
    border-radius: 999px;
    background: #e7efe6;
    color: #315b4c;
  }
  h2 { margin: 0; font-size: 26px; letter-spacing: 0; }
  .content > p, .next p { margin: 0; color: var(--muted); line-height: 1.58; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  dl div { padding-top: 8px; border-top: 1px solid var(--line); }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 3px 0 0; font-weight: 800; }
  .next { padding: 13px; border-radius: 8px; background: #f3f6f1; }
  .next strong { display: block; margin-bottom: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    padding: 9px 11px;
    border-radius: 6px;
    background: #1b382f;
    color: #fffaf0;
    font-size: 13px;
    font-weight: 800;
  }
  @media (max-width: 1100px) {
    .workspace-hub { grid-template-columns: 1fr; }
    .side { position: static; height: auto; }
    .workspace-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .side {
      padding: 14px;
      display: grid;
      gap: 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 4px;
    }

    .brand img {
      width: 128px;
      padding: 7px 9px;
    }

    .side section {
      display: flex;
      gap: 8px;
      margin: 0;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .side section::-webkit-scrollbar {
      display: none;
    }

    .side section p,
    .side small {
      display: none;
    }

    .side section a {
      flex: 0 0 auto;
      min-height: 38px;
      padding: 9px 11px;
      border-radius: 999px;
    }

    .main {
      padding: 16px;
      gap: 16px;
    }

    .workspace-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      font-size: 30px;
      line-height: 1.08;
    }

    .hero p:not(.eyebrow) {
      font-size: 15px;
      line-height: 1.6;
    }

    .workspace-card {
      grid-template-rows: 170px 1fr;
    }

    .workspace-card.planned {
      grid-template-rows: 1fr;
    }

    .content {
      padding: 16px;
      gap: 11px;
    }

    h2 {
      font-size: 22px;
    }

    dl {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .links a {
      flex: 1 1 auto;
      text-align: center;
    }
  }
</style>
